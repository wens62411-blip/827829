{
  "name": "ab-club-wechat-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "AB Club 原生微信小程序并行开发骨架（LOCAL_ONLY）",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck:miniprogram": "tsc -p tsconfig.miniprogram.json",
    "typecheck:cloud": "tsc -p tsconfig.cloudfunctions.json",
    "typecheck:contracts": "tsc -p tests/contracts/tsconfig.json",
    "typecheck": "npm run typecheck:miniprogram && npm run typecheck:cloud && npm run typecheck:contracts",
    "build:test-runtime": "tsc -p tests/runtime/tsconfig.json",
    "build:cloud-runtime": "node scripts/build-cloud-runtime.mjs",
    "check:cloud-runtime": "node scripts/check-cloud-runtime.mjs",
    "test": "npm run check:cloud-runtime && npm run build:test-runtime && node --test --test-isolation=none",
    "validate": "node scripts/validate-foundation.mjs",
    "check:package": "node scripts/check-package.mjs",
    "build": "npm run typecheck && npm run validate && npm test && npm run check:package"
  },
  "dependencies": {
    "tdesign-miniprogram": "1.16.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "miniprogram-api-typings": "5.2.3",
    "typescript": "7.0.2"
  }
}
