{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true
  },
  "include": [
    "../../miniprogram/shared/contracts/**/*.ts",
    "../../miniprogram/shared/types/**/*.ts",
    "../../miniprogram/shared/constants/**/*.ts",
    "../../miniprogram/shared/design-tokens/**/*.ts",
    "./type-assertions.ts"
  ]
}
