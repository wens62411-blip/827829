{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contractVersion": "1.0.0",
  "declaredCollectionCount": 25,
  "countNote": "The explicit frozen collection list contains 25 names, and all 25 are retained.",
  "commonFields": {
    "_id": "stable non-empty string",
    "version": "positive optimistic integer",
    "createdAt": "RFC 3339 UTC instant",
    "updatedAt": "RFC 3339 UTC instant"
  },
  "collections": [
    { "name": "users", "primaryWriter": "identityApi", "required": ["_id", "openIdHash", "accountState", "roles", "version", "createdAt", "updatedAt"], "states": { "accountState": ["ACTIVE", "DISABLED"] }, "sensitivity": "PRIVATE" },
    { "name": "profiles_private", "primaryWriter": "identityApi", "required": ["_id", "userId", "displayName", "version", "createdAt", "updatedAt"], "privateFields": ["phone", "email", "biography"], "sensitivity": "PRIVATE" },
    { "name": "cards_public", "primaryWriter": "identityApi", "required": ["_id", "ownerUserId", "displayName", "visibility", "claimIds", "origin", "verificationState", "version", "createdAt", "updatedAt"], "forbiddenFields": ["phone", "email", "openid", "evidenceAssetIds", "reviewerNotes"], "sensitivity": "PUBLIC_PROJECTION" },
    { "name": "card_share_tokens", "primaryWriter": "identityApi", "required": ["_id", "ownerUserId", "targetType", "targetId", "tokenDigest", "expiresAt", "revoked", "version", "createdAt", "updatedAt"], "discriminator": { "field": "targetType", "enum": ["CARD", "EVENT"], "mapping": { "CARD": "targetId is CardId", "EVENT": "targetId is EventId" } }, "forbiddenFields": ["rawToken", "targetCardId", "targetEventId"], "collectionNameNote": "Historical collection name retained; records support both CARD and EVENT share tokens through targetType + targetId.", "sensitivity": "PRIVATE" },
    { "name": "friendships", "primaryWriter": "socialApi", "required": ["_id", "requesterUserId", "addresseeUserId", "state", "version", "createdAt", "updatedAt"], "stateEnumRef": "FriendshipState@miniprogram/shared/types/enums.ts", "sensitivity": "PRIVATE" },
    { "name": "blocks_reports", "primaryWriter": "socialApi", "required": ["_id", "recordType", "actorUserId", "targetId", "state", "version", "createdAt", "updatedAt"], "states": { "recordType": ["BLOCK", "REPORT"], "state": ["ACTIVE", "REMOVED", "OPEN", "RESOLVED", "DISMISSED"] }, "sensitivity": "RESTRICTED" },
    { "name": "label_catalog", "primaryWriter": "foundation/integration", "required": ["_id", "name", "enabled", "version", "createdAt", "updatedAt"], "sensitivity": "PUBLIC_PROJECTION" },
    { "name": "verification_requests", "primaryWriter": "socialApi", "stateCollaborator": "adminApi", "required": ["_id", "subjectUserId", "labelId", "status", "evidenceAssetIds", "version", "createdAt", "updatedAt"], "stateEnumRef": "ReviewStatus@miniprogram/shared/types/enums.ts", "sensitivity": "HIGHLY_RESTRICTED" },
    { "name": "verification_claims", "primaryWriter": "adminApi", "required": ["_id", "subjectUserId", "labelId", "reviewStatus", "verificationState", "publicVisible", "validFrom", "version", "createdAt", "updatedAt"], "stateEnumRefs": ["ReviewStatus@miniprogram/shared/types/enums.ts", "VerificationState@miniprogram/shared/types/enums.ts"], "publicProjectionInvariant": "reviewStatus=APPROVED AND verificationState=HUMAN_REVIEWED AND publicVisible=true", "sensitivity": "RESTRICTED" },
    { "name": "regions", "primaryWriter": "foundation/integration", "required": ["_id", "name", "version", "createdAt", "updatedAt"], "sensitivity": "PUBLIC_DIRECTORY" },
    { "name": "countries", "primaryWriter": "foundation/integration", "required": ["_id", "regionId", "name", "version", "createdAt", "updatedAt"], "sensitivity": "PUBLIC_DIRECTORY" },
    { "name": "cities", "recordKind": "OPERATIONAL_OVERLAY", "primaryWriter": "foundation/integration", "required": ["_id", "operationalState", "version", "createdAt", "updatedAt"], "stateEnumRef": "OperationalState@miniprogram/shared/types/enums.ts", "forbiddenFields": ["name", "timezone", "countryId", "regionId"], "directorySource": "miniprogram/shared/constants/geography.ts", "cityReferenceInvariant": "_id is a frozen CityId; immutable directory fields are composed from the shared directory and are not copied into this runtime record", "sensitivity": "PUBLIC_DIRECTORY" },
    { "name": "club_nodes", "primaryWriter": "eventApi", "stateCollaborator": "adminApi", "required": ["_id", "cityId", "name", "operationalState", "reviewStatus", "version", "createdAt", "updatedAt"], "stateEnumRefs": ["OperationalState@miniprogram/shared/types/enums.ts", "ReviewStatus@miniprogram/shared/types/enums.ts"], "sensitivity": "RESTRICTED" },
    { "name": "organizers", "primaryWriter": "eventApi", "stateCollaborator": "adminApi", "required": ["_id", "ownerUserId", "name", "cityIds", "reviewStatus", "version", "createdAt", "updatedAt"], "stateEnumRef": "ReviewStatus@miniprogram/shared/types/enums.ts", "sensitivity": "RESTRICTED" },
    { "name": "events", "primaryWriter": "eventApi", "stateCollaborator": "adminApi", "required": ["_id", "organizerId", "clubNodeId", "cityId", "title", "state", "publicationState", "version", "createdAt", "updatedAt"], "stateEnumRefs": ["EventState@miniprogram/shared/types/enums.ts", "PublicationState@miniprogram/shared/types/enums.ts"], "cityReferenceInvariant": "cityId must be a frozen CityId, never free text/country/region", "sensitivity": "RESTRICTED" },
    { "name": "event_enrollments", "primaryWriter": "eventApi", "required": ["_id", "eventId", "userId", "state", "paymentState", "version", "createdAt", "updatedAt"], "stateEnumRefs": ["EnrollmentState@miniprogram/shared/types/enums.ts", "PaymentState@miniprogram/shared/types/enums.ts"], "sensitivity": "PRIVATE" },
    { "name": "art_items", "primaryWriter": "contentApi", "stateCollaborator": "adminApi", "required": ["_id", "creatorId", "title", "category", "publicationState", "mediaRightsState", "version", "createdAt", "updatedAt"], "stateEnumRefs": ["PublicationState@miniprogram/shared/types/enums.ts", "MediaRightsState@miniprogram/shared/types/enums.ts"], "sensitivity": "RESTRICTED" },
    { "name": "art_collections", "primaryWriter": "contentApi", "stateCollaborator": "adminApi", "required": ["_id", "title", "publicationState", "itemIds", "version", "createdAt", "updatedAt"], "stateEnumRef": "PublicationState@miniprogram/shared/types/enums.ts", "sensitivity": "RESTRICTED" },
    { "name": "content_intents", "primaryWriter": "contentApi", "required": ["_id", "contentId", "userId", "state", "version", "createdAt", "updatedAt"], "states": { "state": ["ACTIVE", "CANCELLED"] }, "sensitivity": "PRIVATE" },
    { "name": "media_assets", "primaryWriter": "owning-business-api", "stateCollaborator": "adminApi", "required": ["_id", "ownerUserId", "domain", "storageFileId", "rights", "publicState", "version", "createdAt", "updatedAt"], "publicProjectionInvariant": "Only rights-approved media may expose a public URL", "sensitivity": "HIGHLY_RESTRICTED" },
    { "name": "orders", "primaryWriter": "designated-payment-service-action", "required": ["_id", "userId", "subjectType", "subjectId", "paymentState", "amountMinor", "currency", "version", "createdAt", "updatedAt"], "stateEnumRef": "PaymentState@miniprogram/shared/types/enums.ts", "featureGate": "payment=DISABLED", "sensitivity": "HIGHLY_RESTRICTED" },
    { "name": "feature_flags", "primaryWriter": "foundation/integration", "stateCollaborator": "adminApi-whitelist-only", "required": ["_id", "state", "version", "createdAt", "updatedAt"], "defaults": { "payment": "DISABLED" }, "sensitivity": "RESTRICTED" },
    { "name": "idempotency_keys", "primaryWriter": "namespaced-calling-api", "required": ["_id", "namespace", "requestFingerprint", "requestId", "status", "expiresAt", "createdAt"], "appendOrCompleteOnly": true, "sensitivity": "HIGHLY_RESTRICTED" },
    { "name": "audit_logs", "primaryWriter": "_shared/audit-append-only", "required": ["_id", "actorRole", "action", "targetType", "targetId", "requestId", "occurredAt", "result"], "appendOnly": true, "sensitivity": "HIGHLY_RESTRICTED" },
    { "name": "projection_invalidations", "primaryWriter": "_shared/projections-append-only", "required": ["eventId", "kind", "sourceAggregateId", "sourceVersion", "occurredAt", "reason", "requestId"], "exactFields": ["eventId", "kind", "sourceAggregateId", "sourceVersion", "occurredAt", "reason", "requestId"], "appendOnly": true, "sensitivity": "RESTRICTED" }
  ]
}
