{
  "appid": "",
  "projectname": "ab-club-wechat-local-only",
  "description": "LOCAL_ONLY：AppID 仅由忽略的本机私有配置提供；预览、上传与发布需独立验证",
  "compileType": "miniprogram",
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "setting": {
    "useCompilerPlugins": [
      "typescript"
    ],
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "urlCheck": true,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "ignoreDevUnusedFiles": true,
    "uploadWithSourceMap": true,
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./package.json",
        "miniprogramNpmDistDir": "./miniprogram/"
      }
    ],
    "compileWorklet": false,
    "uglifyFileName": false,
    "localPlugins": false,
    "disableUseStrict": false,
    "condition": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {},
  "simulatorPluginLibVersion": {},
  "packOptions": {
    "ignore": [],
    "include": []
  },
  "editorSetting": {}
}
