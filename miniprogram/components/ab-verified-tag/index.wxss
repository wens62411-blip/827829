:host {
  display: inline-flex;
}

.verified-tag {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--card-accent, var(--card-page-champagne, #80602d));
  border-radius: 999rpx;
  color: var(--card-accent, var(--card-page-champagne, #80602d));
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.verified-tag__mark {
  margin-right: 8rpx;
}

@media (prefers-color-scheme: dark) {
  .verified-tag {
    border-color: var(--card-accent, var(--card-page-champagne, #d5bc8a));
    color: var(--card-accent, var(--card-page-champagne, #d5bc8a));
  }
}
