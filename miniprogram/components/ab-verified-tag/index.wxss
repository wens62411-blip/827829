:host {
  display: inline-flex;
}

.verified-tag {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--card-accent, #8a6538);
  border-radius: 999rpx;
  color: var(--card-accent, #8a6538);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.verified-tag__mark {
  margin-right: 8rpx;
}

@media (prefers-color-scheme: dark) {
  .verified-tag {
    border-color: var(--card-accent, #dec89c);
    color: var(--card-accent, #dec89c);
  }
}
