<view class="loading-city {{visible ? 'loading-city--visible' : ''}}" aria-hidden="{{!visible}}">
  <view class="loading-city__backdrop" aria-hidden="true" />
  <view class="loading-city__stage">
    <view class="loading-city__icon-ring">
      <image
        class="loading-city__icon"
        src="{{city.iconPath}}"
        mode="aspectFit"
        aria-hidden="true"
      />
    </view>
    <view class="loading-city__divider" aria-hidden="true" />
    <view class="loading-city__brand">
      <text class="loading-city__brand-name">AB CLUB</text>
      <text class="loading-city__brand-tag">COLLECTING CITIES & IDENTITIES</text>
    </view>
  </view>
</view>