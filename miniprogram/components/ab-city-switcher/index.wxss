.switcher{position:relative}.switcher__trigger,.switcher__option,.switcher__close{box-sizing:border-box;width:100%;margin:0;border-radius:2rpx;text-align:left}.switcher__trigger::after,.switcher__option::after,.switcher__close::after{border:0}.switcher__trigger{position:relative;display:flex;align-items:center;justify-content:space-between;min-height:122rpx;padding:21rpx 26rpx 21rpx 32rpx;border:1rpx solid #bcae98;background:#fcfaf5;color:#1c2723;transition:border-color 180ms ease,background 180ms ease}.switcher__trigger::before{position:absolute;top:20rpx;bottom:20rpx;left:0;width:4rpx;background:#8a6538;content:""}.switcher__trigger--pressed,.switcher__trigger--expanded{border-color:#173c32;background:#f7f1e6}.switcher__selection,.switcher__option > view{min-width:0}.switcher__eyebrow,.switcher__city,.switcher__meta,.switcher__option-name,.switcher__option-en,.switcher__option-state,.switcher__option-timezone{display:block}.switcher__eyebrow{color:#8a6538;font-size:18rpx;font-weight:700;letter-spacing:.16em}.switcher__city{margin-top:1rpx;color:#173c32;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-size:40rpx;font-weight:500;letter-spacing:.02em;line-height:1.28}.switcher__meta,.switcher__option-en,.switcher__option-timezone{overflow:hidden;color:#64716c;font-size:21rpx;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}.switcher__chevron{flex:0 0 auto;width:58rpx;color:#7b3038;font-family:Georgia,serif;font-size:44rpx;font-weight:400;line-height:1;text-align:center;transition:transform 180ms ease}.switcher__trigger--expanded .switcher__chevron{transform:rotate(180deg)}.switcher__panel{position:relative;z-index:4;margin-top:10rpx;padding:10rpx 18rpx 18rpx;border:1rpx solid #bcae98;border-radius:2rpx;background:#fcfaf5;animation:switcher-panel-in 220ms cubic-bezier(.2,.72,.24,1) both}.switcher__group{display:flex;align-items:baseline;justify-content:space-between;padding:24rpx 8rpx 9rpx;border-bottom:1rpx solid #d8cdbd;color:#8a6538;font-size:20rpx;font-weight:700;letter-spacing:.12em}.switcher__group-country{color:#64716c;font-weight:500;letter-spacing:.02em}.switcher__option{display:flex;align-items:center;justify-content:space-between;min-height:100rpx;padding:17rpx 8rpx;border:0;border-bottom:1rpx solid #e0d7ca;background:transparent;color:#1c2723;line-height:1.35}.switcher__option--selected{padding-left:18rpx;border-left:4rpx solid #7b3038;background:#f3ecdf}.switcher__option--pressed{background:#ece4d6}.switcher__option-name{font-family:Georgia,"Songti SC",SimSun,serif;font-size:29rpx;font-weight:500}.switcher__option-state{max-width:270rpx;color:#173c32;font-size:22rpx;text-align:right}.switcher__close{min-height:88rpx;margin-top:10rpx;border:0;background:transparent;color:#173c32;font-size:23rpx;letter-spacing:.08em;text-align:center}@keyframes switcher-panel-in{from{opacity:0;transform:translateY(-10rpx)}to{opacity:1;transform:translateY(0)}}@media (prefers-color-scheme:dark){.switcher__trigger,.switcher__panel{border-color:#60766d;background:#173c32;color:#fcfbf7}.switcher__trigger--pressed,.switcher__trigger--expanded,.switcher__option--selected,.switcher__option--pressed{background:#1d463b}.switcher__city,.switcher__option,.switcher__option-state,.switcher__close{color:#fcfbf7}.switcher__group,.switcher__option{border-color:#60766d}.switcher__meta,.switcher__option-en,.switcher__option-timezone,.switcher__group-country{color:#c8cfc9}}@media (prefers-reduced-motion:reduce){.switcher__trigger,.switcher__chevron,.switcher__panel{animation:none;transition:none}}