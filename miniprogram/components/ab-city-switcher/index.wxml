<view class="switcher" aria-role="region" aria-label="城市切换"><button class="switcher__trigger ab-motion {{expanded ? 'switcher__trigger--expanded' : ''}}" hover-class="switcher__trigger--pressed" bindtap="toggle" aria-label="当前城市 {{selectedCityLabel}}，{{expanded ? '收起' : '展开'}}城市目录" aria-expanded="{{expanded}}" aria-haspopup="listbox" ><view class="switcher__selection"><text class="switcher__eyebrow">当前城市入口</text><text class="switcher__city">{{selectedCityLabel}}</text><text class="switcher__meta">{{selectedCityMeta}}</text></view><text class="switcher__chevron" aria-hidden="true">{{expanded ? '−' : '+'}}</text></button><view wx:if="{{expanded}}" class="switcher__panel" aria-role="listbox" aria-label="7 国 13 城目录"><view wx:for="{{cities}}" wx:key="id" class="switcher__option-wrap"><view wx:if="{{item.groupStart}}" class="switcher__group"><text>{{item.regionLabel}}</text><text class="switcher__group-country">{{item.countryLabel}}</text></view><button class="switcher__option {{item.id === selectedCityId ? 'switcher__option--selected' : ''}}" data-city-id="{{item.id}}" bindtap="chooseCity" hover-class="switcher__option--pressed" aria-role="option" aria-selected="{{item.id === selectedCityId}}" aria-label="{{item.label}}，目录状态 {{item.catalogLabel}}，运营状态 {{item.operationalLabel}}" ><view><text class="switcher__option-name">{{item.label}}</text><text class="switcher__option-en">{{item.nameEn}}</text></view><view class="switcher__option-state"><text>{{item.operationalLabel}}</text><text class="switcher__option-timezone">{{item.timezone}}</text></view></button></view><button class="switcher__close" bindtap="close" hover-class="switcher__option--pressed">收起城市目录</button></view></view>