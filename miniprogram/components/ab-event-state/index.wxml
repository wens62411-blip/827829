<view class="state state--{{kind}}" aria-role="status" aria-live="polite" aria-label="{{title}}"><view class="state__mark" aria-hidden="true">AB</view><text class="state__eyebrow">{{eyebrow}}</text><text class="state__title">{{title}}</text><text class="state__description">{{description}}</text><view class="state__detail" aria-role="note"><text>{{detail}}</text></view><button wx:if="{{actionLabel}}" class="state__action" bindtap="onAction" hover-class="state__action--pressed">{{actionLabel}}</button></view>