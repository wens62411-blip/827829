.state{position:relative;box-sizing:border-box;padding:66rpx 38rpx 48rpx;border-top:1rpx solid #bcae98;border-bottom:1rpx solid #bcae98;background:transparent;text-align:center;animation:state-arrive 480ms cubic-bezier(.2,.72,.24,1) both}.state::before,.state::after{position:absolute;top:31rpx;width:calc(50% - 67rpx);height:1rpx;background:#c7b99f;content:""}.state::before{left:0}.state::after{right:0}.state__mark{display:inline-flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;margin-bottom:22rpx;border:1rpx solid #8a6538;border-radius:50%;color:#8a6538;font-family:Georgia,serif;font-size:23rpx;letter-spacing:.06em}.state__eyebrow,.state__title,.state__description{display:block}.state__eyebrow{color:#8a6538;font-size:19rpx;font-weight:700;letter-spacing:.17em}.state__title{margin-top:12rpx;color:#211e1a;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-size:40rpx;font-weight:500;letter-spacing:.015em;line-height:1.35}.state__description{max-width:600rpx;margin:20rpx auto 0;color:#716a62;font-size:25rpx;line-height:1.7}.state__detail{margin-top:28rpx;padding:19rpx 22rpx;border-left:4rpx solid #8a6a36;background:#eee7db;color:#5f5b52;font-size:22rpx;line-height:1.65;text-align:left}.state__action{min-height:88rpx;margin-top:30rpx;border:1rpx solid #211e1a;border-radius:2rpx;background:transparent;color:#211e1a;font-size:25rpx;font-weight:600;letter-spacing:.05em;transition:color 160ms ease,background 160ms ease}.state__action::after{border:0}.state__action--pressed{background:#211e1a;color:#fcfbf7}.state--ERROR .state__mark,.state--BLOCKED .state__mark{border-color:#8a6a36;color:#8a6a36}@keyframes state-arrive{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)}}@media (prefers-color-scheme:dark){.state{border-color:#5b554d}.state::before,.state::after{background:#5b554d}.state__title,.state__action{color:#fcfbf7}.state__description{color:#bdb4a7}.state__detail{background:#24211d;color:#bdb4a7}.state__action{border-color:#d8c197}.state__action--pressed{background:#d8c197;color:#161412}}@media (prefers-reduced-motion:reduce){.state{animation:none}.state__action{transition:none}}