:host{display:block}.intent-action{padding-top:24rpx}.intent-action__scope,.intent-action__status{display:block;color:var(--ab-color-muted);font-size:24rpx;line-height:1.55;overflow-wrap:anywhere}.intent-action__button{display:flex;align-items:center;justify-content:center;width:100%;min-height:var(--ab-touch-target);margin-top:20rpx;padding:20rpx 28rpx;border-radius:var(--ab-radius-small);font-size:28rpx;font-weight:600;line-height:1.35}.intent-action__button:after{border:0}.intent-action__button--primary{border:2rpx solid var(--ab-color-green);background:var(--ab-color-green);color:var(--ab-color-paper-white)}.intent-action__button--secondary{border:2rpx solid var(--ab-color-border);background:transparent;color:var(--ab-color-green)}.intent-action__button[disabled]{opacity:.52}.intent-action__status{margin-top:16rpx}@media(prefers-color-scheme:dark){.intent-action__scope,.intent-action__status{color:var(--ab-color-dark-muted)}.intent-action__button--primary{border-color:var(--ab-color-gold-soft);background:var(--ab-color-gold-soft);color:var(--ab-color-dark-canvas)}.intent-action__button--secondary{border-color:var(--ab-color-dark-border);color:var(--ab-color-dark-text)}}
