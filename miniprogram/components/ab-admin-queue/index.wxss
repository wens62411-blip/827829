.queue{display:flex;flex-direction:column;gap:var(--ab-space-3)}.queue__state{box-sizing:border-box;padding:var(--ab-space-5) var(--ab-space-4);border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-standard);background:var(--ab-color-paper);text-align:center}.queue__state-title,.queue__state-copy,.queue-row__title,.queue-row__summary{display:block}.queue__state-title{color:var(--ab-color-green);font-weight:700}.queue__state-copy{margin-top:var(--ab-space-1);color:var(--ab-color-muted);font-size:var(--ab-font-caption)}.queue__retry,.queue__more{margin-top:var(--ab-space-3);border:2rpx solid var(--ab-color-green);border-radius:var(--ab-radius-small);background:transparent;color:var(--ab-color-green);font-size:var(--ab-font-caption)}.queue-row{box-sizing:border-box;width:100%;margin:0;padding:var(--ab-space-4);border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-standard);background:var(--ab-color-paper);color:var(--ab-color-ink);line-height:1.5;text-align:left}.queue-row:after{border:0}.queue-row--selected{border-color:var(--ab-color-gold);box-shadow:inset 6rpx 0 0 var(--ab-color-gold)}.queue-row__topline,.queue-row__footer{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--ab-space-3)}.queue-row__eyebrow,.queue-row__status,.queue-row__footer{color:var(--ab-color-muted);font-size:24rpx}.queue-row__eyebrow{color:var(--ab-color-gold);font-weight:700;letter-spacing:.06em}.queue-row__status{flex:none;padding:2rpx 12rpx;border:2rpx solid var(--ab-color-border);border-radius:999rpx}.queue-row__title{margin-top:var(--ab-space-3);color:var(--ab-color-green);font-size:34rpx;font-weight:700}.queue-row__summary{margin-top:var(--ab-space-1);color:var(--ab-color-muted);font-size:var(--ab-font-caption)}.queue-row__footer{margin-top:var(--ab-space-3)}@media(prefers-color-scheme:dark){.queue__state,.queue-row{border-color:var(--ab-color-dark-border);background:var(--ab-color-dark-surface);color:var(--ab-color-dark-text)}.queue__state-title,.queue-row__title,.queue__retry,.queue__more{color:var(--ab-color-dark-text)}.queue__state-copy,.queue-row__summary,.queue-row__status,.queue-row__footer{color:var(--ab-color-dark-muted)}.queue__retry,.queue__more{border-color:var(--ab-color-gold-soft)}}
