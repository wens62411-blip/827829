.city {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: var(--ab-space-4);
  padding: var(--ab-space-4);
  border: 2rpx solid var(--ab-color-border);
  background: var(--ab-color-paper);
}

.city__operation {
  border-left: 2rpx solid var(--ab-color-border);
  padding-left: var(--ab-space-4);
}

.city__label,
.city__value {
  display: block;
}

.city__label {
  color: var(--ab-color-muted);
  font-size: var(--ab-font-caption);
}

.city__value {
  margin-top: var(--ab-space-1);
  font-weight: 700;
}

@media (prefers-color-scheme: dark) {
  .city {
    border-color: var(--ab-color-dark-border);
    background: var(--ab-color-dark-surface);
  }
}

