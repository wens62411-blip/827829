<view
  class="profile-card profile-card--{{safeViewerMode}} profile-card--theme-{{safeTheme}}"
  aria-role="region"
  aria-label="{{hasCard ? safeCard.displayName + '的数字名片，' + viewerLabel : '数字名片暂不可用'}}"
>
  <block wx:if="{{hasCard}}">
    <view class="profile-card__masthead">
      <image
        wx:if="{{!brandFailed}}"
        class="profile-card__crest"
        src="/assets/brand/ab-club-crest.png"
        mode="aspectFit"
        alt="AB Club 盾徽标志"
        aria-label="AB Club 盾徽标志"
        binderror="handleBrandError"
      />
      <text wx:else class="profile-card__crest-fallback">AB</text>
      <view class="profile-card__edition">
        <text class="profile-card__edition-title">AB Club</text>
        <text class="profile-card__edition-meta">GLOBAL CHINESE COMMUNITY</text>
      </view>
      <text class="profile-card__viewer">{{viewerLabel}}</text>
    </view>

    <view class="profile-card__cover" aria-hidden="true">
      <view class="profile-card__cover-line"></view>
    </view>

    <view class="profile-card__main">
      <view class="profile-card__avatar-wrap" aria-label="头像">
        <image
          wx:if="{{safeCard.avatarUrl && !avatarFailed}}"
          class="profile-card__avatar"
          src="{{safeCard.avatarUrl}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          binderror="handleAvatarError"
          aria-label="{{safeCard.displayName}}的头像"
        />
        <view wx:else class="profile-card__avatar profile-card__avatar--fallback" aria-label="默认头像">
          <text>{{avatarInitial}}</text>
        </view>
      </view>

      <view class="profile-card__identity">
        <text class="profile-card__eyebrow">DIGITAL INTRODUCTION</text>
        <text class="profile-card__name" user-select="{{true}}">{{safeCard.displayName}}</text>
        <text wx:if="{{safeCard.headline}}" class="profile-card__headline">{{safeCard.headline}}</text>
        <view wx:if="{{cityLabel || safeCard.cityId}}" class="profile-card__city-line">
          <image class="profile-card__city-icon" src="/assets/icons/ui-location.png" mode="aspectFit" aria-hidden="true" />
          <text class="profile-card__city">{{cityLabel || safeCard.cityId}}</text>
        </view>
      </view>

      <view wx:if="{{isSelf && showDefaultActions}}" class="profile-card__default-actions">
        <button class="profile-card__action profile-card__action--primary" plain="{{true}}" bindtap="handleEdit">编辑资料</button>
        <button class="profile-card__action" plain="{{true}}" bindtap="handleShare">分享名片</button>
      </view>
      <view class="profile-card__slot-actions"><slot name="actions"></slot></view>
    </view>

    <view wx:if="{{safeCard.biography}}" class="profile-card__section profile-card__biography">
      <view class="profile-card__section-heading">
        <view class="profile-card__heading-label"><image class="profile-card__heading-icon" src="/assets/icons/ui-edit.png" mode="aspectFit" aria-hidden="true" /><text>关于我</text></view>
      </view>
      <text class="profile-card__biography-text" user-select="{{true}}">{{safeCard.biography}}</text>
    </view>

    <view wx:if="{{safeFields.length}}" class="profile-card__section profile-card__fields-section" aria-role="list" aria-label="名片资料">
      <view class="profile-card__section-heading">
        <text>资料</text>
        <text class="profile-card__section-count">{{safeFields.length}} 项</text>
      </view>
      <view class="profile-card__fields">
        <view wx:for="{{safeFields}}" wx:key="key" class="profile-card__field" aria-role="listitem">
          <text class="profile-card__field-label">{{item.label}}</text>
          <text class="profile-card__field-value" user-select="{{true}}">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{isSelf}}" class="profile-card__section profile-card__selected-labels" aria-role="group" aria-label="本人自选标签，未经人工认证">
      <view class="profile-card__section-heading">
        <text>我的标签</text>
        <text class="profile-card__section-count">{{safeSelectedLabels.length}} 项</text>
      </view>
      <text class="profile-card__section-note">自选内容 · 未认证 · 当前未保存到公开名片</text>
      <view wx:if="{{safeSelectedLabels.length}}" class="profile-card__tag-list">
        <text wx:for="{{safeSelectedLabels}}" wx:key="*this" class="profile-card__self-tag">{{item}}</text>
      </view>
      <text wx:else class="profile-card__empty-note">尚未添加自选标签。</text>
    </view>

    <view wx:if="{{isSelf}}" class="profile-card__section profile-card__gallery-section" aria-role="group" aria-label="本人图片预览">
      <view class="profile-card__section-heading">
        <text>图片</text>
        <text class="profile-card__section-count">{{safeGallery.length}} 张</text>
      </view>
      <view wx:if="{{safeGallery.length}}" class="profile-card__gallery">
        <view wx:for="{{safeGallery}}" wx:key="key" class="profile-card__gallery-item">
          <image
            wx:if="{{!item.failed}}"
            class="profile-card__gallery-image"
            src="{{item.url}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            data-index="{{index}}"
            binderror="handleGalleryError"
            aria-label="名片图片 {{index + 1}}"
          />
          <view wx:else class="profile-card__gallery-fallback" aria-label="图片暂不可用"><text>图片暂不可用</text></view>
        </view>
      </view>
      <view wx:else class="profile-card__gallery-empty" aria-role="note">
        <text class="profile-card__gallery-empty-title">尚未添加图片</text>
        <text class="profile-card__gallery-empty-copy">可在编辑名片中添加生活、作品或收藏图片。本机临时图片只用于本人预览，当前不会自动保存。</text>
      </view>
    </view>

    <view wx:if="{{safeClaims.length}}" class="profile-card__section profile-card__claims" aria-role="group" aria-label="人工审核通过标签">
      <view class="profile-card__section-heading">
        <text>人工认证标签</text>
        <text class="profile-card__section-count">{{safeClaims.length}} 项</text>
      </view>
      <text class="profile-card__section-note">仅显示人工审核通过、公开且仍在有效期内的标签。</text>
      <view class="profile-card__claim-strip">
        <block wx:for="{{safeClaims}}" wx:key="key">
          <ab-verified-tag
            wx:if="{{claimsExpanded || index < claimWindow}}"
            label="{{item.label}}"
            review-status="{{item.reviewStatus}}"
            verification-state="{{item.verificationState}}"
          />
        </block>
      </view>
      <button
        wx:if="{{safeClaims.length > claimWindow}}"
        class="profile-card__claim-toggle"
        plain="{{true}}"
        bindtap="handleClaimsToggle"
        aria-expanded="{{claimsExpanded}}"
        aria-label="{{claimsExpanded ? '收起认证标签' : '展开全部认证标签'}}"
      >{{claimsExpanded ? '收起' : '另有 ' + (safeClaims.length - claimWindow) + ' 项'}}</button>
    </view>

    <view
      wx:if="{{isSelf && (safePendingLabels.length || safeRejectedLabels.length)}}"
      class="profile-card__section profile-card__owner-review"
      aria-role="note"
      aria-label="仅本人可见的审核进度"
    >
      <text class="profile-card__owner-caption">仅本人可见 · 审核进度</text>
      <view wx:for="{{safePendingLabels}}" wx:key="*this" class="profile-card__review-line">
        <text class="profile-card__review-state profile-card__review-state--pending">审核中</text>
        <text class="profile-card__review-label">{{item}}</text>
      </view>
      <view wx:for="{{safeRejectedLabels}}" wx:key="*this" class="profile-card__review-line">
        <text class="profile-card__review-state profile-card__review-state--rejected">未通过</text>
        <text class="profile-card__review-label">{{item}}</text>
      </view>
    </view>
  </block>

  <view wx:else class="profile-card__empty" aria-live="polite">
    <text class="profile-card__empty-title">名片暂不可用</text>
    <text class="profile-card__empty-copy">请稍后重试；不会使用模拟资料代替真实结果。</text>
    <button class="profile-card__action profile-card__action--retry" plain="{{true}}" bindtap="handleRetry">重新加载</button>
    <slot name="empty"></slot>
  </view>
</view>
