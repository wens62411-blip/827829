.hero {
  overflow: hidden;
  border: 1rpx solid var(--ab-color-border);
  border-radius: 12rpx;
  background: var(--ab-color-paper-white);
  box-shadow: 0 16rpx 46rpx rgba(68, 55, 38, 0.07);
}

.hero__media {
  position: relative;
  height: 430rpx;
  overflow: hidden;
  background: #e8e0d3;
}

.hero__image,
.hero__fallback {
  width: 100%;
  height: 100%;
}

.hero__image {
  opacity: 0;
  transform: scale(1.02);
  transition: opacity 420ms ease, transform 820ms cubic-bezier(0.2, 0.72, 0.24, 1);
}

.hero__image--ready {
  opacity: 1;
  transform: scale(1);
}

.hero__fallback {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ab-color-muted);
}

.hero__fallback-mark {
  color: var(--ab-color-gold-brown);
  font-family: Georgia, serif;
  font-size: 38rpx;
  letter-spacing: 0.16em;
}

.hero__fallback-city {
  margin-top: 12rpx;
  color: var(--ab-color-ink);
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
}

.hero__fallback-note {
  margin-top: 7rpx;
  font-size: 21rpx;
}

.hero__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(22, 20, 18, 0.04) 30%, rgba(22, 20, 18, 0.68));
  pointer-events: none;
}

.hero__copy {
  position: absolute;
  right: 26rpx;
  bottom: 24rpx;
  left: 26rpx;
  padding-left: 18rpx;
  border-left: 4rpx solid var(--ab-color-gold-soft);
  color: #fffdf8;
}

.hero__kicker,
.hero__title,
.hero__subtitle,
.hero__credit,
.hero__fact-label,
.hero__fact-value,
.hero__alt {
  display: block;
}

.hero__kicker {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.hero__title {
  margin-top: 5rpx;
  font-family: Georgia, "Songti SC", "STSong", SimSun, serif;
  font-size: 54rpx;
  line-height: 1.08;
}

.hero__subtitle {
  margin-top: 2rpx;
  font-family: Georgia, serif;
  font-size: 23rpx;
  letter-spacing: 0.12em;
}

.hero__credit {
  padding: 12rpx 22rpx;
  border-bottom: 1rpx solid var(--ab-color-border);
  color: var(--ab-color-muted);
  font-size: 17rpx;
  line-height: 1.5;
}

.hero__facts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 24rpx 20rpx 22rpx;
}

.hero__fact {
  min-width: 0;
  padding: 2rpx 16rpx;
}

.hero__fact--bordered {
  border-left: 1rpx solid var(--ab-color-border);
}

.hero__fact--wide {
  grid-column: 1 / -1;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--ab-color-border);
}

.hero__fact-label {
  color: var(--ab-color-muted);
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 0.08em;
}

.hero__fact-value {
  margin-top: 5rpx;
  color: var(--ab-color-ink);
  font-family: Georgia, "Songti SC", serif;
  font-size: 27rpx;
}

.hero__fact-value--timezone {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 22rpx;
}

.hero__evidence {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 16rpx 22rpx;
  border-top: 1rpx solid var(--ab-color-border);
  border-bottom: 1rpx solid var(--ab-color-border);
  color: var(--ab-color-champagne-deep);
  font-size: 19rpx;
  font-weight: 700;
}

.hero__evidence-right {
  color: var(--ab-color-muted);
  font-weight: 500;
  text-align: right;
}

.hero__alt {
  padding: 12rpx 22rpx 16rpx;
  color: var(--ab-color-muted);
  font-size: 18rpx;
  line-height: 1.5;
}

@media (min-width: 760px) {
  .hero__media {
    height: 540rpx;
  }

  .hero__facts {
    grid-template-columns: 0.8fr 0.8fr 1.4fr;
  }

  .hero__fact--wide {
    grid-column: auto;
    margin-top: 0;
    padding-top: 2rpx;
    border-top: 0;
    border-left: 1rpx solid var(--ab-color-border);
  }
}

@media (prefers-color-scheme: dark) {
  .hero {
    border-color: var(--ab-color-dark-border);
    background: var(--ab-color-dark-surface);
  }

  .hero__fallback {
    background: #2d2924;
  }

  .hero__fallback-city,
  .hero__fact-value {
    color: var(--ab-color-dark-text);
  }

  .hero__fallback-note,
  .hero__credit,
  .hero__fact-label,
  .hero__alt,
  .hero__evidence-right {
    color: var(--ab-color-dark-muted);
  }

  .hero__fact--bordered,
  .hero__fact--wide,
  .hero__credit,
  .hero__evidence {
    border-color: var(--ab-color-dark-border);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero__image {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
