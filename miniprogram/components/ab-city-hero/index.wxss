.hero{overflow:hidden;border:1rpx solid #bcae98;border-radius:2rpx;background:#fcfaf5}.hero__media{position:relative;height:500rpx;overflow:hidden;background:#d4cab9}.hero__media::after{position:absolute;inset:14rpx;border:1rpx solid rgba(252,251,247,.5);content:"";pointer-events:none}.hero__image,.hero__fallback{width:100%;height:100%}.hero__image{opacity:0;transform:scale(1.035);transition:opacity 560ms ease,transform 1000ms cubic-bezier(.2,.72,.24,1)}.hero__image--ready{opacity:1;transform:scale(1)}.hero__fallback{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;border:0;background:#ebe3d5}.hero__fallback-mark{color:#8a6538;font-family:Georgia,serif;font-size:64rpx;line-height:1}.hero__fallback-city{margin-top:14rpx;color:#173c32;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-size:36rpx}.hero__fallback-note{margin-top:8rpx;color:#64716c;font-size:22rpx}.hero__shade{position:absolute;inset:0;background:rgba(8,29,23,.2);pointer-events:none}.hero__copy{position:absolute;right:28rpx;bottom:28rpx;left:28rpx;padding:22rpx 24rpx 20rpx;border-left:4rpx solid #c89b5b;background:rgba(10,35,28,.78);color:#fcfbf7}.hero__kicker,.hero__title,.hero__subtitle,.hero__credit,.hero__fact-label,.hero__fact-value,.hero__alt{display:block}.hero__kicker{font-size:18rpx;font-weight:700;letter-spacing:.19em}.hero__title{margin-top:5rpx;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-size:58rpx;font-weight:500;letter-spacing:.025em;line-height:1.1}.hero__subtitle{margin-top:2rpx;font-family:Georgia,serif;font-size:24rpx;letter-spacing:.12em}.hero__credit{padding:13rpx 24rpx;border-bottom:1rpx solid #d1c6b6;color:#5e6964;font-size:18rpx;line-height:1.5;letter-spacing:.035em}.hero__facts{display:grid;grid-template-columns:1fr 1fr;padding:26rpx 22rpx 24rpx}.hero__fact{min-width:0;padding:2rpx 18rpx}.hero__fact--bordered{border-left:1rpx solid #d1c6b6}.hero__fact--wide{grid-column:1 / -1;margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #d1c6b6}.hero__fact-label{color:#64716c;font-size:19rpx;font-weight:650;letter-spacing:.08em}.hero__fact-value{margin-top:5rpx;color:#173c32;font-family:Georgia,"Songti SC",SimSun,serif;font-size:28rpx;font-weight:500}.hero__fact-value--timezone{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:23rpx}.hero__evidence{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:17rpx 24rpx;border-top:1rpx solid #d1c6b6;border-bottom:1rpx solid #d1c6b6;color:#773f3d;font-size:20rpx;font-weight:700;letter-spacing:.025em}.hero__evidence-right{color:#64716c;font-weight:500;text-align:right}.hero__alt{padding:13rpx 24rpx 17rpx;color:#64716c;font-size:19rpx;line-height:1.5}@media (min-width:760px){.hero__media{height:580rpx}.hero__facts{grid-template-columns:.8fr .8fr 1.4fr}.hero__fact--wide{grid-column:auto;margin-top:0;padding-top:2rpx;border-top:0;border-left:1rpx solid #d1c6b6}}@media (prefers-color-scheme:dark){.hero{border-color:#60766d;background:#173c32}.hero__fallback{background:#1d463b}.hero__fallback-city,.hero__fact-value{color:#fcfbf7}.hero__fallback-note,.hero__credit,.hero__fact-label,.hero__alt,.hero__evidence-right{color:#c8cfc9}.hero__fact--bordered,.hero__fact--wide,.hero__credit,.hero__evidence{border-color:#60766d}.hero__evidence{color:#e3bd7d}}@media (prefers-reduced-motion:reduce){.hero__image{opacity:1;transform:none;transition:none}}