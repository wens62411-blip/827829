<view class="hero" aria-role="region" aria-label="{{cityName}}城市入口"><view class="hero__media" aria-role="img" aria-label="{{imageAlt}}"><image wx:if="{{imageSrc && !imageFailed}}" class="hero__image {{imageReady ? 'hero__image--ready' : ''}}" src="{{imageSrc}}" mode="aspectFill" alt="{{imageAlt}}" aria-label="{{imageAlt}}" bindload="onImageLoad" binderror="onImageError" /><view wx:else class="hero__fallback ab-image-fallback" aria-role="img" aria-label="{{imageAlt}}加载失败，已显示文字替代"><text class="hero__fallback-mark">AB</text><text class="hero__fallback-city">{{cityName || '城市图片不可用'}}</text><text class="hero__fallback-note">图片加载失败 · 已启用无外链替代</text></view><view class="hero__shade" aria-hidden="true"></view><view class="hero__copy"><text class="hero__kicker">AB CLUB · CITY DIRECTORY</text><text class="hero__title">{{cityName}}</text><text class="hero__subtitle">{{cityNameEn}}</text></view></view><text wx:if="{{photoCredit}}" class="hero__credit">PHOTO CREDIT · {{photoCredit}}</text><view class="hero__facts" aria-role="group" aria-label="目录与运营事实"><view class="hero__fact"><text class="hero__fact-label">城市入口</text><text class="hero__fact-value">{{catalogLabel}}</text></view><view class="hero__fact hero__fact--bordered"><text class="hero__fact-label">节点运营</text><text class="hero__fact-value">{{operationalLabel}}</text></view><view class="hero__fact hero__fact--wide"><text class="hero__fact-label">当地时区</text><text class="hero__fact-value hero__fact-value--timezone">{{timezone}}</text></view></view><view class="hero__evidence" aria-role="note"><text>{{operationEvidence}}</text><text class="hero__evidence-right">素材 {{mediaRightsLabel}}</text></view><text class="hero__alt">图片说明：{{imageAlt}}</text></view>