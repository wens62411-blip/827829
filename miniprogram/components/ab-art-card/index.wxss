:host{display:block}.art-card{display:grid;grid-template-columns:196rpx minmax(0,1fr);gap:32rpx;padding:36rpx 0;border-top:2rpx solid var(--ab-color-border);transition:opacity var(--ab-motion-quick) ease}.art-card--pressed{opacity:.66}.art-card__media{min-width:0}.art-card__image,.art-card__fallback{width:196rpx;height:252rpx}.art-card__image{display:block;background:var(--ab-color-paper)}.art-card__fallback{box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;padding:20rpx;border:2rpx solid var(--ab-color-border);background:var(--ab-color-paper);color:var(--ab-color-muted);text-align:center}.art-card__fallback-mark,.art-card__fallback-copy,.art-card__title,.art-card__summary,.art-card__creator{display:block}.art-card__fallback-mark{color:var(--ab-color-ink);font-family:Georgia,Songti SC,SimSun,serif;font-size:38rpx;letter-spacing:.08em}.art-card__fallback-copy{font-size:22rpx;line-height:1.45}.art-card__body{min-width:0}.art-card__kicker,.art-card__footer,.art-card__evidence{display:flex;align-items:center}.art-card__kicker{justify-content:space-between;gap:16rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.4}.art-card__category{color:var(--ab-color-ink);font-weight:700;letter-spacing:.08em}.art-card__city{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.art-card__title{margin-top:14rpx;color:var(--ab-color-ink);font-family:Georgia,Songti SC,STSong,serif;font-size:36rpx;font-weight:600;line-height:1.34;overflow-wrap:anywhere;word-break:break-word}.art-card__summary{margin-top:14rpx;color:var(--ab-color-muted);font-size:26rpx;line-height:1.58;overflow-wrap:anywhere;word-break:break-word}.art-card__footer{align-items:flex-end;justify-content:space-between;gap:16rpx;margin-top:22rpx}.art-card__creator{min-width:0;color:var(--ab-color-ink);font-size:24rpx;line-height:1.5;overflow-wrap:anywhere}.art-card__evidence{flex:none;flex-wrap:wrap;justify-content:flex-end;gap:8rpx;color:var(--ab-color-muted);font-size:20rpx;letter-spacing:.04em}@media(max-width:340px){.art-card{grid-template-columns:156rpx minmax(0,1fr);gap:24rpx}.art-card__image,.art-card__fallback{width:156rpx;height:218rpx}}@media(prefers-color-scheme:dark){.art-card{border-color:var(--ab-color-dark-border)}.art-card__image,.art-card__fallback{border-color:var(--ab-color-dark-border);background:var(--ab-color-dark-surface)}.art-card__fallback,.art-card__kicker,.art-card__summary,.art-card__evidence{color:var(--ab-color-dark-muted)}.art-card__fallback-mark,.art-card__category{color:var(--ab-color-gold-soft)}.art-card__title,.art-card__creator{color:var(--ab-color-dark-text)}}
