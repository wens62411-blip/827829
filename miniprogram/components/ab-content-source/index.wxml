<view class="source" aria-role="group" aria-label="内容来源"><view class="source__topline"><text class="source__title">{{sourceTitle || '来源信息不可用'}}</text><view class="source__labels" aria-label="记录来源 {{recordOriginLabel}}；内容范围 {{evidenceScopeLabel}}"><text>{{recordOriginLabel}}</text></view></view><text wx:if="{{!sourceUrl}}" class="source__missing">暂无来源链接</text><button
    wx:if="{{sourceUrl}}"
    class="source__copy ab-motion"
    hover-class="source__copy--pressed"
    aria-label="复制内容来源链接"
    bindtap="handleCopy"
  >复制来源链接</button></view>
