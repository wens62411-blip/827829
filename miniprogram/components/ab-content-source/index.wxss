:host{display:block}.source{min-width:0}.source__topline,.source__labels{display:flex;align-items:flex-start}.source__topline{justify-content:space-between;gap:20rpx}.source__title,.source__url,.source__missing{display:block;overflow-wrap:anywhere;word-break:break-word}.source__title{min-width:0;color:var(--ab-color-ink);font-weight:600}.source__labels{flex:none;flex-wrap:wrap;justify-content:flex-end;gap:8rpx;color:var(--ab-color-muted);font-size:20rpx;letter-spacing:.04em}.source__url,.source__missing{margin-top:12rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.55}.source__missing{border-left:4rpx solid var(--ab-color-gold);padding-left:16rpx}.source__copy{display:inline-flex;align-items:center;justify-content:center;min-height:var(--ab-touch-target);margin:16rpx 0 0;padding:0 24rpx;border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-small);background:transparent;color:var(--ab-color-ink);font-size:26rpx;line-height:1}.source__copy:after{border:0}.source__copy--pressed{opacity:.64}@media(prefers-color-scheme:dark){.source__title,.source__copy{color:var(--ab-color-dark-text)}.source__labels,.source__url,.source__missing{color:var(--ab-color-dark-muted)}.source__copy{border-color:var(--ab-color-dark-border)}}
