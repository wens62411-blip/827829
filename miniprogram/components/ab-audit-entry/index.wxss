.audit{box-sizing:border-box;padding:var(--ab-space-4);border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-standard);background:var(--ab-color-paper)}.audit__topline{display:flex;align-items:flex-start;justify-content:space-between;gap:var(--ab-space-3)}.audit__action,.audit__time,.audit__reason,.audit__grid text{display:block}.audit__action{color:var(--ab-color-green);font-weight:700;word-break:break-word}.audit__result{flex:none;padding:2rpx 12rpx;border:2rpx solid var(--ab-color-border);border-radius:999rpx;color:var(--ab-color-muted);font-size:22rpx}.audit__result--SUCCEEDED{border-color:var(--ab-color-green);color:var(--ab-color-green)}.audit__result--FAILED{border-color:#a94442;color:#8e302d}.audit__time,.audit__grid,.audit__reason{margin-top:var(--ab-space-1);color:var(--ab-color-muted);font-size:var(--ab-font-caption)}.audit__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--ab-space-1) var(--ab-space-3);margin-top:var(--ab-space-3)}.audit__reason{padding-top:var(--ab-space-3);border-top:2rpx solid var(--ab-color-border)}@media(max-width:520px){.audit__grid{grid-template-columns:1fr}}@media(prefers-color-scheme:dark){.audit{border-color:var(--ab-color-dark-border);background:var(--ab-color-dark-surface)}.audit__action,.audit__result--SUCCEEDED{color:var(--ab-color-dark-text)}.audit__time,.audit__grid,.audit__reason,.audit__result{color:var(--ab-color-dark-muted)}.audit__reason,.audit__result{border-color:var(--ab-color-dark-border)}}
