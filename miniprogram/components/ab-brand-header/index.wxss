:host {
  display: block;
  min-width: 0;
}

.brand-header {
  display: flex;
  min-width: 0;
  gap: 28rpx;
  align-items: flex-start;
}

.brand-header__mark {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  align-items: center;
  justify-content: center;
}

.brand-header__crest {
  display: block;
  width: 112rpx;
  height: 112rpx;
}

.brand-header__fallback {
  color: var(--ab-color-gold-brown);
  font-family: Georgia, "Songti SC", serif;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  white-space: nowrap;
}

.brand-header__copy {
  min-width: 0;
  flex: 1;
  padding-top: 4rpx;
}

.brand-header__eyebrow,
.brand-header__title,
.brand-header__subtitle {
  display: block;
  min-width: 0;
  overflow-wrap: anywhere;
}

.brand-header__eyebrow {
  color: var(--ab-color-gold-brown);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.brand-header__title {
  margin-top: 10rpx;
  color: var(--ab-color-ink);
  font-family: Georgia, "Songti SC", "STSong", SimSun, serif;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.22;
}

.brand-header__subtitle {
  max-width: 600rpx;
  margin-top: 14rpx;
  color: var(--ab-color-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.brand-header--compact .brand-header__mark,
.brand-header--compact .brand-header__crest {
  width: 88rpx;
  height: 88rpx;
  flex-basis: 88rpx;
}

.brand-header--compact .brand-header__title {
  font-size: 40rpx;
}

.brand-header--inverse .brand-header__title {
  color: var(--ab-color-dark-text);
}

.brand-header--inverse .brand-header__subtitle {
  color: var(--ab-color-dark-muted);
}

.brand-header--inverse .brand-header__eyebrow,
.brand-header--inverse .brand-header__fallback {
  color: var(--ab-color-gold-soft);
}

@media (max-width: 340px) {
  .brand-header {
    gap: 20rpx;
  }

  .brand-header__mark,
  .brand-header__crest {
    width: 92rpx;
    height: 92rpx;
    flex-basis: 92rpx;
  }

  .brand-header__title {
    font-size: 42rpx;
  }
}

@media (prefers-color-scheme: dark) {
  .brand-header__title {
    color: var(--ab-color-dark-text);
  }

  .brand-header__subtitle {
    color: var(--ab-color-dark-muted);
  }
}
