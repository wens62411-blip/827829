:host {
  display: block;
  min-width: 0;
}

.share-state {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: 420rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--ab-space-6) var(--ab-space-4);
  border: 2rpx solid var(--ab-color-border);
  border-radius: var(--ab-radius-standard);
  background: var(--ab-color-paper);
  color: var(--ab-color-ink);
  text-align: center;
}

.share-state__mark {
  box-sizing: border-box;
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--ab-color-gold-soft);
  border-radius: 50%;
  color: var(--ab-color-green);
  font-size: 44rpx;
  font-weight: 700;
}

.share-state--ERROR .share-state__mark,
.share-state--EXPIRED .share-state__mark,
.share-state--REVOKED .share-state__mark {
  color: var(--ab-color-gold-brown);
}

.share-state__eyebrow {
  margin-top: var(--ab-space-4);
  color: var(--ab-color-gold-brown);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.share-state__title,
.share-state__description,
.share-state__assist {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.share-state__title {
  margin-top: var(--ab-space-1);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.share-state__description {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: var(--ab-color-muted);
  font-size: 28rpx;
  line-height: 1.65;
}

.share-state__detail:not(:empty),
.share-state__slot-actions:not(:empty) {
  display: block;
  width: 100%;
  margin-top: var(--ab-space-4);
}

.share-state__actions {
  display: grid;
  width: 100%;
  max-width: 560rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--ab-space-3);
  margin-top: var(--ab-space-5);
}

.share-state__action {
  box-sizing: border-box;
  min-width: 0;
  min-height: var(--ab-touch-target);
  margin: 0;
  padding: 0 var(--ab-space-3);
  border: 2rpx solid var(--ab-color-green);
  border-radius: var(--ab-radius-small);
  color: var(--ab-color-green);
  font-size: 28rpx;
  font-weight: 600;
  line-height: calc(var(--ab-touch-target) - 4rpx);
}

.share-state__action--forward {
  background: var(--ab-color-green);
  color: var(--ab-color-paper);
}

.share-state__action[disabled] {
  border-color: var(--ab-color-border);
  background: transparent;
  color: var(--ab-color-muted);
}

.share-state__assist {
  max-width: 560rpx;
  margin-top: var(--ab-space-3);
  color: var(--ab-color-muted);
  font-size: 25rpx;
}

@media (max-width: 360px) {
  .share-state__actions {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (prefers-color-scheme: dark) {
  .share-state {
    border-color: var(--ab-color-dark-border);
    background: var(--ab-color-dark-surface);
    color: var(--ab-color-dark-text);
  }

  .share-state__mark {
    border-color: var(--ab-color-gold-soft);
    color: var(--ab-color-dark-text);
  }

  .share-state__description,
  .share-state__assist {
    color: var(--ab-color-dark-muted);
  }

  .share-state__action {
    border-color: var(--ab-color-gold-soft);
    color: var(--ab-color-dark-text);
  }

  .share-state__action--forward {
    background: var(--ab-color-gold-soft);
    color: var(--ab-color-dark-canvas);
  }
}

@media (prefers-reduced-motion: reduce) {
  .share-state__action {
    transition: none;
  }
}
