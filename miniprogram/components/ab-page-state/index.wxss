.state {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 64rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.state__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ab-space-3);
  margin-bottom: var(--ab-space-5);
}

.state__eyebrow {
  color: var(--ab-color-gold);
  font-size: var(--ab-font-caption);
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.state__title,
.state__description,
.state__notice-detail {
  display: block;
}

.state__title {
  max-width: 640rpx;
  color: var(--ab-color-green);
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: var(--ab-font-title);
  font-weight: 600;
  line-height: 1.25;
}

.state__description {
  max-width: 640rpx;
  margin-top: var(--ab-space-4);
  color: var(--ab-color-muted);
  font-size: var(--ab-font-body);
}

.state__notice {
  margin-top: var(--ab-space-6);
  padding: var(--ab-space-4);
  border-left: 6rpx solid var(--ab-color-gold);
  background: var(--ab-color-paper);
}

.state__notice-detail {
  margin-top: var(--ab-space-1);
  color: var(--ab-color-muted);
  font-size: var(--ab-font-caption);
}

@media (prefers-color-scheme: dark) {
  .state__title {
    color: var(--ab-color-dark-text);
  }

  .state__description,
  .state__notice-detail {
    color: var(--ab-color-dark-muted);
  }

  .state__notice {
    background: var(--ab-color-dark-surface);
  }
}

