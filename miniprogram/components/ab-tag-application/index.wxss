:host { display: block; }

.label {
  box-sizing: border-box;
  width: 100%;
  min-height: 176rpx;
  margin: 0;
  padding: 28rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: var(--ab-radius-standard);
  background: var(--ab-color-paper);
  color: var(--ab-color-ink);
  line-height: 1.45;
  text-align: left;
}

.label::after { border: 0; }
.label--selected { border-color: var(--ab-color-green); box-shadow: inset 8rpx 0 0 var(--ab-color-green); }
.label[disabled] { opacity: 0.55; }
.label__topline { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.label__name,
.label__english,
.label__description,
.label__notice { display: block; }
.label__name { font-size: 32rpx; font-weight: 700; }
.label__choice { color: var(--ab-color-green); font-size: 24rpx; font-weight: 700; }
.label__english { margin-top: 2rpx; color: var(--ab-color-muted); font-size: 24rpx; }
.label__description { margin-top: 16rpx; font-size: 28rpx; }
.label__notice { margin-top: 18rpx; color: var(--ab-color-muted); font-size: 22rpx; }

@media (prefers-color-scheme: dark) {
  .label { border-color: var(--ab-color-dark-border); background: var(--ab-color-dark-surface); color: var(--ab-color-dark-text); }
  .label--selected { border-color: var(--ab-color-gold-soft); box-shadow: inset 8rpx 0 0 var(--ab-color-gold-soft); }
  .label__choice { color: var(--ab-color-gold-soft); }
  .label__english,
  .label__notice { color: var(--ab-color-dark-muted); }
}
