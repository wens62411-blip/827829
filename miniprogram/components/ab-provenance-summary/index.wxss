:host{display:block}.provenance{border-bottom:2rpx solid var(--ab-color-border)}.provenance__section{display:grid;grid-template-columns:56rpx minmax(0,1fr);gap:20rpx;padding:32rpx 0;border-top:2rpx solid var(--ab-color-border)}.provenance__section--statement{border-top-color:var(--ab-color-gold)}.provenance__index{color:var(--ab-color-muted);font-family:Georgia,serif;font-size:22rpx}.provenance__content{min-width:0}.provenance__heading,.provenance__value,.provenance__note,.provenance__statement{display:block;overflow-wrap:anywhere;word-break:break-word}.provenance__heading{margin-bottom:16rpx;color:var(--ab-color-green);font-size:24rpx;font-weight:700;letter-spacing:.05em}.provenance__value{color:var(--ab-color-ink);font-size:28rpx;font-weight:600}.provenance__note{margin-top:10rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.55}.provenance__statement{color:var(--ab-color-ink);font-family:Georgia,Songti SC,STSong,serif;font-size:30rpx;font-weight:600;line-height:1.55}@media(prefers-color-scheme:dark){.provenance,.provenance__section{border-color:var(--ab-color-dark-border)}.provenance__section--statement{border-top-color:var(--ab-color-gold-soft)}.provenance__index,.provenance__note{color:var(--ab-color-dark-muted)}.provenance__heading{color:var(--ab-color-gold-soft)}.provenance__value,.provenance__statement{color:var(--ab-color-dark-text)}}
