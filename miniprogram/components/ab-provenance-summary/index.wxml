<view class="provenance" aria-role="region" aria-label="资料来源"><view class="provenance__section"><view class="provenance__content"><ab-content-source
        source-title="{{sourceTitle}}"
        source-url="{{sourceUrl}}"
        record-origin="{{recordOrigin}}"
        evidence-scope="{{evidenceScope}}"
        bindsourcecopy="handleSourceCopy"
      /></view></view><view wx:if="{{platformStatement}}" class="provenance__section provenance__section--statement"><view class="provenance__content"><text class="provenance__statement">{{platformStatement}}</text></view></view></view>
