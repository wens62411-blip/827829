@import "./shared/design-tokens/tokens.wxss";

page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  background: var(--ab-color-ivory);
  color: var(--ab-color-ink);
  font-family: var(--ab-font-text);
  font-size: var(--ab-font-body);
  line-height: 1.6;
}

button,
input,
textarea,
picker,
navigator {
  box-sizing: border-box;
  max-width: 100%;
  font-family: inherit;
}

image {
  max-width: 100%;
}

.card-title,
.ab-editorial-title {
  font-family: var(--ab-font-display);
  font-weight: 500;
  letter-spacing: 0.015em;
}

button,
navigator,
.ab-touch-target {
  min-height: var(--ab-touch-target);
}

.ab-actions {
  display: flex;
  flex-direction: column;
  gap: var(--ab-space-3);
  margin-top: var(--ab-space-5);
}

.ab-safe-bottom {
  box-sizing: border-box;
  padding-bottom: calc(var(--ab-space-6) + env(safe-area-inset-bottom));
}

.ab-action {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  min-height: var(--ab-touch-target);
  gap: var(--ab-space-3);
  padding: var(--ab-space-3) var(--ab-space-4);
  border: 2rpx solid var(--ab-color-ink);
  border-radius: var(--ab-radius-small);
  background: var(--ab-color-paper);
  color: var(--ab-color-ink);
  font-weight: 600;
  overflow-wrap: anywhere;
}

.ab-action::after {
  content: "›";
  padding-inline-start: var(--ab-space-3);
}

@media (prefers-color-scheme: dark) {
  page {
    background: var(--ab-color-dark-canvas);
    color: var(--ab-color-dark-text);
  }

  .ab-action {
    border-color: var(--ab-color-gold-soft);
    background: var(--ab-color-dark-surface);
    color: var(--ab-color-dark-text);
  }
}

@media (prefers-reduced-motion: reduce) {
  page, view, button, image, text, navigator, picker {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
