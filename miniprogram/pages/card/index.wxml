<view class="card-page">
  <view class="personal-share-canvas-stage" aria-hidden="true"><canvas type="2d" id="nativeCardShareCover" class="personal-share-canvas"></canvas></view>
  <view class="card-hero-row">
    <view><text class="card-kicker">AB CLUB</text><text class="card-title">我的数字名片</text></view>
  </view>

  <view wx:if="{{status === 'LOADING'}}" class="card-skeleton" aria-label="正在加载名片"></view>

  <view wx:elif="{{status === 'ERROR'}}" class="card-panel card-panel--error">
    <text class="card-panel__title">名片暂时不可用</text>
    <text class="card-panel__text">{{message}}</text>
    <button class="card-button-secondary" style="margin-top: 24rpx" bindtap="loadCard">重试</button>
    <navigator class="card-link-button" style="margin-top: 18rpx" url="/packageCard/pages/edit/index" hover-class="none">编辑名片</navigator>
  </view>

  <ab-profile-card
    wx:elif="{{card}}"
    class="card-owner-profile"
    card="{{card}}"
    viewer-mode="SELF"
    city-label="{{cityLabel}}"
    fields="{{demoMode ? demoFields : []}}"
    selected-labels="{{demoMode ? demoSelectedLabels : []}}"
    gallery-urls="{{demoGalleryUrls}}"
    theme="{{cardTheme}}"
    max-visible-claims="3"
    show-default-actions="{{false}}"
  >
    <view slot="actions" class="card-inline-actions card-first-actions">
      <button class="card-link-button" bindtap="openEditor"><image class="card-link-button__icon" src="/assets/icons/ui-edit.png" mode="aspectFit" aria-hidden="true" /><text>编辑名片</text></button>
      <button class="card-link-button card-link-button--strong" open-type="share" disabled="{{!shareReady || sharePreparing || shareRevoking}}"><image class="card-link-button__icon" src="/assets/icons/ui-share-light.png" mode="aspectFit" aria-hidden="true" /><text>{{sharePreparing ? '正在准备…' : '分享名片'}}</text></button>
    </view>
  </ab-profile-card>

  <view wx:if="{{card && shareHint}}" class="card-owner-share-feedback" aria-live="polite">
    <text>{{shareHint}}</text>
    <button wx:if="{{!shareReady && !sharePreparing && !shareRevoking}}" class="card-button-secondary" bindtap="prepareWechatShare">重新准备分享</button>
  </view>

  <view wx:if="{{card}}" class="card-secondary-tools" aria-label="名片管理">
    <button class="card-secondary-tool" bindtap="openShareManager">名片海报 <text>›</text></button>
  </view>
</view>
