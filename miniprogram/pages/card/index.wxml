<view class="card-page">
  <view class="card-hero-row">
    <view><text class="card-kicker">AB CLUB · DIGITAL CARD</text><text class="card-title">我的数字名片</text></view>
  </view>
  <text class="card-subtitle">一张克制、私密可控的自我介绍。先填写，再交换；公开认证完全可选。</text>

  <view wx:if="{{status === 'LOADING'}}" class="card-skeleton" aria-label="正在加载名片"></view>

  <view wx:elif="{{status === 'ERROR'}}" class="card-panel card-panel--error">
    <text class="card-panel__title">名片暂时不可用</text>
    <text class="card-panel__text">{{message}}</text>
    <button class="card-button-secondary" style="margin-top: 24rpx" bindtap="loadCard">重试</button>
    <navigator class="card-link-button" style="margin-top: 18rpx" url="/packageCard/pages/edit/index" hover-class="none">完善最小资料</navigator>
  </view>

  <ab-profile-card
    wx:elif="{{card}}"
    class="card-owner-profile"
    card="{{card}}"
    viewer-mode="SELF"
    city-label="{{cityLabel}}"
    fields="{{demoMode ? demoFields : []}}"
    selected-labels="{{demoMode ? demoSelectedLabels : []}}"
    gallery-urls="{{demoGalleryUrls}}"
    theme="{{cardTheme}}"
    max-visible-claims="3"
    show-default-actions="{{false}}"
  >
    <view slot="actions" class="card-inline-actions card-first-actions">
      <button class="card-link-button" bindtap="openEditor"><image class="card-link-button__icon" src="/assets/icons/ui-edit.png" mode="aspectFit" aria-hidden="true" /><text>编辑名片</text></button>
      <button class="card-link-button card-link-button--strong" bindtap="openShare"><image class="card-link-button__icon" src="/assets/icons/ui-share-light.png" mode="aspectFit" aria-hidden="true" /><text>分享名片</text></button>
    </view>
  </ab-profile-card>

  <view wx:if="{{card}}" class="card-secondary-tools" aria-label="名片管理">
    <navigator class="card-secondary-tool" url="/packageCard/pages/edit/index" hover-class="none">编辑资料 <text>›</text></navigator>
    <navigator class="card-secondary-tool" url="/packageCard/pages/privacy/index" hover-class="none">查看隐私范围 <text>›</text></navigator>
    <navigator wx:if="{{demoMode}}" class="card-secondary-tool" url="/packageCard/pages/view/index?preview=STRANGER" hover-class="none">预览访客视角 <text>›</text></navigator>
  </view>

  <view wx:if="{{card}}" class="card-truth-note" aria-role="note">
    <text>{{localIdentityReady ? '本机名片 · 当前以你填写的内容展示，不会写入云端。' : (demoMode ? '体验版 · 名片可保存在本机体验；分享页可实际发送当前公开字段的体验快照，不会写入云端。' : '名片按当前可见范围显示；分享操作在独立页面完成。')}}</text>
    <text>认证完全可选；标签必须先经过人工审核，才会公开显示。</text>
  </view>
</view>
