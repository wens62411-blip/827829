.card-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--ab-color-ivory);
  color: var(--ab-color-ink);
}

.card-page--centered {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-kicker {
  display: block;
  margin-bottom: 12rpx;
  color: var(--ab-color-gold-brown);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.card-title {
  display: block;
  max-width: 100%;
  color: var(--ab-color-deep-green);
  font-size: 52rpx;
  font-weight: 650;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.card-hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-monogram {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border: 2rpx solid var(--ab-color-gold-brown);
  border-radius: 50%;
  color: var(--ab-color-deep-green);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-subtitle {
  display: block;
  margin-top: 18rpx;
  color: var(--ab-color-muted);
  font-size: 28rpx;
  line-height: 1.7;
}

.card-runtime {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  min-height: 52rpx;
  margin-top: 24rpx;
  padding: 0 18rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: 999rpx;
  color: var(--ab-color-muted);
  font-size: 23rpx;
  font-weight: 600;
}

.card-panel {
  box-sizing: border-box;
  width: 100%;
  margin-top: 28rpx;
  padding: 30rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: var(--ab-radius-standard);
  background: var(--ab-color-paper-white);
}

.card-panel--accent {
  border-left: 8rpx solid var(--ab-color-gold-brown);
}

.card-panel--error {
  border-color: #a55a4d;
}

.card-panel--wine {
  border-top: 8rpx solid #7b342f;
}

.card-panel__eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #7b342f;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.card-panel__title {
  display: block;
  color: var(--ab-color-deep-green);
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
}

.card-panel__text {
  display: block;
  margin-top: 12rpx;
  color: var(--ab-color-muted);
  font-size: 26rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.card-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.card-row--wrap {
  flex-wrap: wrap;
}

.card-meta {
  min-width: 0;
  flex: 1;
}

.card-meta__label {
  display: block;
  color: var(--ab-color-muted);
  font-size: 24rpx;
}

.card-meta__value {
  display: block;
  margin-top: 4rpx;
  color: var(--ab-color-ink);
  font-size: 29rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.card-button,
.card-button-secondary,
.card-link-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  margin: 0;
  padding: 20rpx 28rpx;
  border-radius: var(--ab-radius-small);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.35;
  transition: opacity var(--ab-motion-quick) ease;
}

.card-button {
  border: 2rpx solid var(--ab-color-deep-green);
  background: var(--ab-color-deep-green);
  color: #ffffff;
}

.card-button-secondary,
.card-link-button {
  border: 2rpx solid var(--ab-color-deep-green);
  background: transparent;
  color: var(--ab-color-deep-green);
}

.card-button::after,
.card-button-secondary::after,
.card-link-button::after {
  border: 0;
}

.card-button[disabled],
.card-button-secondary[disabled] {
  border-color: var(--ab-color-border);
  background: #e8e4db;
  color: #7f8883;
  opacity: 1;
}

.card-button:active,
.card-button-secondary:active,
.card-link-button:active {
  opacity: 0.76;
}

.card-inline-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.card-status {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid var(--ab-color-gold-brown);
  background: #f1eadc;
  color: #5d513e;
  font-size: 26rpx;
  line-height: 1.6;
}

.card-status--error {
  border-left-color: #a55a4d;
  background: #f6e7e2;
  color: #713b32;
}

.card-status--success {
  border-left-color: var(--ab-color-deep-green);
  background: #e4ede8;
  color: var(--ab-color-deep-green);
}

.card-demo-ribbon {
  margin-top: 26rpx;
  padding: 14rpx 18rpx;
  border-left: 6rpx solid #7b342f;
  background: #efe3df;
  color: #6d302c;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.card-review-item {
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--ab-color-border);
}

.card-review-item:last-child { border-bottom: 0; }
.card-review-item__label { color: var(--ab-color-ink); font-size: 27rpx; font-weight: 650; }
.card-review-item__state { padding: 4rpx 14rpx; border: 2rpx solid #a67c3d; border-radius: 999rpx; color: #7b342f; font-size: 21rpx; }
.card-review-item__note { display:block; margin-top:10rpx; color:var(--ab-color-muted); font-size:24rpx; line-height:1.55; }

.card-link-button--compact { min-height:76rpx; margin-top:22rpx; padding:14rpx 20rpx; }

.card-step {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--ab-color-border);
}
.card-step > text { width:60rpx; flex:0 0 60rpx; color:var(--ab-color-gold-brown); font-size:22rpx; }
.card-step > view { min-width:0; flex:1; }
.card-step > view > text { display:block; color:var(--ab-color-ink); font-size:27rpx; font-weight:650; }
.card-step > view > text + text { margin-top:8rpx; color:var(--ab-color-muted); font-size:24rpx; font-weight:400; line-height:1.55; }

.card-form-section {
  margin-top: 36rpx;
}

.card-section-heading {
  display: block;
  margin-bottom: 18rpx;
  color: var(--ab-color-deep-green);
  font-size: 34rpx;
  font-weight: 650;
}

.card-section-caption {
  display: block;
  margin: -6rpx 0 22rpx;
  color: var(--ab-color-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.card-field {
  display: block;
  margin-top: 24rpx;
}

.card-field__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
  color: var(--ab-color-ink);
  font-size: 27rpx;
  font-weight: 600;
}

.card-field__hint {
  color: var(--ab-color-muted);
  font-size: 22rpx;
  font-weight: 400;
}

.card-input,
.card-textarea,
.card-picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: var(--ab-radius-small);
  background: var(--ab-color-paper-white);
  color: var(--ab-color-ink);
  font-size: 28rpx;
}

.card-input[disabled] {
  background: #efede7;
  color: #78817d;
}

.card-textarea {
  min-height: 220rpx;
  line-height: 1.6;
}

.card-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-counter {
  display: block;
  margin-top: 8rpx;
  color: var(--ab-color-muted);
  font-size: 22rpx;
  text-align: right;
}

.card-avatar-draft {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.card-avatar-draft__image,
.card-avatar-draft__fallback {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: 50%;
  background: #ece7dc;
}

.card-avatar-draft__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ab-color-muted);
  font-size: 24rpx;
}

.card-contract-lock {
  position: relative;
  margin-top: 18rpx;
  padding: 24rpx;
  border: 2rpx dashed var(--ab-color-border);
  border-radius: var(--ab-radius-small);
  background: #efede7;
}

.card-contract-lock__label {
  display: block;
  color: var(--ab-color-ink);
  font-size: 27rpx;
  font-weight: 600;
}

.card-contract-lock__reason {
  display: block;
  margin-top: 8rpx;
  color: var(--ab-color-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.card-list-link {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--ab-color-border);
  color: var(--ab-color-ink);
  font-size: 28rpx;
}

.card-list-link:last-child {
  border-bottom: 0;
}

.card-list-link__arrow {
  color: var(--ab-color-gold-brown);
  font-size: 36rpx;
}

.card-meaning-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.card-meaning {
  padding: 22rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: var(--ab-radius-small);
}

.card-meaning__code {
  display: block;
  color: var(--ab-color-deep-green);
  font-size: 24rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.card-meaning__text {
  display: block;
  margin-top: 8rpx;
  color: var(--ab-color-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.card-canvas-shell {
  box-sizing: border-box;
  width: 100%;
  margin-top: 24rpx;
  padding: 16rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: var(--ab-radius-standard);
  background: var(--ab-color-paper-white);
}

.card-poster-canvas {
  display: block;
  width: 100%;
  height: 880rpx;
  border-radius: var(--ab-radius-small);
  background: #f6f1e7;
}

.card-hidden-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 640px;
  height: 880px;
  pointer-events: none;
}

.card-skeleton {
  min-height: 300rpx;
  margin-top: 28rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: var(--ab-radius-standard);
  background: var(--ab-color-paper-white);
}

.card-divider {
  height: 2rpx;
  margin: 28rpx 0;
  background: var(--ab-color-border);
}

@media (min-width: 700px) {
  .card-page {
    max-width: 960rpx;
    margin: 0 auto;
    padding-left: 48rpx;
    padding-right: 48rpx;
  }

  .card-meaning-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (prefers-color-scheme: dark) {
  .card-page {
    background: var(--ab-color-dark-canvas);
    color: var(--ab-color-dark-text);
  }

  .card-title,
  .card-monogram,
  .card-panel__title,
  .card-section-heading,
  .card-meaning__code,
  .card-field__label,
  .card-meta__value,
  .card-list-link,
  .card-contract-lock__label {
    color: var(--ab-color-dark-text);
  }

  .card-subtitle,
  .card-panel__text,
  .card-section-caption,
  .card-field__hint,
  .card-counter,
  .card-meta__label,
  .card-meaning__text,
  .card-contract-lock__reason {
    color: var(--ab-color-dark-muted);
  }

  .card-panel,
  .card-input,
  .card-textarea,
  .card-picker,
  .card-canvas-shell,
  .card-skeleton {
    border-color: var(--ab-color-dark-border);
    background: var(--ab-color-dark-surface);
    color: var(--ab-color-dark-text);
  }

  .card-runtime,
  .card-meaning,
  .card-list-link,
  .card-divider {
    border-color: var(--ab-color-dark-border);
  }

  .card-button-secondary,
  .card-link-button {
    border-color: var(--ab-color-gold-soft);
    color: var(--ab-color-dark-text);
  }

  .card-contract-lock,
  .card-input[disabled] {
    border-color: var(--ab-color-dark-border);
    background: #244239;
    color: var(--ab-color-dark-muted);
  }

  .card-status {
    background: #403827;
    color: #eadabc;
  }

  .card-status--error {
    background: #4d302c;
    color: #f1ccc4;
  }

  .card-status--success {
    background: #23483c;
    color: #d7eadf;
  }

  .card-demo-ribbon { background:#4d302c; color:#f1ccc4; }
  .card-panel__eyebrow,.card-review-item__state { color:#e4caa1; }
  .card-review-item,.card-step { border-color:var(--ab-color-dark-border); }
  .card-review-item__label,.card-step > view > text { color:var(--ab-color-dark-text); }
  .card-review-item__note,.card-step > view > text + text { color:var(--ab-color-dark-muted); }
}

@media (prefers-reduced-motion: reduce) {
  .card-button,
  .card-button-secondary,
  .card-link-button {
    transition: none;
  }
}
