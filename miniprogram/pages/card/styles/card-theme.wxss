.card-page {
  --card-page-muted: var(--ab-color-muted);
  --card-page-paper: var(--ab-color-paper);
  --card-page-line: var(--ab-color-border);
  --card-page-champagne: var(--ab-color-champagne-deep);
  --card-page-ink: var(--ab-color-ink);
  --card-page-gold: var(--ab-color-gold);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--ab-color-ivory);
  color: var(--card-page-ink);
}

.card-page--centered {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-kicker {
  display: block;
  margin-bottom: 12rpx;
  color: var(--card-page-champagne);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.card-title {
  display: block;
  max-width: 100%;
  color: var(--card-page-ink);
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 52rpx;
  font-weight: 650;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.card-hero-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.card-monogram {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border: 2rpx solid var(--card-page-champagne);
  border-radius: 50%;
  color: var(--card-page-ink);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-brand-crest {
  display: block;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
}

.card-subtitle {
  display: block;
  margin-top: 18rpx;
  color: var(--card-page-muted);
  font-size: 28rpx;
  line-height: 1.7;
}

.card-runtime {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  min-height: 52rpx;
  margin-top: 24rpx;
  padding: 0 18rpx;
  border: 2rpx solid var(--card-page-line);
  border-radius: 999rpx;
  color: var(--card-page-muted);
  font-size: 23rpx;
  font-weight: 600;
}

.card-panel {
  box-sizing: border-box;
  width: 100%;
  margin-top: 28rpx;
  padding: 30rpx;
  border: 2rpx solid var(--card-page-line);
  border-radius: 4rpx;
  background: var(--card-page-paper);
}

.card-panel--accent {
  border-left: 8rpx solid var(--card-page-champagne);
}

.card-panel--error {
  border-color: var(--card-page-champagne);
}

.card-panel--brand {
  border-top: 8rpx solid var(--card-page-champagne);
}

.card-panel__eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: var(--card-page-champagne);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.card-panel__title {
  display: block;
  color: var(--card-page-ink);
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.35;
}

.card-panel__text {
  display: block;
  margin-top: 12rpx;
  color: var(--card-page-muted);
  font-size: 26rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.card-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.card-row--wrap {
  flex-wrap: wrap;
}

.card-meta {
  min-width: 0;
  flex: 1;
}

.card-meta__label {
  display: block;
  color: var(--card-page-muted);
  font-size: 24rpx;
}

.card-meta__value {
  display: block;
  margin-top: 4rpx;
  color: var(--card-page-ink);
  font-size: 29rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.card-button,
.card-button-secondary,
.card-link-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  margin: 0;
  padding: 20rpx 28rpx;
  border-radius: 18rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.35;
  transition: opacity var(--ab-motion-quick) ease;
}

.card-button {
  border: 2rpx solid var(--card-page-champagne);
  background: var(--card-page-champagne);
  color: var(--card-page-paper);
}

.card-button-secondary,
.card-link-button {
  border: 2rpx solid var(--card-page-champagne);
  background: transparent;
  color: var(--card-page-champagne);
}

.card-link-button--strong,
.card-button--share {
  border-color: var(--card-page-champagne);
  background: var(--card-page-champagne);
  color: var(--card-page-paper);
}

.card-link-button__icon {
  display: block;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  margin-right: 12rpx;
}

.card-button--compact {
  min-height: var(--ab-touch-target);
  margin-top: 16rpx;
}

.card-button::after,
.card-button-secondary::after,
.card-link-button::after {
  border: 0;
}

.card-button:active,
.card-button-secondary:active,
.card-link-button:active {
  opacity: 0.76;
}

.card-inline-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.card-inline-actions--three {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.card-inline-action--wide {
  grid-column: 1 / -1;
}

.card-owner-profile {
  display: block;
  margin-top: 28rpx;
}

.card-first-actions {
  width: 100%;
  min-width: 0;
  margin-top: 0;
}

.card-first-actions .card-link-button {
  min-width: 0;
}

.card-secondary-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 18rpx;
}

.card-secondary-tool {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  min-height: var(--ab-touch-target);
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx 18rpx;
  border-bottom: 2rpx solid var(--card-page-line);
  color: var(--card-page-muted);
  font-size: 25rpx;
  line-height: 1.45;
}

.card-secondary-tool > text {
  flex: 0 0 auto;
  color: var(--card-page-champagne);
  font-size: 30rpx;
}

.card-truth-note {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--card-page-line);
  color: var(--card-page-muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.card-truth-note > text {
  display: block;
}

.card-truth-note > text + text {
  margin-top: 4rpx;
}

.card-status {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid var(--card-page-champagne);
  background: #f1eadc;
  color: #5d513e;
  font-size: 26rpx;
  line-height: 1.6;
}

.card-status--error {
  border-left-color: var(--card-page-champagne);
  background: #eee6da;
  color: var(--card-page-ink);
}

.card-status--success {
  border-left-color: var(--card-page-gold);
  background: #efe6d6;
  color: #5a4325;
}

.card-demo-ribbon {
  margin-top: 26rpx;
  padding: 14rpx 18rpx;
  border-left: 6rpx solid var(--card-page-champagne);
  background: #f1eadc;
  color: var(--card-page-ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.card-verification-note {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-left: 4rpx solid var(--card-page-gold);
  background: #eee6da;
  color: var(--card-page-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.card-verification-note__label {
  display: block;
  margin-bottom: 4rpx;
  color: var(--card-page-champagne);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: .12em;
}

.card-review-item {
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--card-page-line);
}

.card-review-item:last-child { border-bottom: 0; }
.card-review-item__label { color: var(--card-page-ink); font-size: 27rpx; font-weight: 650; }
.card-review-item__state { padding: 4rpx 14rpx; border: 2rpx solid var(--card-page-champagne); border-radius: 999rpx; color: var(--card-page-champagne); font-size: 21rpx; }
.card-review-item__note { display:block; margin-top:10rpx; color:var(--card-page-muted); font-size:24rpx; line-height:1.55; }

.card-link-button--compact { min-height:var(--ab-touch-target); margin-top:22rpx; padding:14rpx 20rpx; }

.card-step {
  display: flex;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--card-page-line);
}
.card-step > text { width:60rpx; flex:0 0 60rpx; color:var(--card-page-champagne); font-size:22rpx; }
.card-step > view { min-width:0; flex:1; }
.card-step > view > text { display:block; color:var(--card-page-ink); font-size:27rpx; font-weight:650; }
.card-step > view > text + text { margin-top:8rpx; color:var(--card-page-muted); font-size:24rpx; font-weight:400; line-height:1.55; }

.card-form-section {
  margin-top: 36rpx;
}

.card-section-heading {
  display: block;
  margin-bottom: 18rpx;
  color: var(--card-page-ink);
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 650;
}

.card-section-caption {
  display: block;
  margin: -6rpx 0 22rpx;
  color: var(--card-page-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.card-field {
  display: block;
  margin-top: 24rpx;
}

.card-field__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
  color: var(--card-page-ink);
  font-size: 27rpx;
  font-weight: 600;
}

.card-field__hint {
  color: var(--card-page-muted);
  font-size: 22rpx;
  font-weight: 400;
}

.card-input,
.card-textarea,
.card-picker {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--card-page-line);
  border-radius: 2rpx;
  background: var(--card-page-paper);
  color: var(--card-page-ink);
  font-size: 28rpx;
}

.card-textarea {
  min-height: 220rpx;
  line-height: 1.6;
}

.card-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-counter {
  display: block;
  margin-top: 8rpx;
  color: var(--card-page-muted);
  font-size: 22rpx;
  text-align: right;
}

.card-avatar-draft {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.card-avatar-draft__image,
.card-avatar-draft__fallback {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border: 2rpx solid var(--card-page-line);
  border-radius: 50%;
  background: #ece7dc;
}

.card-live-preview {
  margin-top: 34rpx;
}

.card-live-preview__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
  color: var(--card-page-champagne);
}

.card-live-preview__kicker {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: .12em;
}

.card-live-preview__note {
  color: var(--card-page-muted);
  font-size: 21rpx;
  text-align: right;
}

.card-interest-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.card-interest-chip {
  box-sizing: border-box;
  min-height: var(--ab-touch-target);
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid var(--card-page-line);
  border-radius: 999rpx;
  background: transparent;
  color: var(--card-page-muted);
  font-size: 23rpx;
  line-height: calc(var(--ab-touch-target) - 4rpx);
}

.card-interest-chip::after {
  border: 0;
}

.card-interest-chip--selected {
  border-color: var(--card-page-champagne);
  background: #f1eadc;
  color: var(--card-page-champagne);
}

.card-contract-note {
  margin-top: 32rpx;
  padding: 24rpx 26rpx;
  border-left: 6rpx solid var(--card-page-gold);
  background: #eee6da;
  color: var(--card-page-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.card-contract-note__title {
  display: block;
  margin-bottom: 6rpx;
  color: var(--card-page-ink);
  font-weight: 700;
}

.card-action-caption {
  display: block;
  color: var(--card-page-muted);
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.card-stack--inside {
  margin-top: 0;
}

.card-avatar-draft__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--card-page-muted);
  font-size: 24rpx;
}

.card-contract-lock {
  position: relative;
  margin-top: 18rpx;
  padding: 24rpx;
  border: 2rpx dashed var(--card-page-line);
  border-radius: var(--ab-radius-small);
  background: #efede7;
}

.card-contract-lock__label {
  display: block;
  color: var(--card-page-ink);
  font-size: 27rpx;
  font-weight: 600;
}

.card-contract-lock__reason {
  display: block;
  margin-top: 8rpx;
  color: var(--card-page-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.card-list-link {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--card-page-line);
  color: var(--card-page-ink);
  font-size: 28rpx;
}

.card-list-link:last-child {
  border-bottom: 0;
}

.card-list-link__arrow {
  color: var(--card-page-champagne);
  font-size: 36rpx;
}

.card-meaning-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.card-meaning {
  padding: 22rpx;
  border: 2rpx solid var(--card-page-line);
  border-radius: var(--ab-radius-small);
}

.card-meaning__code {
  display: block;
  color: var(--card-page-ink);
  font-size: 24rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.card-meaning__text {
  display: block;
  margin-top: 8rpx;
  color: var(--card-page-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.card-canvas-shell {
  box-sizing: border-box;
  width: 100%;
  margin-top: 24rpx;
  padding: 16rpx;
  border: 2rpx solid var(--card-page-line);
  border-radius: var(--ab-radius-standard);
  background: var(--card-page-paper);
}

.card-poster-canvas {
  display: block;
  width: 100%;
  height: 880rpx;
  border-radius: var(--ab-radius-small);
  background: #f6f1e7;
}

.card-hidden-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 640px;
  height: 880px;
  pointer-events: none;
}

.card-skeleton {
  min-height: 300rpx;
  margin-top: 28rpx;
  border: 2rpx solid var(--card-page-line);
  border-radius: var(--ab-radius-standard);
  background: var(--card-page-paper);
}

.card-divider {
  height: 2rpx;
  margin: 28rpx 0;
  background: var(--card-page-line);
}

@media (min-width: 700px) {
  .card-page {
    max-width: 960rpx;
    margin: 0 auto;
    padding-left: 48rpx;
    padding-right: 48rpx;
  }

  .card-meaning-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 380px) {
  .card-inline-actions,
  .card-secondary-tools {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (prefers-color-scheme: dark) {
  .card-page {
    --card-page-muted: var(--ab-color-dark-muted);
    --card-page-paper: var(--ab-color-dark-surface);
    --card-page-line: var(--ab-color-dark-border);
    --card-page-champagne: var(--ab-color-gold-soft);
    --card-page-ink: var(--ab-color-dark-text);
    --card-page-gold: var(--ab-color-gold-soft);
    background: var(--ab-color-dark-canvas);
    color: var(--card-page-ink);
  }

  .card-title,
  .card-monogram,
  .card-panel__title,
  .card-section-heading,
  .card-meaning__code,
  .card-field__label,
  .card-meta__value,
  .card-list-link,
  .card-contract-lock__label {
    color: var(--card-page-ink);
  }

  .card-subtitle,
  .card-panel__text,
  .card-section-caption,
  .card-field__hint,
  .card-counter,
  .card-meta__label,
  .card-meaning__text,
  .card-contract-lock__reason {
    color: var(--card-page-muted);
  }

  .card-panel,
  .card-input,
  .card-textarea,
  .card-picker,
  .card-canvas-shell,
  .card-skeleton {
    border-color: var(--card-page-line);
    background: var(--card-page-paper);
    color: var(--card-page-ink);
  }

  .card-runtime,
  .card-meaning,
  .card-list-link,
  .card-divider {
    border-color: var(--card-page-line);
  }

  .card-button-secondary,
  .card-link-button {
    border-color: var(--card-page-champagne);
    color: var(--card-page-ink);
  }

  .card-contract-lock {
    border-color: var(--card-page-line);
    background: #2d2924;
    color: var(--card-page-muted);
  }

  .card-status {
    background: #332e27;
    color: var(--card-page-ink);
  }

  .card-status--error {
    background: #382f24;
    color: var(--card-page-ink);
  }

  .card-status--success {
    background: #4b402e;
    color: #f0dfbe;
  }

  .card-demo-ribbon { background:#332e27; color:var(--card-page-ink); }
  .card-verification-note { background:#2d2924; }
  .card-panel__eyebrow,.card-review-item__state { color:var(--card-page-champagne); }
  .card-review-item,.card-step { border-color:var(--card-page-line); }
  .card-review-item__label,.card-step > view > text { color:var(--card-page-ink); }
  .card-review-item__note,.card-step > view > text + text { color:var(--card-page-muted); }
  .card-interest-chip--selected { background:#3a3326; }
  .card-contract-note { background:#2d2924; }
}

@media (prefers-reduced-motion: reduce) {
  .card-button,
  .card-button-secondary,
  .card-link-button {
    transition: none;
  }
}
