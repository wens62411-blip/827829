<view class="card-page bootstrap-page">
  <ab-brand-header
    eyebrow="AB CLUB · GLOBAL BUSINESS CARD"
    title="先完成一张能被记住的名片"
    subtitle="为全球华人商业连接而设计。先填写、即时预览，再由你决定何时交换与分享。"
  />
  <view class="bootstrap-evidence" aria-role="status">
    <text class="bootstrap-evidence__dot"></text>
    <text>{{demoMode ? 'SYNTHETIC · DEMO_ONLY' : '微信身份连接中'}}</text>
  </view>

  <view class="bootstrap-editorial" aria-label="数字名片核心流程">
    <view class="bootstrap-editorial__step"><text>01</text><text>填写资料</text></view>
    <view class="bootstrap-editorial__rule"></view>
    <view class="bootstrap-editorial__step"><text>02</text><text>实时预览</text></view>
    <view class="bootstrap-editorial__rule"></view>
    <view class="bootstrap-editorial__step"><text>03</text><text>交换分享</text></view>
  </view>

  <view wx:if="{{message}}" class="card-status {{status === 'ERROR' ? 'card-status--error' : ''}}" aria-live="polite">{{message}}</view>

  <view class="card-stack">
    <button wx:if="{{!demoMode}}" class="card-button" bindtap="initializeIdentity" loading="{{status === 'LOADING'}}" disabled="{{status === 'LOADING'}}">
      {{status === 'LOADING' ? '正在初始化…' : '初始化微信身份'}}
    </button>
    <button class="card-button" bindtap="continueOffline" disabled="{{status === 'LOADING'}}">{{demoMode ? '预览数字名片流程' : '开始制作数字名片'}}</button>
    <navigator class="bootstrap-link" open-type="switchTab" url="/pages/discover/index" hover-class="none">先浏览品牌首页 <text>↗</text></navigator>
  </view>

  <view class="bootstrap-optional" aria-role="note">
    <text class="bootstrap-optional__title">专业标签为可选能力</text>
    <text class="bootstrap-optional__copy">你无需先认证即可创建、预览和交换名片；申请公开专业标签时，才进入人工审核流程。</text>
  </view>
</view>
