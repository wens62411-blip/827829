<view class="card-page bootstrap-page">
  <view class="bootstrap-mark"><text>AB</text></view>
  <text class="card-kicker">AB CLUB · GLOBAL CIRCLE</text>
  <view class="card-title bootstrap-title"><text>先认识彼此，</text><text>再抵达同一座城</text></view>
  <text class="card-subtitle">数字名片连接全球商业、同城活动与艺术收藏。公开内容只来自你主动展示的字段。</text>
  <view class="bootstrap-evidence" aria-role="status">
    <text class="bootstrap-evidence__dot"></text>
    <text>{{demoMode ? 'SYNTHETIC · DEMO_ONLY' : runtimeMode}}</text>
  </view>

  <view class="bootstrap-editorial">
    <text class="bootstrap-editorial__number">01</text>
    <view class="bootstrap-editorial__body">
      <text class="card-panel__title">可信名片，不等于自动认证</text>
      <text class="card-panel__text">标签须经人工审核通过后才公开；手机号、证件、审核原件与微信标识永不进入公开名片。</text>
    </view>
  </view>

  <view wx:if="{{message}}" class="card-status {{status === 'ERROR' ? 'card-status--error' : ''}}" aria-live="polite">{{message}}</view>

  <view class="card-stack">
    <button wx:if="{{!demoMode}}" class="card-button" bindtap="initializeIdentity" loading="{{status === 'LOADING'}}" disabled="{{status === 'LOADING'}}">
      {{status === 'LOADING' ? '正在初始化…' : '初始化微信身份'}}
    </button>
    <button class="card-button" bindtap="continueOffline" disabled="{{status === 'LOADING'}}">{{demoMode ? '查看示例名片' : '进入 AB Club'}}</button>
    <navigator class="bootstrap-link" open-type="switchTab" url="/pages/discover/index" hover-class="none">先浏览活动与艺术频道 <text>↗</text></navigator>
  </view>
</view>
