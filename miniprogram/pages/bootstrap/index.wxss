@import "../card/styles/card-theme.wxss";

.bootstrap-page { justify-content: center; }
.bootstrap-title text { display:block; }
.bootstrap-mark { display:flex; align-items:center; justify-content:center; width:104rpx; height:104rpx; margin-bottom:48rpx; border:2rpx solid #a67c3d; border-radius:50%; color:#173c32; font-size:34rpx; font-weight:700; letter-spacing:3rpx; }
.bootstrap-evidence { display:inline-flex; align-items:center; align-self:flex-start; gap:12rpx; margin-top:28rpx; color:#7b342f; font-size:22rpx; font-weight:650; letter-spacing:2rpx; }
.bootstrap-evidence__dot { width:10rpx; height:10rpx; border-radius:50%; background:#7b342f; }
.bootstrap-editorial { display:flex; gap:24rpx; margin-top:56rpx; padding:30rpx 0; border-top:2rpx solid #d9d2c5; border-bottom:2rpx solid #d9d2c5; }
.bootstrap-editorial__number { color:#a67c3d; font-size:22rpx; letter-spacing:2rpx; }
.bootstrap-editorial__body { flex:1; min-width:0; }
.bootstrap-link { display:flex; align-items:center; justify-content:space-between; min-height:80rpx; color:#173c32; font-size:27rpx; }
@media (prefers-color-scheme: dark) { .bootstrap-mark,.bootstrap-link { color:#fcfbf7; } .bootstrap-editorial { border-color:#49645a; } }
