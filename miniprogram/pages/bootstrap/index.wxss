@import "../card/styles/card-theme.wxss";

.bootstrap-page {
  justify-content: center;
  padding-top: 64rpx;
}

.bootstrap-evidence {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 12rpx;
  margin-top: 28rpx;
  color: var(--ab-color-champagne-deep);
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.bootstrap-evidence__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--ab-color-champagne-deep);
}

.bootstrap-editorial {
  display: flex;
  align-items: center;
  margin-top: 52rpx;
  padding: 30rpx 0;
  border-top: 2rpx solid var(--ab-color-border);
  border-bottom: 2rpx solid var(--ab-color-border);
}

.bootstrap-editorial__step {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 8rpx;
  color: var(--ab-color-ink);
  font-size: 24rpx;
  text-align: center;
}

.bootstrap-editorial__step text:first-child {
  color: var(--ab-color-gold-brown);
  font-family: Georgia, serif;
  font-size: 19rpx;
  letter-spacing: 0.1em;
}

.bootstrap-editorial__rule {
  height: 2rpx;
  flex: 1;
  margin: 0 18rpx;
  background: var(--ab-color-border);
}

.bootstrap-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  color: var(--ab-color-ink);
  font-size: 26rpx;
}

.bootstrap-optional {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--ab-color-border);
}

.bootstrap-optional__title,
.bootstrap-optional__copy {
  display: block;
}

.bootstrap-optional__title {
  color: var(--ab-color-gold-brown);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.06em;
}

.bootstrap-optional__copy {
  margin-top: 10rpx;
  color: var(--ab-color-muted);
  font-size: 23rpx;
  line-height: 1.65;
}

@media (prefers-color-scheme: dark) {
  .bootstrap-editorial,
  .bootstrap-optional {
    border-color: var(--ab-color-dark-border);
  }

  .bootstrap-editorial__step,
  .bootstrap-link {
    color: var(--ab-color-dark-text);
  }

  .bootstrap-editorial__rule {
    background: var(--ab-color-dark-border);
  }

  .bootstrap-optional__copy {
    color: var(--ab-color-dark-muted);
  }
}
