<view class="card-page">
  <text class="card-kicker">PRIVATE DESK</text>
  <text class="card-title">我的 AB Club</text>
  <text class="card-subtitle">管理个人资料、逐字段隐私，以及需要人工审核的公开标签。</text>
  <view wx:if="{{demoMode}}" class="card-demo-ribbon">SYNTHETIC · DEMO_ONLY · 所有资料均为合成示例</view>

  <view wx:if="{{status === 'LOADING'}}" class="card-skeleton" aria-label="正在加载个人资料"></view>

  <view wx:elif="{{status === 'ERROR'}}" class="card-panel card-panel--error">
    <text class="card-panel__title">资料暂时不可用</text>
    <text class="card-panel__text">{{message}}</text>
    <button class="card-button-secondary" style="margin-top: 24rpx" bindtap="loadProfile">重试</button>
    <navigator class="card-link-button" style="margin-top: 18rpx" url="/packageCard/pages/edit/index" hover-class="none">创建或完善最小资料</navigator>
  </view>

  <view wx:elif="{{profile}}" class="card-panel card-panel--accent">
    <view class="card-row card-row--wrap">
      <view class="card-meta">
        <text class="card-meta__label">当前昵称</text>
        <text class="card-meta__value">{{profile.displayName}}</text>
      </view>
      <view class="card-runtime">{{demoMode ? '示例字段 ' : '资料完整度 '}}{{completionPercent}}%</view>
    </view>
    <view wx:if="{{profile.phoneMasked}}" class="card-status">手机号仅显示脱敏值 {{profile.phoneMasked}}，不会进入公开投影。</view>
  </view>

  <ab-profile-card
    wx:if="{{demoMode && profile}}"
    card="{{demoCard}}"
    viewer-mode="SELF"
    city-label="苏黎世"
    fields="{{demoFields}}"
    show-default-actions="{{false}}"
  />

  <view wx:if="{{demoMode}}" class="card-panel card-panel--wine">
    <text class="card-panel__eyebrow">REVIEW DESK · DEMO</text>
    <text class="card-panel__title">公开标签状态</text>
    <view wx:for="{{demoReviewItems}}" wx:key="label" class="card-review-item">
      <view class="card-row"><text class="card-review-item__label">{{item.label}}</text><text class="card-review-item__state">{{item.state}}</text></view>
      <text class="card-review-item__note">{{item.note}}</text>
    </view>
  </view>

  <view class="card-panel">
    <text class="card-panel__title">资料与名片</text>
    <navigator class="card-list-link" url="/packageCard/pages/edit/index" hover-class="none">
      <text>编辑个人资料</text><text class="card-list-link__arrow">›</text>
    </navigator>
    <navigator class="card-list-link" url="/packageCard/pages/privacy/index" hover-class="none">
      <text>逐字段隐私</text><text class="card-list-link__arrow">›</text>
    </navigator>
    <navigator class="card-list-link" url="/packageCard/pages/share/index" hover-class="none">
      <text>安全分享与撤销</text><text class="card-list-link__arrow">›</text>
    </navigator>
    <navigator class="card-list-link" open-type="switchTab" url="/pages/card/index" hover-class="none">
      <text>查看我的公开名片</text><text class="card-list-link__arrow">›</text>
    </navigator>
  </view>

  <view class="card-status">{{demoMode ? '离线示例只展示产品结构，不会建立账户、保存资料、提交审核或生成真实分享。' : '运行模式：' + runtimeMode + '。云端失败时不会回退到模拟资料。'}}</view>
</view>
