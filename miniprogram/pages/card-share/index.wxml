<view class="card-page share-entry-page">
  <view class="personal-share-canvas-stage" aria-hidden="true"><canvas type="2d" id="nativeCardShareCover" class="personal-share-canvas"></canvas></view>
  <view class="share-entry-header">
    <view>
      <text class="card-kicker">SHARED DIGITAL INTRODUCTION</text>
      <text class="card-title">{{visitorTitle}}</text>
      <text class="card-subtitle">查看分享者选择公开的资料。</text>
    </view>
    <image class="share-entry-header__crest" src="/assets/brand/ab-club-crest.png" mode="aspectFit" alt="AB Club 盾徽标志" />
  </view>

  <view wx:if="{{localIdentityMode}}" class="card-demo-ribbon">分享者公开资料 · 用户自填</view>
  <view wx:elif="{{demoMode}}" class="card-demo-ribbon">演示名片 · 合成示例</view>

  <ab-share-state
    wx:if="{{state !== 'SUCCESS'}}"
    state="{{state}}"
    title="{{stateTitle}}"
    description="{{stateDescription}}"
    allow-retry="{{allowRetry}}"
    allow-forward="{{allowForward}}"
    bind:retry="handleRetry"
  />

  <ab-profile-card
    wx:if="{{state === 'SUCCESS' && card}}"
    card="{{card}}"
    viewer-mode="STRANGER"
    city-label="{{cityLabel}}"
    fields="{{(demoMode || localIdentityMode) ? demoFields : []}}"
    public-labels="{{demoPublicLabels}}"
    allow-public-contacts="{{demoMode}}"
    theme="{{cardTheme}}"
    max-visible-claims="3"
    show-default-actions="{{false}}"
  />

  <view wx:if="{{state === 'SUCCESS' && card}}" class="share-entry-actions">
    <button class="share-entry-forward" open-type="share">转发这张名片</button>
  </view>

  <view class="share-entry-conversion">
    <text class="share-entry-conversion__kicker">YOUR AB CLUB CARD</text>
    <text class="share-entry-conversion__title">{{selfCardState === 'HAS_CARD' ? '继续管理你的数字名片' : (selfCardState === 'NO_CARD' ? '创建一张属于你的数字名片' : '进入你的数字名片空间')}}</text>
    <button class="share-entry-conversion__button" bindtap="openMyCardEntry">{{selfCardState === 'HAS_CARD' ? '查看我的名片' : (selfCardState === 'NO_CARD' ? '创建我的数字名片' : '进入我的名片')}}</button>
  </view>
</view>
