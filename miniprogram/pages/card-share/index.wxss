@import "../card/styles/card-theme.wxss";

.share-entry-page {
  padding-top: 34rpx;
}

.share-entry-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.share-entry-header__brand { flex: 0 0 auto; color: #806640; font-family: Georgia, "Songti SC", serif; font-size: 24rpx; letter-spacing: .16em; }
.share-entry-header__rule { flex: 1; height: 4rpx; margin-left: 20rpx; border-top: 1rpx solid rgba(146, 118, 77, .38); border-bottom: 1rpx solid rgba(146, 118, 77, .18); }

.share-entry-header > view {
  min-width: 0;
  flex: 1;
}

.share-entry-header__crest {
  display: block;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
}

.share-entry-page ab-share-state,
.share-entry-page ab-profile-card {
  display: block;
  margin-top: 30rpx;
}

.personal-share-canvas-stage { position: fixed; left: -2400rpx; top: -2400rpx; width: 600px; height: 480px; pointer-events: none; }
.personal-share-canvas { width: 600px; height: 480px; }
.share-entry-actions { margin-top: 24rpx; }
.share-entry-forward, .share-entry-conversion__button { min-height: 88rpx; padding: 24rpx; border: 1rpx solid rgba(161, 134, 86, .38); border-radius: 10rpx; background: rgba(220, 202, 168, .14); color: #725735; font-size: 28rpx; line-height: 1.45; }
.share-entry-forward::after, .share-entry-conversion__button::after { border: 0; }
.share-entry-forward:active, .share-entry-conversion__button:active { background: rgba(220, 202, 168, .3); }
.share-entry-conversion { display: grid; margin-top: 28rpx; padding: 28rpx 0 0; border-top: 1rpx solid rgba(161, 134, 86, .23); }
.share-entry-conversion__kicker { color: #8a6a36; font-size: 20rpx; letter-spacing: 3rpx; }
.share-entry-conversion__title { color: var(--ab-color-ink); font-size: 32rpx; line-height: 1.5; }
.share-entry-conversion__copy { color: var(--ab-color-muted); font-size: 24rpx; line-height: 1.6; }
@media (prefers-color-scheme: dark) {
  .share-entry-conversion { border-color: rgba(218, 200, 165, .24); }
  .share-entry-conversion__title { color: #f4efe6; }
  .share-entry-conversion__kicker, .share-entry-conversion__copy { color: #d7c9b0; }
  .share-entry-forward, .share-entry-conversion__button { background: rgba(216, 196, 159, .08); color: #e2cfaa; border-color: rgba(218, 200, 165, .35); }
  .share-entry-header__brand { color: #dccaac; }
  .share-entry-header__rule { border-top-color: rgba(218, 200, 165, .38); border-bottom-color: rgba(218, 200, 165, .16); }
}
