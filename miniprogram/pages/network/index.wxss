.network {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx var(--ab-page-gutter) calc(64rpx + env(safe-area-inset-bottom));
  background: var(--ab-color-ivory);
}

.network__status-line {
  display: flex;
  justify-content: flex-end;
  min-height: 54rpx;
  margin-bottom: 18rpx;
}

.network__card-first {
  margin-top: 40rpx;
  overflow: hidden;
  border: 2rpx solid var(--ab-color-border);
  border-radius: 20rpx;
  background: var(--ab-color-paper);
}

.network__card-primary,
.network__card-secondary {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--ab-color-ink);
}

.network__card-primary {
  min-height: 132rpx;
  padding: 24rpx 28rpx;
  background: var(--ab-color-ink);
  color: var(--ab-color-paper);
}

.network__entry-copy {
  min-width: 0;
  flex: 1;
}

.network__card-primary text {
  display: block;
}

.network__card-primary view text:first-child {
  font-family: Georgia, "Songti SC", serif;
  font-size: 31rpx;
  font-weight: 600;
}

.network__card-primary view text:last-child {
  margin-top: 8rpx;
  color: var(--ab-color-gold-soft);
  font-size: 22rpx;
}

.network__entry-icon,
.network__entry-arrow,
.network__chevron-image {
  display: block;
  flex: 0 0 auto;
}

.network__entry-icon {
  width: 38rpx;
  height: 38rpx;
  margin-right: 18rpx;
}

.network__entry-arrow,
.network__chevron-image {
  width: 28rpx;
  height: 28rpx;
  margin-left: 18rpx;
}

.network__entry-arrow--light {
  opacity: .82;
}

.network__card-secondary {
  min-height: 88rpx;
  padding: 0 28rpx;
  border-top: 2rpx solid var(--ab-color-border);
  font-size: 25rpx;
}

.network__pressed {
  opacity: 0.74;
}

.network__demo {
  margin-top: 28rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--ab-color-gold);
  border-bottom: 2rpx solid var(--ab-color-border);
}

.network__demo-kicker,
.network__demo-copy,
.network__metric-label,
.network__metric-value,
.network__metric-note,
.network__section-title,
.network__section-note,
.network__name,
.network__headline,
.network__reason,
.network__optional-kicker {
  display: block;
}

.network__demo-kicker {
  color: var(--ab-color-champagne-deep);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.network__demo-copy {
  margin-top: 10rpx;
  color: var(--ab-color-muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.network__notice {
  margin-top: 28rpx;
  padding: 24rpx;
  border-left: 6rpx solid var(--ab-color-gold);
  background: var(--ab-color-paper);
  font-size: 26rpx;
}

.network__notice--error {
  border-color: #92534c;
}

.network__retry {
  min-height: var(--ab-touch-target);
  margin: 18rpx 0 0;
  padding: 0;
  background: transparent;
  color: var(--ab-color-ink);
  font-size: 26rpx;
  text-align: left;
}

.network__retry::after,
.network__demo-action::after {
  border: 0;
}

.network__grid {
  display: flex;
  gap: 18rpx;
  margin-top: 36rpx;
}

.network__metric {
  box-sizing: border-box;
  min-width: 0;
  min-height: 190rpx;
  flex: 1;
  padding: 24rpx;
  border: 2rpx solid var(--ab-color-border);
  background: var(--ab-color-paper);
  color: var(--ab-color-ink);
}

.network__metric-label {
  font-size: 25rpx;
  font-weight: 700;
}

.network__metric-value {
  margin-top: 16rpx;
  color: var(--ab-color-gold-brown);
  font-family: Georgia, serif;
  font-size: 46rpx;
}

.network__metric-note {
  margin-top: 8rpx;
  color: var(--ab-color-muted);
  font-size: 21rpx;
}

.network__section {
  margin-top: 52rpx;
}

.network__section--secondary,
.network__section--optional {
  padding-top: 36rpx;
  border-top: 2rpx solid var(--ab-color-border);
}

.network__section--optional {
  padding: 32rpx 28rpx;
  border: 2rpx solid var(--ab-color-border);
  background: var(--ab-color-paper);
}

.network__section-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.network__section-title {
  color: var(--ab-color-ink);
  font-family: Georgia, "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.network__section-note {
  margin-top: 8rpx;
  color: var(--ab-color-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.network__optional-kicker {
  margin-bottom: 10rpx;
  color: var(--ab-color-gold-brown);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.network__people,
.network__recommendations {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}

.network__people {
  gap: 16rpx;
}

.network__recommendations {
  gap: 20rpx;
}

.network__recommendation {
  padding: 26rpx;
  border: 2rpx solid var(--ab-color-border);
  background: var(--ab-color-paper);
}

.network__rec-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.network__monogram,
.network__avatar {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.network__monogram {
  border: 2rpx solid var(--ab-color-gold-soft);
  background: var(--ab-color-ink);
  color: var(--ab-color-gold-soft);
  font-family: Georgia, serif;
  font-size: 23rpx;
}

.network__city {
  flex: 0 0 auto;
  color: var(--ab-color-champagne-deep);
  font-size: 20rpx;
}

.network__reason {
  margin-top: 20rpx;
  color: var(--ab-color-ink);
  font-size: 24rpx;
  line-height: 1.65;
}

.network__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.network__chip {
  padding: 7rpx 13rpx;
  border: 2rpx solid var(--ab-color-border);
  border-radius: 999rpx;
  color: var(--ab-color-muted);
  font-size: 20rpx;
}

.network__demo-action {
  min-height: 88rpx;
  margin-top: 22rpx;
  border: 2rpx solid var(--ab-color-ink);
  background: transparent;
  color: var(--ab-color-ink);
  font-size: 24rpx;
}

.network__person {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid var(--ab-color-border);
  background: var(--ab-color-paper);
  color: var(--ab-color-ink);
}

.network__avatar {
  overflow: hidden;
  border: 2rpx solid var(--ab-color-border);
  background: var(--ab-color-ivory);
}

.network__avatar--fallback {
  color: var(--ab-color-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.network__identity {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.network__rec-head .network__identity {
  margin-left: 0;
}

.network__name {
  font-size: 28rpx;
  font-weight: 700;
}

.network__headline {
  margin-top: 2rpx;
  overflow: hidden;
  color: var(--ab-color-muted);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.network__chevron {
  color: var(--ab-color-gold-brown);
  font-size: 40rpx;
}

.network__chevron-image {
  width: 28rpx;
  height: 28rpx;
}

.network__empty {
  margin-top: 24rpx;
  padding: 32rpx 24rpx;
  border: 2rpx dashed var(--ab-color-border);
  color: var(--ab-color-muted);
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.network__actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.network__action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border: 2rpx solid var(--ab-color-ink);
  background: transparent;
  color: var(--ab-color-ink);
  font-size: 26rpx;
  font-weight: 600;
}

.network__action--quiet {
  border-color: var(--ab-color-border);
  color: var(--ab-color-muted);
}

@media (prefers-color-scheme: dark) {
  .network {
    background: var(--ab-color-dark-canvas);
  }

  .network__card-first,
  .network__notice,
  .network__metric,
  .network__person,
  .network__recommendation,
  .network__section--optional {
    border-color: var(--ab-color-dark-border);
    background: var(--ab-color-dark-surface);
    color: var(--ab-color-dark-text);
  }

  .network__card-primary {
    background: var(--ab-color-gold-soft);
    color: var(--ab-color-dark-canvas);
  }

  .network__card-primary view text:last-child,
  .network__card-primary > text {
    color: #5c4930;
  }

  .network__card-secondary,
  .network__section--secondary,
  .network__demo {
    border-color: var(--ab-color-dark-border);
  }

  .network__card-secondary,
  .network__metric-label,
  .network__section-title,
  .network__name,
  .network__reason,
  .network__retry,
  .network__demo-action,
  .network__action {
    color: var(--ab-color-dark-text);
  }

  .network__demo-copy,
  .network__metric-note,
  .network__section-note,
  .network__headline,
  .network__empty,
  .network__chip {
    color: var(--ab-color-dark-muted);
  }

  .network__metric-value,
  .network__chevron {
    color: var(--ab-color-gold-soft);
  }

  .network__avatar {
    border-color: var(--ab-color-dark-border);
    background: var(--ab-color-dark-canvas);
  }

  .network__avatar--fallback {
    color: var(--ab-color-dark-text);
  }

  .network__empty,
  .network__chip,
  .network__demo-action,
  .network__action,
  .network__action--quiet {
    border-color: var(--ab-color-dark-border);
  }
}

@media (prefers-reduced-motion: reduce) {
  .network__pressed {
    opacity: 1;
  }
}
