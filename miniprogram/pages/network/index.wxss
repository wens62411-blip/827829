.network{box-sizing:border-box;min-height:100vh;padding:48rpx var(--ab-page-gutter)}.network__topline,.network__rec-head{display:flex;align-items:center}.network__topline{justify-content:space-between;gap:20rpx}.network__eyebrow{color:var(--ab-color-gold);font-size:22rpx;font-weight:700;letter-spacing:.12em}.network__title{display:block;margin-top:30rpx;color:var(--ab-color-green);font-family:Georgia,"Songti SC",serif;font-size:52rpx;font-weight:600}.network__lead{display:block;margin-top:18rpx;color:var(--ab-color-muted);font-size:28rpx;line-height:1.65}.network__demo{margin-top:32rpx;padding:26rpx;border-top:2rpx solid var(--ab-color-gold);border-bottom:2rpx solid var(--ab-color-border);background:var(--ab-color-paper)}.network__demo-kicker,.network__demo-copy,.network__metric-label,.network__metric-value,.network__metric-note,.network__section-title,.network__section-note,.network__name,.network__headline,.network__reason{display:block}.network__demo-kicker{color:var(--ab-color-burgundy,#713f44);font-size:21rpx;font-weight:700;letter-spacing:.1em}.network__demo-copy{margin-top:12rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.65}.network__notice{margin-top:32rpx;padding:24rpx;border-left:6rpx solid var(--ab-color-gold);background:var(--ab-color-paper);font-size:26rpx}.network__notice--error{border-color:#9d3f36}.network__retry{min-height:72rpx;margin:18rpx 0 0;padding:0;background:transparent;color:var(--ab-color-green);font-size:26rpx;text-align:left}.network__retry::after,.network__demo-action::after{border:0}.network__grid{display:flex;gap:20rpx;margin-top:40rpx}.network__metric{box-sizing:border-box;flex:1;min-height:218rpx;padding:26rpx;border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-standard);background:var(--ab-color-paper);color:var(--ab-color-ink)}.network__metric-label{font-size:26rpx;font-weight:700}.network__metric-value{margin-top:18rpx;color:var(--ab-color-green);font-family:Georgia,serif;font-size:48rpx}.network__metric-note{margin-top:10rpx;color:var(--ab-color-muted);font-size:22rpx}.network__section{margin-top:52rpx}.network__section-head{display:flex;flex-direction:column;gap:6rpx}.network__section-title{font-size:34rpx;font-weight:700}.network__section-note{margin-top:8rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.6}.network__people,.network__recommendations{display:flex;flex-direction:column;margin-top:24rpx}.network__people{gap:18rpx}.network__recommendations{gap:22rpx}.network__recommendation{padding:28rpx;border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-small);background:var(--ab-color-paper)}.network__rec-head{gap:18rpx}.network__monogram,.network__avatar{display:flex;flex:0 0 76rpx;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:50%}.network__monogram{background:var(--ab-color-green);color:var(--ab-color-gold-soft,#d9bf82);font-family:Georgia,serif;font-size:24rpx}.network__city{flex:0 0 auto;color:var(--ab-color-burgundy,#713f44);font-size:21rpx}.network__reason{margin-top:22rpx;color:var(--ab-color-ink);font-size:25rpx;line-height:1.65}.network__chips{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:18rpx}.network__chip{padding:8rpx 14rpx;border:2rpx solid var(--ab-color-border);border-radius:999rpx;color:var(--ab-color-muted);font-size:21rpx}.network__demo-action{min-height:88rpx;margin-top:24rpx;border:2rpx solid var(--ab-color-green);border-radius:var(--ab-radius-small);background:transparent;color:var(--ab-color-green);font-size:25rpx}.network__person{display:flex;align-items:center;min-height:112rpx;padding:18rpx 22rpx;border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-small);background:var(--ab-color-paper);color:var(--ab-color-ink)}.network__avatar{overflow:hidden;background:var(--ab-color-ivory)}.network__avatar--fallback{color:var(--ab-color-green);font-size:22rpx;font-weight:700}.network__identity{flex:1;min-width:0;margin-left:20rpx}.network__rec-head .network__identity{margin-left:0}.network__name{font-size:28rpx;font-weight:700}.network__headline{margin-top:2rpx;overflow:hidden;color:var(--ab-color-muted);font-size:24rpx;text-overflow:ellipsis;white-space:nowrap}.network__chevron{color:var(--ab-color-gold);font-size:40rpx}.network__empty{margin-top:24rpx;padding:32rpx 24rpx;border:2rpx dashed var(--ab-color-border);color:var(--ab-color-muted);font-size:26rpx;text-align:center}.network__actions{display:flex;flex-direction:column;gap:18rpx;margin-top:24rpx}.network__action{display:flex;align-items:center;justify-content:center;min-height:88rpx;border:2rpx solid var(--ab-color-green);border-radius:var(--ab-radius-small);background:var(--ab-color-green);color:#fff;font-size:28rpx;font-weight:700}.network__action--quiet{background:transparent;color:var(--ab-color-green)}@media(prefers-color-scheme:dark){.network__title{color:var(--ab-color-dark-text)}.network__lead,.network__metric-note,.network__section-note,.network__headline,.network__empty,.network__demo-copy,.network__chip{color:var(--ab-color-dark-muted)}.network__notice,.network__metric,.network__person,.network__demo,.network__recommendation{border-color:var(--ab-color-dark-border);background:var(--ab-color-dark-surface);color:var(--ab-color-dark-text)}.network__metric-value,.network__retry{color:var(--ab-color-gold-soft)}.network__avatar{background:var(--ab-color-dark-canvas)}.network__avatar--fallback{color:var(--ab-color-dark-muted)}.network__empty{border-color:var(--ab-color-dark-border)}.network__action{border-color:var(--ab-color-gold-soft);background:var(--ab-color-gold-soft);color:var(--ab-color-dark-canvas)}.network__action--quiet{background:transparent;color:var(--ab-color-dark-text)}.network__reason{color:var(--ab-color-dark-text)}.network__demo-action{border-color:var(--ab-color-gold-soft);color:var(--ab-color-dark-text)}}
