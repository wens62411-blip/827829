<view class="network ab-safe-bottom">
  <ab-brand-header
    eyebrow="AB CLUB · CARD EXCHANGE"
    title="名片交换"
  />

  <view class="network__card-first" aria-role="region" aria-label="数字名片快捷入口">
    <navigator class="network__card-primary" open-type="switchTab" url="/pages/me/index" hover-class="network__pressed">
      <image class="network__entry-icon network__entry-icon--light" src="/assets/icons/ui-card-light.png" mode="aspectFit" aria-hidden="true" /><view class="network__entry-copy"><text>我的名片</text></view><image class="network__entry-arrow network__entry-arrow--light" src="/assets/icons/ui-chevron.png" mode="aspectFit" aria-hidden="true" />
    </navigator>
    <navigator class="network__card-secondary" url="/packageSocial/pages/requests/index" hover-class="network__pressed">
      <image class="network__entry-icon" src="/assets/icons/ui-inbox.png" mode="aspectFit" aria-hidden="true" /><text class="network__entry-copy">查看收到的名片请求</text><image class="network__entry-arrow" src="/assets/icons/ui-chevron.png" mode="aspectFit" aria-hidden="true" />
    </navigator>
  </view>

  <view wx:if="{{demoOnly}}" class="network__demo" aria-role="note">
    <text class="network__demo-kicker">示例人物</text>
  </view>

  <view wx:if="{{errorMessage}}" class="network__notice network__notice--error" aria-role="alert">
    <text>{{errorMessage}}</text>
    <button class="network__retry" disabled="{{loading}}" bindtap="loadOverview">重新加载</button>
  </view>
  <view wx:elif="{{loading && !loaded}}" class="network__notice" aria-role="status">正在读取本人关系状态…</view>

  <view class="network__grid">
    <navigator class="network__metric" url="/packageSocial/pages/requests/index" hover-class="none">
      <text class="network__metric-label">收到的申请</text>
      <text class="network__metric-value">{{loaded ? incomingLoadedCount : '—'}}</text>
    </navigator>
    <view class="network__metric">
      <text class="network__metric-label">已建立关系</text>
      <text class="network__metric-value">{{loaded ? acceptedLoadedCount : '—'}}</text>
    </view>
  </view>

  <view class="network__section">
    <view class="network__section-head">
      <text class="network__section-title">我的人脉</text>
    </view>
    <view wx:if="{{acceptedPreview.length}}" class="network__people">
      <navigator
        wx:for="{{acceptedPreview}}"
        wx:key="ownerUserId"
        class="network__person"
        url="/packageSocial/pages/friend/index?ownerUserId={{item.ownerUserId}}"
        hover-class="none"
        aria-label="查看与{{item.displayName}}的 AB Club 平台关系"
      >
        <image wx:if="{{item.avatarUrl}}" class="network__avatar" src="{{item.avatarUrl}}" mode="aspectFill" aria-label="{{item.displayName}}的头像" />
        <view wx:else class="network__avatar network__avatar--fallback" aria-label="{{item.displayName}}的默认头像">{{item.avatarInitial}}</view>
        <view class="network__identity"><text class="network__name">{{item.displayName}}</text><text wx:if="{{item.headline}}" class="network__headline">{{item.headline}}</text></view>
        <image class="network__chevron-image" src="/assets/icons/ui-chevron.png" mode="aspectFit" aria-hidden="true" />
      </navigator>
    </view>
    <view wx:elif="{{loaded}}" class="network__empty">暂无关系记录</view>
  </view>

  <view wx:if="{{recommendations.length}}" class="network__section network__section--secondary">
    <view class="network__section-head">
      <text class="network__section-title">值得认识</text>
    </view>
    <view class="network__recommendations">
      <view wx:for="{{recommendations}}" wx:key="id" class="network__recommendation">
        <view class="network__rec-head">
          <view class="network__monogram" aria-label="{{item.displayName}}的文字头像">{{item.initials}}</view>
          <view class="network__identity"><text class="network__name">{{item.displayName}}</text><text class="network__headline">{{item.role}}</text></view>
          <text class="network__city">{{item.cityLine}}</text>
        </view>
        <text class="network__reason">{{item.reason}}</text>
        <view class="network__chips"><text wx:for="{{item.interests}}" wx:for-item="interest" wx:key="*this" class="network__chip">{{interest}}</text></view>
        <button class="network__demo-action" bindtap="onDemoRequest">申请认识</button>
      </view>
    </view>
  </view>

  <view class="network__section network__section--optional">
    <text class="network__optional-kicker">OPTIONAL</text>
    <text class="network__section-title">公开专业标签</text>
    <view class="network__actions">
      <navigator class="network__action" url="/packageSocial/pages/tag-apply/index" hover-class="none">了解并发起申请</navigator>
      <navigator class="network__action network__action--quiet" url="/packageSocial/pages/tag-status/index" hover-class="none">查看我的审核状态</navigator>
    </view>
  </view>
</view>
