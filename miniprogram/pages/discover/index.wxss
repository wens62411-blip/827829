.discover-page{min-height:100vh;background:#f6f1e7;color:#1c2723}.discover-hero{position:relative;height:900rpx;overflow:hidden;background:#173c32;color:#fcfbf7}.discover-hero__image{width:100%;height:100%;opacity:.72}.discover-hero__fallback{position:absolute;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;padding:40rpx;background:#173c32;color:#d8c197;font-size:22rpx;line-height:1.6;letter-spacing:.08em;text-align:center}.discover-hero__bar{position:absolute;top:0;right:0;left:0;display:flex;align-items:center;justify-content:space-between;padding:28rpx 32rpx}.discover-brandmark{display:block;flex:none;width:120rpx;height:120rpx}.discover-brandmark__fallback{display:flex;align-items:center;min-height:88rpx;color:#d8c197;font-family:Georgia,"Songti SC",serif;font-size:24rpx;font-weight:600;letter-spacing:.12em}.discover-hero__copy{position:absolute;right:36rpx;bottom:64rpx;left:36rpx;padding:40rpx 36rpx;background:rgba(16,40,33,.86)}
.discover-hero__eyebrow,.discover-kicker{display:block;color:#a67c3d;font-size:20rpx;font-weight:700;letter-spacing:.16em}.discover-hero__eyebrow{color:#d8c197}.discover-hero__title{display:block;margin-top:24rpx;font-family:Georgia,"Songti SC",serif;font-size:58rpx;font-weight:500;line-height:1.25;letter-spacing:.02em;white-space:pre-line}.discover-hero__description{display:block;max-width:590rpx;margin-top:28rpx;color:rgba(252,251,247,.86);font-size:27rpx;line-height:1.75}
.discover-runtime{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin:28rpx 32rpx 0;padding:24rpx;border-left:6rpx solid #a67c3d;background:#eee7da}.discover-runtime__label,.discover-runtime__text{display:block}.discover-runtime__label{font-size:24rpx;font-weight:700}.discover-runtime__text{margin-top:6rpx;color:#64716c;font-size:22rpx;line-height:1.55}.discover-runtime__mark{flex:none;color:#a67c3d;font-family:Georgia,serif;font-size:24rpx;letter-spacing:.12em}
.discover-section{padding:88rpx 32rpx}.discover-heading{display:block;margin-top:18rpx;font-family:Georgia,"Songti SC",serif;font-size:48rpx;font-weight:500;line-height:1.3}.discover-heading--light{color:#fcfbf7}.discover-lead{display:block;margin-top:24rpx;color:#64716c;font-size:27rpx;line-height:1.8}.discover-journey{margin-top:52rpx;border-top:2rpx solid #d9d2c5}.discover-journey__item{display:flex;align-items:center;min-height:132rpx;border-bottom:2rpx solid #d9d2c5}.discover-journey__index{width:70rpx;color:#a67c3d;font-family:Georgia,serif;font-size:23rpx}.discover-journey__copy{flex:1}.discover-journey__title,.discover-journey__text{display:block}.discover-journey__title{font-family:"Songti SC",serif;font-size:31rpx;font-weight:600}.discover-journey__text{margin-top:8rpx;color:#64716c;font-size:23rpx}.discover-arrow{margin-left:20rpx;color:#173c32;font-size:42rpx;font-weight:300}
.discover-section__head{display:flex;align-items:flex-end;justify-content:space-between;gap:24rpx}.discover-text-link{box-sizing:border-box;display:flex;align-items:center;flex:none;min-height:88rpx;padding:0 8rpx;border-bottom:2rpx solid #a67c3d;color:#173c32;font-size:24rpx}.discover-city-scroll{width:calc(100% + 32rpx);margin-top:44rpx}.discover-city-row{display:inline-flex;gap:20rpx;padding-right:32rpx}.discover-city-card{position:relative;display:inline-block;width:430rpx;height:292rpx;overflow:hidden;background:#173c32;color:#fcfbf7}.discover-city-card__image{width:100%;height:100%;opacity:.78}.discover-city-card__fallback{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;width:100%;height:100%;padding:24rpx;background:#25473e;color:#d8c197;font-size:21rpx;text-align:center}.discover-city-card__caption{position:absolute;right:20rpx;bottom:20rpx;left:20rpx;padding:18rpx 20rpx;background:rgba(16,40,33,.82)}.discover-city-card__name,.discover-city-card__region{display:block}.discover-city-card__name{font-family:Georgia,"Songti SC",serif;font-size:34rpx}.discover-city-card__region{margin-top:4rpx;color:#d8c197;font-size:21rpx;letter-spacing:.12em}
.discover-city-groups{margin-top:48rpx;border-top:2rpx solid #d9d2c5}.discover-city-group{display:flex;gap:24rpx;padding:24rpx 0;border-bottom:2rpx solid #d9d2c5}.discover-city-group__region{flex:none;width:112rpx;color:#a67c3d;font-size:23rpx;font-weight:700}.discover-city-group__cities{font-size:25rpx;line-height:1.6}.discover-rights{display:block;margin-top:24rpx;color:#787d79;font-size:20rpx;line-height:1.6}
.discover-events{background:#173c32}.discover-section__head--light{color:#fcfbf7}.discover-kicker--gold{color:#d8c197}.discover-demo-chip{flex:none;padding:8rpx 14rpx;border:2rpx solid rgba(216,193,151,.62);color:#d8c197;font-size:20rpx}.discover-event{box-sizing:border-box;display:flex;align-items:flex-start;gap:22rpx;min-height:112rpx;padding:34rpx 0;border-bottom:2rpx solid rgba(252,251,247,.18);color:#fcfbf7}.discover-event__index{color:#d8c197;font-family:Georgia,serif;font-size:23rpx}.discover-event__body{flex:1}.discover-event__city,.discover-event__theme,.discover-event__meta{display:block}.discover-event__city{color:#d8c197;font-size:22rpx;letter-spacing:.12em}.discover-event__theme{margin-top:10rpx;font-family:"Songti SC",serif;font-size:31rpx;line-height:1.45}.discover-event__meta{margin-top:12rpx;color:rgba(252,251,247,.58);font-size:21rpx}.discover-event__arrow{color:#d8c197;font-size:28rpx}
.discover-art{padding-right:0;padding-left:0}.discover-art__visual{position:relative;height:520rpx;margin:0 32rpx;overflow:hidden;background:#eee7da}.discover-art__image{width:100%;height:100%}.discover-art__fallback{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16rpx;width:100%;height:100%;padding:32rpx;background:#eee7da;color:#64716c;font-size:22rpx;line-height:1.6;text-align:center}.discover-art__notice{position:absolute;right:20rpx;bottom:20rpx;padding:10rpx 14rpx;background:rgba(252,251,247,.9);color:#64716c;font-size:19rpx}.discover-art__content{padding:48rpx 32rpx 0}.discover-art__list{margin-top:40rpx;border-top:2rpx solid #d9d2c5}.discover-art__item{display:flex;gap:24rpx;padding:26rpx 0;border-bottom:2rpx solid #d9d2c5}.discover-art__en{flex:none;width:150rpx;color:#a67c3d;font-family:Georgia,serif;font-size:19rpx;letter-spacing:.08em}.discover-art__name,.discover-art__description{display:block}.discover-art__name{font-family:"Songti SC",serif;font-size:29rpx}.discover-art__description{margin-top:6rpx;color:#64716c;font-size:22rpx}
.discover-primary,.discover-outline{box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;min-height:96rpx;margin-top:42rpx;padding:0 30rpx;font-size:27rpx;font-weight:600}.discover-primary{background:#173c32;color:#fcfbf7}.discover-primary--pressed,.discover-press{opacity:.76}.discover-trust{background:#102821;color:#fcfbf7}.discover-trust__text{display:block;margin-top:26rpx;color:rgba(252,251,247,.72);font-size:26rpx;line-height:1.8}.discover-trust__steps{display:flex;align-items:center;margin-top:48rpx}.discover-trust__step{display:flex;flex-direction:column;align-items:center;gap:10rpx;color:rgba(252,251,247,.78);font-size:21rpx}.discover-trust__step text:first-child{display:flex;align-items:center;justify-content:center;width:52rpx;height:52rpx;border:2rpx solid #d8c197;border-radius:50%;color:#d8c197;font-family:Georgia,serif}.discover-trust__line{flex:1;height:2rpx;margin:0 14rpx 34rpx;background:rgba(216,193,151,.42)}.discover-outline{justify-content:center;border:2rpx solid #d8c197;color:#fcfbf7}
.discover-footer{padding:64rpx 32rpx 78rpx;text-align:center}.discover-footer__brand,.discover-footer__text{display:block}.discover-footer__brand{color:#173c32;font-family:Georgia,serif;font-size:34rpx;letter-spacing:.18em}.discover-footer__text{margin-top:16rpx;color:#787d79;font-size:17rpx;letter-spacing:.1em}
@media(prefers-color-scheme:dark){.discover-page,.discover-section,.discover-art__content,.discover-footer{background:#102821;color:#fcfbf7}.discover-runtime,.discover-art__visual,.discover-art__fallback{background:#173c32}.discover-art__fallback,.discover-lead,.discover-journey__text,.discover-runtime__text,.discover-art__description,.discover-rights,.discover-footer__text{color:#c8cfc9}.discover-journey,.discover-journey__item,.discover-city-groups,.discover-city-group,.discover-art__list,.discover-art__item{border-color:#49645a}.discover-arrow,.discover-text-link,.discover-footer__brand{color:#d8c197}}
