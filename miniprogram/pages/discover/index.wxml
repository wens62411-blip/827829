<view class="discover-page ab-safe-bottom">
  <view class="discover-topbar">
    <view class="discover-brand">
      <image
        wx:if="{{!brandLogoFailed}}"
        class="discover-brandmark"
        src="/assets/brand/ab-club-crest.png"
        mode="aspectFit"
        alt="AB Club 盾徽标志"
        aria-label="AB Club 盾徽标志"
        data-image-key="brand"
        binderror="handleImageError"
      />
      <view wx:else class="discover-brandmark__fallback" aria-label="AB Club 标志加载失败，显示文字标识">AB</view>
      <view class="discover-brand__copy">
        <text class="discover-brand__name">AB Club</text>
        <text class="discover-brand__note">GLOBAL CHINESE CLUB</text>
      </view>
    </view>
    <button class="discover-global-chip" bindtap="scrollToCities" aria-label="查看全球华人城市目录，共十三座首发城市">
      <text>全球</text>
      <text>13 城⌄</text>
    </button>
  </view>

  <view class="discover-intro">
    <text class="discover-kicker">DIGITAL IDENTITY · CULTURAL CONNECTION</text>
    <text class="discover-intro__title">让一张名片，成为一场好对话的开始。</text>
    <text class="discover-intro__copy">面向全球华人的高端数字名片与艺术生活方式俱乐部。</text>
  </view>

  <view class="discover-card-entry" aria-role="region" aria-label="数字名片入口">
    <view class="discover-card-entry__index" aria-hidden="true">01</view>
    <view class="discover-card-entry__content">
      <text class="discover-kicker">DIGITAL IDENTITY</text>
      <text class="discover-card-entry__title">你的名字，值得被更好地介绍。</text>
      <text class="discover-card-entry__copy">以克制的版式整理身份、经历与兴趣；创建、查看和分享名片统一在「我的」中管理。</text>
    </view>
  </view>

  <view class="discover-runtime" aria-role="status">
    <text class="discover-runtime__label">本地展示版本</text>
    <text class="discover-runtime__text">页面人物与活动均为合成示意，不代表真实排期、活动已开放或可以报名。</text>
  </view>

  <view class="discover-section discover-people" aria-role="region" aria-label="值得认识的成员示意">
    <view class="discover-section__head">
      <view>
        <text class="discover-kicker">SELECTED INTRODUCTIONS</text>
        <text class="discover-heading">值得认识</text>
      </view>
      <text class="discover-demo-chip">SYNTHETIC</text>
    </view>
    <text class="discover-lead">不是公开社交广场，只因明确的城市、专业或兴趣共同点而出现。</text>
    <view class="discover-people__list">
      <view wx:for="{{memberEditorials}}" wx:key="displayName" class="discover-person">
        <view class="discover-person__avatar" aria-label="{{item.displayName}}的文字头像">{{item.initials}}</view>
        <view class="discover-person__copy">
          <view class="discover-person__topline">
            <text class="discover-person__name">{{item.displayName}}</text>
            <text class="discover-person__city">{{item.cityLine}}</text>
          </view>
          <text class="discover-person__headline">{{item.headline}}</text>
          <text class="discover-person__reason">{{item.commonGround}}</text>
        </view>
      </view>
    </view>
    <navigator class="discover-text-link discover-text-link--quiet" url="/pages/network/index" hover-class="discover-press">查看成员连接 <text>›</text></navigator>
  </view>

  <view class="discover-section discover-gathering" aria-role="region" aria-label="全球城市艺术活动预览">
    <view class="discover-section__head">
      <view>
        <text class="discover-kicker">CURATED GATHERING</text>
        <text class="discover-heading">全球城市艺术活动</text>
      </view>
      <text class="discover-demo-chip">DEMO_ONLY</text>
    </view>
    <text class="discover-lead">首页只保留一条策展预览，完整活动能力将在后续阶段逐步落地。</text>

    <navigator class="discover-event-feature" url="/packageEvents/pages/event/index?demoEventId={{primaryEvent.eventId}}" hover-class="discover-press">
      <view class="discover-event-feature__media">
        <image
          wx:if="{{!eventImageFailed}}"
          class="discover-event-feature__image"
          src="{{primaryEvent.coverSrc}}"
          mode="aspectFill"
          alt="{{primaryEvent.coverAlt}}"
          data-image-key="event"
          binderror="handleImageError"
        />
        <view wx:else class="discover-event-feature__fallback" aria-role="img" aria-label="{{primaryEvent.coverAlt}}">
          <text>AB CLUB · EVENT PREVIEW</text>
          <text>本地活动视觉暂不可用 · 不使用外链替代</text>
        </view>
        <text class="discover-event-feature__notice">策展视觉参考</text>
      </view>
      <view class="discover-event-feature__body">
        <text class="discover-event-feature__city">{{primaryEvent.cityName}} · {{primaryEvent.cardMeta}}</text>
        <text class="discover-event-feature__title">{{primaryEvent.title}}</text>
        <text class="discover-event-feature__summary">{{primaryEvent.summary}}</text>
        <text class="discover-event-feature__credit">{{primaryEvent.coverCredit}}</text>
        <text class="discover-event-feature__boundary">DEMO_ONLY · 不代表真实排期、活动已开放或可以报名</text>
      </view>
    </navigator>
    <navigator class="discover-text-link" open-type="switchTab" url="/pages/events/index" hover-class="discover-press">浏览城市活动入口 <text>›</text></navigator>
  </view>

  <view class="discover-section discover-art" aria-role="region" aria-label="艺术、古董与珠宝轻量入口">
    <view class="discover-section__head">
      <view>
        <text class="discover-kicker">ART &amp; OBJECTS</text>
        <text class="discover-heading">艺术、古董与珠宝</text>
      </view>
      <text class="discover-section__aside">轻量入口</text>
    </view>
    <text class="discover-lead">作为数字名片之外的审美与专业兴趣入口，不在一期承担交易或商家入驻。</text>
    <view class="discover-art__grid">
      <view wx:for="{{artVerticals}}" wx:key="en" class="discover-art__item">
        <text class="discover-art__name">{{item.name}}</text>
        <text class="discover-art__en">{{item.en}}</text>
        <text class="discover-art__description">{{item.description}}</text>
      </view>
    </view>
    <navigator class="discover-text-link" url="/packageArt/pages/channel/index" hover-class="discover-press">进入艺术频道 <text>›</text></navigator>
  </view>

  <view id="global-city-directory" class="discover-section discover-cities" aria-role="region" aria-label="全球华人城市目录">
    <view class="discover-section__head">
      <view>
        <text class="discover-kicker">GLOBAL DIRECTORY</text>
        <text class="discover-heading">全球华人坐标</text>
      </view>
      <text class="discover-section__aside">7国13城 · 逐步开放</text>
    </view>
    <text class="discover-lead">城市用于表达常驻与跨城联系；列入目录不等于当地节点已经运营。</text>
    <view class="discover-city-media">
      <image
        wx:if="{{!cityImageFailed}}"
        class="discover-city-media__image"
        src="{{cityFeature.imageSrc}}"
        mode="aspectFill"
        alt="{{cityFeature.alt}}"
        data-image-key="city"
        binderror="handleImageError"
      />
      <view wx:else class="discover-city-media__fallback" aria-role="img" aria-label="{{cityFeature.alt}}">本地城市视觉暂不可用</view>
      <view class="discover-city-media__shade"></view>
      <text class="discover-city-media__label">ZÜRICH · CITY DIRECTORY PREVIEW</text>
    </view>
    <view class="discover-city-groups">
      <view wx:for="{{cityGroups}}" wx:key="region" class="discover-city-group">
        <text class="discover-city-group__region">{{item.region}}</text>
        <text class="discover-city-group__cities">{{item.cities}}</text>
      </view>
    </view>
    <text class="discover-rights">城市图片使用本地高清资源；正式发布前仍需完成人工版权复核，也不代表城市节点已运营。</text>
  </view>

  <view class="discover-footer">
    <text class="discover-footer__brand">AB CLUB</text>
    <text class="discover-footer__text">GLOBAL CHINESE BUSINESS CARD · CITY CULTURE</text>
  </view>
</view>
