<view class="discover-page ab-safe-bottom">
  <view class="discover-topbar">
    <view class="discover-brand">
      <image
        wx:if="{{!brandLogoFailed}}"
        class="discover-brandmark"
        src="/assets/brand/ab-club-crest.png"
        mode="aspectFit"
        alt="AB Club 盾徽标志"
        aria-label="AB Club 盾徽标志"
        data-image-key="brand"
        binderror="handleImageError"
      />
      <view wx:else class="discover-brandmark__fallback" aria-label="AB Club 标志加载失败，显示文字标识">AB</view>
      <view class="discover-brand__copy">
        <text class="discover-brand__name">AB Club</text>
        <text class="discover-brand__note">GLOBAL CHINESE CLUB</text>
      </view>
    </view>
    <button class="discover-global-chip" bindtap="scrollToCities" aria-label="查看全球华人城市目录，共十三座首发城市">
      <text>全球</text>
      <text>13 城⌄</text>
    </button>
  </view>

  <view class="discover-hero" aria-role="region" aria-label="AB Club AI 赛博名片入口">
    <text class="discover-hero__eyebrow">AB CLUB · AI CYBER CARD</text>
    <text class="discover-hero__title">先让对方记住你。</text>
    <text class="discover-hero__copy">AI 赛博名片 · 把身份，做成一件值得被收藏的数字作品</text>
    <button class="discover-primary-action" bindtap="openMyCard" loading="{{openingCard}}" disabled="{{openingCard}}" hover-class="discover-press" aria-label="生成我的 AI 赛博名片">
      <text>生成我的 AI 赛博名片</text>
      <text class="discover-primary-action__arrow" aria-hidden="true">→</text>
    </button>
    <view class="discover-hero__rule" aria-hidden="true"></view>
    <text
      class="discover-runtime__label discover-runtime__label--hero"
      aria-label="体验版内容，仅供本地预览"
    >体验版</text>
  </view>

  <view class="discover-section discover-gathering" aria-role="region" aria-label="全球城市艺术活动预览">
    <view class="discover-section__head">
      <view><text class="discover-section__eyebrow">CURATED GATHERING</text><text class="discover-heading">一场值得赴约的相遇</text></view>
      <text class="discover-section__status" aria-label="体验版">体验版</text>
    </view>
    <navigator class="discover-event-feature" url="/packageEvents/pages/event/index?demoEventId={{primaryEvent.eventId}}" hover-class="discover-press">
      <view class="discover-event-feature__media">
        <image
          wx:if="{{!eventImageFailed}}"
          class="discover-event-feature__image"
          src="{{primaryEvent.coverSrc}}"
          mode="aspectFill"
          alt="{{primaryEvent.coverAlt}}"
          data-image-key="event"
          binderror="handleImageError"
        />
        <view wx:else class="discover-event-feature__fallback" aria-role="img" aria-label="{{primaryEvent.coverAlt}}">
          <text>AB CLUB · EVENT PREVIEW</text>
          <text>本地活动视觉暂不可用 · 不使用外链替代</text>
        </view>
        <text class="discover-event-feature__notice">{{primaryEvent.cityName}} · {{primaryEvent.cardMeta}}</text>
      </view>
      <view class="discover-event-feature__body">
        <text class="discover-event-feature__title">{{primaryEvent.title}}</text>
        <text class="discover-event-feature__summary">{{primaryEvent.summary}}</text>
        <text
          class="discover-event-feature__boundary"
          aria-label="体验版活动，仅供预览"
        >体验版活动 · 仅供预览</text>
      </view>
    </navigator>
    <navigator class="discover-text-link" open-type="switchTab" url="/pages/events/index" hover-class="discover-press">浏览全部城市活动 <text>→</text></navigator>
  </view>

  <view id="global-city-directory" class="discover-section discover-cities" aria-role="region" aria-label="全球华人城市目录，7国13城 · 逐步开放">
    <view class="discover-section__head">
      <view><text class="discover-section__eyebrow">GLOBAL DIRECTORY</text><text class="discover-heading">全球城市坐标</text></view>
      <text class="discover-section__aside">7国13城 · 逐步开放</text>
    </view>
    <view class="discover-city-media">
      <image
        wx:if="{{!cityImageFailed}}"
        class="discover-city-media__image"
        src="{{cityFeature.imageSrc}}"
        mode="aspectFill"
        alt="{{cityFeature.alt}}"
        data-image-key="city"
        binderror="handleImageError"
      />
      <view wx:else class="discover-city-media__fallback" aria-role="img" aria-label="{{cityFeature.alt}}">本地城市视觉暂不可用</view>
      <view class="discover-city-media__shade"></view>
      <text class="discover-city-media__label">ZÜRICH · CITY DIRECTORY PREVIEW</text>
    </view>
    <view class="discover-city-groups">
      <view wx:for="{{cityGroups}}" wx:key="region" class="discover-city-group">
        <text class="discover-city-group__region">{{item.region}}</text>
        <text class="discover-city-group__cities">{{item.cities}}</text>
      </view>
    </view>
    <text class="discover-rights">城市图片使用本地高清资源；正式发布前仍需完成人工版权复核。</text>
  </view>

  <view class="discover-footer" aria-hidden="true"><text>AB CLUB · GLOBAL CHINESE BUSINESS CARD</text></view>
</view>
