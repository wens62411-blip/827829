.events-page {
  --canvas: #24211e;
  --paper: #2d2925;
  --ink: #f7f2e9;
  --muted: #b8afa2;
  --line: rgba(224, 207, 177, .28);
  --gold: #d8bd84;
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: var(--canvas);
  color: var(--ink);
}

.events-page button,
.events-page view,
.events-page text,
.events-page image { box-sizing: border-box; min-width: 0; }
.events-brand__name,
.events-brand__note,
.events-kicker,
.events-hero__title,
.events-hero__copy,
.events-portals__eyebrow,
.events-portals__title,
.events-footer text,
.portal-entry__en,
.portal-entry__zh,
.portal-entry__summary,
.portal-entry__action { display: block; overflow-wrap: anywhere; word-break: break-word; }

.events-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 132rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
  background: rgba(36, 33, 30, .96);
}
.events-brand { display: flex; align-items: center; gap: 14rpx; min-width: 0; }
.events-brand__crest,
.events-brand__fallback { width: 66rpx; height: 66rpx; flex: 0 0 66rpx; }
.events-brand__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--gold);
  border-radius: 50%;
  color: var(--gold);
  font: 23rpx Georgia, "Songti SC", "STSong", SimSun, serif;
  letter-spacing: .08em;
}
.events-brand__name { color: var(--ink); font: 500 28rpx Georgia, "Songti SC", "STSong", SimSun, serif; letter-spacing: .08em; }
.events-brand__note { margin-top: 4rpx; color: var(--muted); font-size: 16rpx; letter-spacing: .12em; }
.events-topbar__serial { flex: 0 0 auto; color: var(--gold); font: 18rpx Georgia, serif; letter-spacing: .12em; }

.events-hero,
.events-portals,
.events-footer { width: 100%; max-width: 980rpx; margin-right: auto; margin-left: auto; padding-right: 32rpx; padding-left: 32rpx; }
.events-hero { padding-top: 54rpx; padding-bottom: 48rpx; border-bottom: 1rpx solid var(--line); }
.events-kicker,
.events-portals__eyebrow { color: var(--gold); font-size: 18rpx; font-weight: 700; letter-spacing: .16em; }
.events-hero__title {
  max-width: 720rpx;
  margin-top: 22rpx;
  color: var(--ink);
  font: 500 53rpx/1.32 Georgia, "Songti SC", "STSong", SimSun, serif;
}
.events-hero__copy { max-width: 700rpx; margin-top: 24rpx; color: var(--muted); font-size: 24rpx; line-height: 1.8; }

.events-portals { padding-top: 0; }
.events-portals__heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid var(--line); }
.events-portals__title { margin-top: 10rpx; color: var(--ink); font: 500 36rpx/1.25 Georgia, "Songti SC", "STSong", SimSun, serif; }
.events-portals__count { flex: 0 0 auto; color: var(--muted); font: 18rpx Georgia, serif; letter-spacing: .1em; }

.portal-list { display: flex; flex-direction: column; }
.portal-entry {
  position: relative;
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr);
  gap: 24rpx;
  width: 100%;
  min-height: 180rpx;
  margin: 0;
  padding: 34rpx 0 38rpx;
  border: 0;
  border-bottom: 1rpx solid var(--line);
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  text-align: left;
  transition: background-color 180ms ease, padding-left 180ms ease;
}
.portal-entry::after { border: 0; }
.portal-list .portal-entry { width: 100%; margin: 0; font-weight: 400; }
.portal-entry--pressed { padding-left: 12rpx; background: rgba(216, 189, 132, .08); }
.portal-entry__index { padding-top: 4rpx; color: var(--gold); font: 22rpx Georgia, serif; letter-spacing: .08em; }
.portal-entry__en { color: var(--gold); font: 18rpx Georgia, serif; letter-spacing: .13em; line-height: 1.35; }
.portal-entry__zh { margin-top: 10rpx; color: var(--ink); font: 500 38rpx/1.2 Georgia, "Songti SC", "STSong", SimSun, serif; }
.portal-entry__summary { max-width: 590rpx; margin-top: 16rpx; color: var(--muted); font-size: 28rpx; line-height: 1.65; }
.portal-entry__action { margin-top: 22rpx; color: var(--gold); font: 17rpx Georgia, serif; letter-spacing: .1em; }
.portal-entry__arrow { display: inline; margin-left: 8rpx; font-size: 24rpx; }

.events-footer { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 68rpx; padding-top: 22rpx; padding-bottom: 42rpx; border-top: 1rpx solid var(--line); color: var(--muted); font: 16rpx Georgia, serif; letter-spacing: .1em; }
.events-footer text:last-child { text-align: right; }

@media (min-width: 760px) {
  .events-topbar { max-width: 1080rpx; margin: 0 auto; padding-right: 48rpx; padding-left: 48rpx; }
  .events-hero, .events-portals, .events-footer { padding-right: 48rpx; padding-left: 48rpx; }
}
@media (max-width: 380px) {
  .events-topbar, .events-hero, .events-portals, .events-footer { padding-right: 24rpx; padding-left: 24rpx; }
  .events-hero__title { font-size: 46rpx; }
  .portal-entry { grid-template-columns: 58rpx minmax(0, 1fr); gap: 16rpx; }
  .portal-entry__zh { font-size: 34rpx; }
  .events-footer { align-items: flex-start; flex-direction: column; }
  .events-footer text:last-child { text-align: left; }
}
@media (prefers-color-scheme: light) {
  .events-page { --canvas: #f4efe5; --paper: #fffdf8; --ink: #211e1a; --muted: #625d55; --line: #d8d0c3; --gold: #8a6538; }
  .events-topbar { background: rgba(244, 239, 229, .96); }
}
@media (prefers-reduced-motion: reduce) {
  .portal-entry { transition: none; }
}
