.events-page{box-sizing:border-box;width:100%;min-height:100vh;margin:0 auto;padding:52rpx 32rpx 72rpx;overflow:hidden;background:#f4efe5}.events-header{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:28rpx;margin:0 2rpx 34rpx;padding:0 0 30rpx;border-bottom:1rpx solid #b9aa91}.events-header::after{position:absolute;right:0;bottom:-2rpx;width:78rpx;height:3rpx;background:#7b3038;content:""}.events-header__copy{min-width:0}.events-header__eyebrow,.events-header__title,.events-header__subtitle,.scope__label,.scope__value,.section-heading__eyebrow,.section-heading__title,.filter__label,.filter__value,.filters__contract-note,.events-policy text{display:block}.events-header__eyebrow,.section-heading__eyebrow{color:#8a6538;font-size:20rpx;font-weight:700;letter-spacing:.18em}.events-header__title{margin-top:8rpx;color:#15372e;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-size:66rpx;font-weight:500;letter-spacing:.025em;line-height:1.08}.events-header__subtitle,.filter__label,.filters__contract-note,.event-results__count,.events-loading,.events-policy{color:#64716c}.events-header__subtitle{max-width:540rpx;margin-top:14rpx;font-size:23rpx;line-height:1.65}.scope{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin-top:18rpx;padding:22rpx 0;border-top:1rpx solid #cabda9;border-bottom:1rpx solid #cabda9}.scope__label,.filter__label{font-size:19rpx;font-weight:650;letter-spacing:.1em}.scope__value,.filter__value{color:#173c32;font-size:27rpx;font-weight:600}.scope__value{margin-top:2rpx;font-family:Georgia,"Songti SC",SimSun,serif}.scope__action,.demo-detail{box-sizing:border-box;min-height:88rpx;margin:0;border:1rpx solid #9a8b73;border-radius:2rpx;background:transparent;color:#173c32;font-size:23rpx;letter-spacing:.04em;transition:color 160ms ease,background 160ms ease,border-color 160ms ease}.scope__action{min-height:72rpx;padding:0 26rpx;border-color:#173c32}.scope__action::after,.demo-detail::