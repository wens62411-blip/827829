<view class="events-page ab-safe-bottom">
  <view class="events-topbar">
    <view class="events-brand">
      <image
        wx:if="{{!brandLogoFailed}}"
        class="events-brand__crest"
        src="/assets/brand/ab-club-crest.png"
        mode="aspectFit"
        alt="AB Club 盾徽"
        aria-label="AB Club 盾徽"
        binderror="onBrandLogoError"
      />
      <view wx:else class="events-brand__fallback" aria-label="AB Club 文字标识">AB</view>
      <view class="events-brand__copy">
        <text class="events-brand__name">AB Club</text>
        <text class="events-brand__note">GLOBAL CHINESE CLUB</text>
      </view>
    </view>
  </view>

  <view class="events-hero" aria-role="region" aria-label="AB Club 全球文化与生活方式入口">
    <text class="events-kicker">CULTURE · LIVING</text>
    <text class="events-hero__title">艺术与生活之间</text>
    <text class="events-hero__copy">看见世界，也珍惜身边的美好。</text>
  </view>

  <view class="events-portals" aria-role="region" aria-label="AB Club 三个核心入口">
    <view class="portal-list">
      <button
        wx:for="{{portals}}"
        wx:key="id"
        class="portal-entry portal-entry--{{item.id}}"
        data-portal-id="{{item.id}}"
        bindtap="openPortal"
        hover-class="portal-entry--pressed"
        aria-label="{{item.titleEn}} {{item.titleZh}}"
      >
        <view class="portal-entry__index" aria-hidden="true">{{item.index}}</view>
        <view class="portal-entry__body">
          <text class="portal-entry__en">{{item.titleEn}}</text>
          <text class="portal-entry__zh">{{item.titleZh}}</text>
          <text class="portal-entry__summary">{{item.summary}}</text>
          <text class="portal-entry__action">{{item.actionLabel}} <text class="portal-entry__arrow" aria-hidden="true">↗</text></text>
        </view>
      </button>
    </view>
  </view>

  <view class="events-footer" aria-hidden="true">
    <text>AB CLUB / GLOBAL CHINESE CLUB</text>
    <text>CULTURE · LIFE · BRAND</text>
  </view>
</view>
