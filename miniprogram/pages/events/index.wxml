<view class="events-page ab-safe-bottom"><view class="events-header events-reveal"><view class="events-header__copy"><text class="events-header__eyebrow">AB CLUB · GLOBAL CITIES</text><text class="events-header__title">同城活动</text><text class="events-header__subtitle">7 国 13 城稳定目录 · 运营与活动供给独立核验</text></view><ab-evidence-label mode="{{runtimeMode}}" /></view><view class="events-reveal events-reveal--switcher"><ab-city-switcher cities="{{cities}}" selected-city-id="{{selectedCityId}}" selected-city-label="{{selectedCityLabel}}" selected-city-meta="{{selectedCityMeta}}" bind:change="onCityChange" /></view><view class="events-reveal events-reveal--hero"><ab-city-hero city-name="{{hero.label}}" city-name-en="{{hero.nameEn}}" timezone="{{hero.timezone}}" catalog-label="{{hero.catalogLabel}}" operational-label="{{hero.operationalLabel}}" operation-evidence="{{hero.operationEvidence}}" image-src="{{hero.imageSrc}}" image-alt="{{hero.imageAlt}}" photo-credit="{{hero.photoCredit}}" media-rights-label="{{hero.mediaRightsLabel}}" /></view><view class="scope events-reveal events-reveal--scope" aria-role="group" aria-label="活动浏览范围"><view><text class="scope__label">浏览范围</text><text class="scope__value">{{browseScopeLabel}}</text></view><button class="scope__action" bindtap="toggleBrowseScope" hover-class="scope__action--pressed">{{browseGlobal ? '只看当前城市' : '跨城浏览'}}</button></view><view class="filters events-reveal events-reveal--filters" aria-role="region" aria-label="活动筛选"><view class="section-heading"><text class="section-heading__eyebrow">THE EDIT</text><text class="section-heading__title">筛选活动</text></view><view class="filters__grid"><picker mode="selector" range="{{typeFilters}}" range-key="label" value="{{typeFilterIndex}}" disabled="{{!extendedFiltersAvailable}}" aria-label="类型筛选，合同 1.0.0 暂不支持"><view class="filter__control filter__control--disabled"><text class="filter__label">类型</text><text class="filter__value">{{typeFilters[typeFilterIndex].label}}</text></view></picker><picker mode="selector" range="{{timeFilters}}" range-key="label" value="{{timeFilterIndex}}" bindchange="onTimeFilterChange" aria-label="时间筛选"><view class="filter__control"><text class="filter__label">时间</text><text class="filter__value">{{timeFilters[timeFilterIndex].label}}</text></view></picker><picker mode="selector" range="{{priceFilters}}" range-key="label" value="{{priceFilterIndex}}" disabled="{{!extendedFiltersAvailable}}" aria-label="价格筛选，合同 1.0.0 暂不支持"><view class="filter__control filter__control--disabled"><text class="filter__label">价格</text><text class="filter__value">{{priceFilters[priceFilterIndex].label}}</text></view></picker><picker mode="selector" range="{{accessFilters}}" range-key="label" value="{{accessFilterIndex}}" disabled="{{!extendedFiltersAvailable}}" aria-label="准入筛选，合同 1.0.0 暂不支持"><view class="filter__control filter__control--disabled"><text class="filter__label">准入</text><text class="filter__value">{{accessFilters[accessFilterIndex].label}}</text></view></picker></view><text class="filters__contract-note">{{filterContractNote}}</text></view><view class="event-results events-reveal events-reveal--results"><view class="section-heading section-heading--results"><view><text class="section-heading__eyebrow">CURATED EVENTS</text><text class="section-heading__title">可公开活动</text></view><text class="event-results__count">{{events.length}} 场</text></view><view wx:if="{{loading}}" class="events-loading" aria-role="status">正在读取正式活动目录…</view><view wx:elif="{{events.length}}" class="event-list"><ab-event-card wx:for="{{events}}" wx:key="eventId" event-id="{{item.eventId}}" title="{{item.title}}" summary="{{item.summary}}" city-name="{{item.cityName}}" time-label="{{item.timeLabel}}" timezone="{{item.timezone}}" state-label="{{item.stateLabel}}" registration-label="{{item.registrationLabel}}" origin="{{item.origin}}" verification-state="{{item.verificationState}}" cover-src="{{item.coverSrc}}" cover-alt="{{item.coverAlt}}" detail-available="{{item.detailAvailable}}" bind:open="openEvent" /></view><ab-event-state wx:else kind="{{stateKind}}" title="{{stateTitle}}" description="{{stateDescription}}" detail="{{stateDetail}}" action-label="浏览全球城市目录" bind:action="openCityDirectory" /></view><button class="demo-detail" bindtap="openDemoDetail" hover-class="demo-detail--pressed"> 查看 DEMO_ONLY 活动详情字段结构 </button><view class="events-policy" aria-role="note"><text class="events-policy__title">发布与支付边界</text><text>只有人工批准的主理人和通过公开门的活动才可出现。普通用户无法通过前端字段自称 organizer。</text><text>{{paymentGateLabel}}</text></view></view>