:host{display:block}.page-state{padding:96rpx 0 80rpx;text-align:left}.page-state__rule{width:72rpx;height:4rpx;margin-bottom:28rpx;background:var(--ab-color-gold)}.page-state__eyebrow,.page-state__title,.page-state__description,.page-state__network{display:block;overflow-wrap:anywhere;word-break:break-word}.page-state__eyebrow{color:var(--ab-color-muted);font-size:22rpx;font-weight:700;letter-spacing:.12em}.page-state__title{margin-top:20rpx;color:var(--ab-color-green);font-family:Georgia,Songti SC,STSong,serif;font-size:42rpx;font-weight:600;line-height:1.3}.page-state__description,.page-state__network{max-width:620rpx;margin-top:20rpx;color:var(--ab-color-muted);font-size:27rpx;line-height:1.65}.page-state__network{border-left:4rpx solid var(--ab-color-gold);padding-left:18rpx}.page-state__retry{display:inline-flex;align-items:center;justify-content:center;min-height:var(--ab-touch-target);margin:32rpx 0 0;padding:0 32rpx;border:2rpx solid var(--ab-color-green);border-radius:var(--ab-radius-small);background:transparent;color:var(--ab-color-green);font-size:28rpx}.page-state__retry:after{border:0}.page-state__retry--pressed{opacity:.64}@media(prefers-color-scheme:dark){.page-state__rule{background:var(--ab-color-gold-soft)}.page-state__eyebrow,.page-state__description,.page-state__network{color:var(--ab-color-dark-muted)}.page-state__title,.page-state__retry{color:var(--ab-color-dark-text)}.page-state__retry{border-color:var(--ab-color-gold-soft)}}
