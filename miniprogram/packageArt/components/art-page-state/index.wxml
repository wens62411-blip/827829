<view class="page-state" aria-role="status" aria-label="{{title}}"><view class="page-state__rule"></view><text class="page-state__title">{{title}}</text><text class="page-state__description">{{description}}</text><text wx:if="{{kind === 'LOADING' && weakNetwork}}" class="page-state__network">网络较慢，请稍候。</text><button
    wx:if="{{retryable}}"
    class="page-state__retry ab-motion"
    hover-class="page-state__retry--pressed"
    bindtap="handleRetry"
  >重新读取</button></view>
