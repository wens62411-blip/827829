.art-intent{min-height:100vh;padding:56rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));background:var(--ab-color-ivory);color:var(--ab-color-ink)}.art-intent__inner{width:100%;max-width:680px;margin:0 auto}.art-intent__topline,.art-intent__context-topline,.art-intent__section-heading{display:flex;align-items:center}.art-intent__topline,.art-intent__context-topline{justify-content:space-between;gap:24rpx}.art-intent__eyebrow,.art-intent__title,.art-intent__subtitle,.art-intent__content-title,.art-intent__section-title,.art-intent__purpose-title,.art-intent__purpose-copy,.art-intent__counter,.art-intent__feedback,.art-intent__boundary-title,.art-intent__boundary text{display:block;overflow-wrap:anywhere;word-break:break-word}.art-intent__eyebrow{color:var(--ab-color-muted);font-size:22rpx;font-weight:700;letter-spacing:.12em}.art-intent__header{padding:64rpx 0 48rpx}.art-intent__title{color:var(--ab-color-green);font-family:Georgia,Songti SC,STSong,serif;font-size:58rpx;font-weight:500;line-height:1.2}.art-intent__subtitle{max-width:600rpx;margin-top:22rpx;color:var(--ab-color-muted);font-size:28rpx;line-height:1.65}.art-intent__context{padding:32rpx 0;border-top:2rpx solid var(--ab-color-border);border-bottom:2rpx solid var(--ab-color-border)}.art-intent__context-topline{color:var(--ab-color-muted);font-size:20rpx;letter-spacing:.06em}.art-intent__content-title{margin-top:18rpx;color:var(--ab-color-ink);font-family:Georgia,Songti SC,STSong,serif;font-size:34rpx;font-weight:600;line-height:1.4}.art-intent__section{padding-top:64rpx}.art-intent__section-heading{align-items:baseline;gap:20rpx;padding-bottom:24rpx}.art-intent__section-index{color:var(--ab-color-muted);font-family:Georgia,serif;font-size:22rpx}.art-intent__section-title{color:var(--ab-color-green);font-size:25rpx;font-weight:700;letter-spacing:.05em}.art-intent__purpose-list{display:grid;grid-template-columns:1fr;border-bottom:2rpx solid var(--ab-color-border)}.art-intent__purpose{position:relative;display:block;width:100%;min-height:126rpx;margin:0;padding:28rpx 36rpx 28rpx 0;border:0;border-top:2rpx solid var(--ab-color-border);border-radius:0;background:transparent;color:var(--ab-color-ink);text-align:left}.art-intent__purpose:after{border:0}.art-intent__purpose--active:before{position:absolute;top:28rpx;right:0;width:12rpx;height:12rpx;border-radius:50%;background:var(--ab-color-gold);content:""}.art-intent__purpose-title{font-size:29rpx;font-weight:600;line-height:1.4}.art-intent__purpose-copy{margin-top:10rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.55}.art-intent__textarea{box-sizing:border-box;width:100%;min-height:240rpx;padding:28rpx;border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-small);background:var(--ab-color-paper);color:var(--ab-color-ink);font-size:28rpx;line-height:1.65}.art-intent__counter{margin-top:10rpx;color:var(--ab-color-muted);font-size:22rpx;text-align:right}.art-intent__action{margin-top:64rpx;padding:36rpx 32rpx;border-top:2rpx solid var(--ab-color-gold);background:var(--ab-color-paper)}.art-intent__feedback{margin-bottom:12rpx;border-left:4rpx solid var(--ab-color-border);padding-left:16rpx;color:var(--ab-color-muted);font-size:25rpx;line-height:1.6}.art-intent__feedback--success{border-left-color:var(--ab-color-green);color:var(--ab-color-green)}.art-intent__feedback--error{border-left-color:#9b493f;color:#7d342c}.art-intent__boundary{margin-top:64rpx;padding-top:28rpx;border-top:2rpx solid var(--ab-color-border);color:var(--ab-color-muted);font-size:24rpx;line-height:1.65}.art-intent__boundary-title{margin-bottom:10rpx;color:var(--ab-color-ink);font-weight:700}@media(min-width:700px){.art-intent__purpose-list{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:40rpx}}@media(prefers-color-scheme:dark){.art-intent{background:var(--ab-color-dark-canvas);color:var(--ab-color-dark-text)}.art-intent__eyebrow,.art-intent__subtitle,.art-intent__context-topline,.art-intent__section-index,.art-intent__purpose-copy,.art-intent__counter,.art-intent__feedback,.art-intent__boundary{color:var(--ab-color-dark-muted)}.art-intent__title,.art-intent__content-title,.art-intent__section-title,.art-intent__purpose,.art-intent__boundary-title{color:var(--ab-color-dark-text)}.art-intent__context,.art-intent__purpose-list,.art-intent__purpose,.art-intent__textarea,.art-intent__boundary{border-color:var(--ab-color-dark-border)}.art-intent__textarea,.art-intent__action{background:var(--ab-color-dark-surface);color:var(--ab-color-dark-text)}.art-intent__action{border-top-color:var(--ab-color-gold-soft)}.art-intent__purpose--active:before{background:var(--ab-color-gold-soft)}.art-intent__feedback--success{border-left-color:#7ac9a5;color:#7ac9a5}.art-intent__feedback--error{border-left-color:#e5a39b;color:#e5a39b}}
