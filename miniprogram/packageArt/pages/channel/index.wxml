<view class="art-channel"><view class="art-channel__inner"><view class="art-channel__header"><view class="art-channel__topline"><text class="art-channel__eyebrow">AB ART · EDITORIAL</text><ab-evidence-label mode="{{runtimeMode}}" /></view><text class="art-channel__title">艺术、古董与珠宝</text><text class="art-channel__subtitle">Art, Antiques &amp; Jewellery</text><text class="art-channel__intro">围绕人物 × 作品 × 城市活动组织资料，并从详情进入线下品鉴或合作意向。</text><text class="art-channel__scope">本频道不提供交易、竞拍、库存承诺、收益预测或 AI 真伪鉴定。</text></view><scroll-view class="art-channel__tabs" scroll-x enable-flex show-scrollbar="{{false}}" aria-label="内容分类"><view class="art-channel__tabs-inner"><button
          wx:for="{{categoryTabs}}"
          wx:key="value"
          class="art-channel__tab {{selectedCategory === item.value ? 'art-channel__tab--active' : ''}}"
          data-category="{{item.value}}"
          aria-label="{{item.label}} {{item.en}}"
          aria-current="{{selectedCategory === item.value ? 'page' : 'false'}}"
          bindtap="handleCategoryTap"
        ><text>{{item.label}}</text><text class="art-channel__tab-en">{{item.en}}</text></button></view></scroll-view><art-page-state
      wx:if="{{state === 'LOADING' || state === 'EMPTY' || state === 'ERROR'}}"
      kind="{{state}}"
      title="{{stateTitle}}"
      description="{{stateDescription}}"
      weak-network="{{weakNetwork}}"
      retryable="{{retryable}}"
      bindretry="handleRetry"
    /><block wx:if="{{state === 'READY'}}"><view wx:if="{{collections.length}}" class="art-channel__collections" aria-label="策展选集"><view class="art-channel__section-heading"><text class="art-channel__section-index">01</text><text class="art-channel__section-title">策展选集 / Collections</text></view><view class="art-channel__collection-list"><view wx:for="{{collections}}" wx:key="collectionId" class="art-channel__collection"><view class="art-channel__collection-topline"><text>{{item.categoryLabel}}</text><text wx:if="{{item.evidenceScope === 'DEMO_ONLY'}}">DEMO_ONLY</text></view><text class="art-channel__collection-title">{{item.titleZh}}</text><text class="art-channel__collection-en">{{item.titleEn}}</text><text class="art-channel__collection-summary">{{item.summary}}</text></view></view></view><text wx:if="{{collectionNotice}}" class="art-channel__inline-note">{{collectionNotice}}</text><view class="art-channel__listing" aria-label="公开内容列表"><view class="art-channel__section-heading"><text class="art-channel__section-index">02</text><text class="art-channel__section-title">公开内容 / Published Records</text></view><ab-art-card
          wx:for="{{cards}}"
          wx:key="contentId"
          content-id="{{item.contentId}}"
          title="{{item.title}}"
          summary="{{item.summary}}"
          category-label="{{item.categoryLabel}}"
          creator-name="{{item.creatorName}}"
          city-name="{{item.cityName}}"
          record-origin="{{item.recordOrigin}}"
          evidence-scope="{{item.evidenceScope}}"
          image-url="{{item.imageUrl}}"
          alt="{{item.alt}}"
          image-allowed="{{item.imageAllowed}}"
          bindselect="handleCardSelect"
        /></view><view wx:if="{{loadingMore || paginationError}}" class="art-channel__pagination" aria-live="polite"><text wx:if="{{loadingMore}}">正在读取更多公开内容…</text><text wx:if="{{paginationError}}">{{paginationError}}</text><button wx:if="{{paginationError}}" bindtap="loadMore">重试本页</button></view></block><view class="art-channel__footer"><text>内容来源、公开状态与图片权利分别展示；任何报告引用均不等于平台鉴定。</text></view></view></view>
