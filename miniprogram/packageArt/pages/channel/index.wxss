.art-channel{min-height:100vh;padding:56rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));background:var(--ab-color-ivory);color:var(--ab-color-ink)}.art-channel__inner{width:100%;max-width:680px;margin:0 auto}.art-channel__header{display:block;padding:20rpx 0 56rpx}.art-channel__topline,.art-channel__section-heading,.art-channel__collection-topline{display:flex;align-items:center}.art-channel__topline{justify-content:space-between;gap:24rpx}.art-channel__eyebrow,.art-channel__title,.art-channel__subtitle,.art-channel__intro,.art-channel__scope,.art-channel__section-title,.art-channel__collection-title,.art-channel__collection-en,.art-channel__collection-summary,.art-channel__inline-note,.art-channel__footer text{display:block;overflow-wrap:anywhere;word-break:break-word}.art-channel__eyebrow{color:var(--ab-color-muted);font-size:22rpx;font-weight:700;letter-spacing:.15em}.art-channel__title{max-width:650rpx;margin-top:64rpx;color:var(--ab-color-green);font-family:Georgia,Songti SC,STSong,serif;font-size:64rpx;font-weight:500;line-height:1.16}.art-channel__subtitle{margin-top:16rpx;color:var(--ab-color-muted);font-family:Georgia,serif;font-size:28rpx;font-style:italic;letter-spacing:.04em}.art-channel__intro{max-width:620rpx;margin-top:40rpx;color:var(--ab-color-ink);font-size:30rpx;line-height:1.75}.art-channel__scope{max-width:620rpx;margin-top:20rpx;border-left:4rpx solid var(--ab-color-gold);padding-left:18rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.6}.art-channel__tabs{width:100%;border-top:2rpx solid var(--ab-color-border);border-bottom:2rpx solid var(--ab-color-border);white-space:nowrap}.art-channel__tabs-inner{display:inline-flex;min-width:100%}.art-channel__tab{position:relative;display:flex;flex:1 0 auto;flex-direction:column;align-items:flex-start;justify-content:center;min-width:154rpx;min-height:104rpx;margin:0;padding:18rpx 24rpx 20rpx 0;border:0;border-radius:0;background:transparent;color:var(--ab-color-muted);font-size:28rpx;line-height:1.25;text-align:left}.art-channel__tab:after{border:0}.art-channel__tab--active{color:var(--ab-color-green);font-weight:700}.art-channel__tab--active:before{position:absolute;right:24rpx;bottom:-2rpx;left:0;height:4rpx;background:var(--ab-color-gold);content:""}.art-channel__tab-en{margin-top:6rpx;font-family:Georgia,serif;font-size:20rpx;font-weight:400}.art-channel__collections,.art-channel__listing{padding-top:72rpx}.art-channel__section-heading{align-items:baseline;gap:20rpx;padding-bottom:24rpx}.art-channel__section-index{color:var(--ab-color-muted);font-family:Georgia,serif;font-size:22rpx}.art-channel__section-title{color:var(--ab-color-green);font-size:26rpx;font-weight:700;letter-spacing:.05em}.art-channel__collection-list{display:grid;grid-template-columns:1fr;border-bottom:2rpx solid var(--ab-color-border)}.art-channel__collection{padding:32rpx 0;border-top:2rpx solid var(--ab-color-border)}.art-channel__collection-topline{justify-content:space-between;gap:20rpx;color:var(--ab-color-muted);font-size:20rpx;letter-spacing:.06em}.art-channel__collection-title{margin-top:18rpx;color:var(--ab-color-ink);font-family:Georgia,Songti SC,STSong,serif;font-size:36rpx;font-weight:600;line-height:1.35}.art-channel__collection-en{margin-top:8rpx;color:var(--ab-color-muted);font-family:Georgia,serif;font-size:24rpx;font-style:italic}.art-channel__collection-summary{margin-top:18rpx;color:var(--ab-color-muted);font-size:26rpx;line-height:1.6}.art-channel__inline-note,.art-channel__pagination{margin-top:24rpx;border-left:4rpx solid var(--ab-color-gold);padding:16rpx 0 16rpx 18rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.55}.art-channel__pagination button{min-height:var(--ab-touch-target);margin:12rpx 0 0;border:0;background:transparent;color:var(--ab-color-green);font-size:26rpx;text-align:left}.art-channel__pagination button:after{border:0}.art-channel__footer{margin-top:80rpx;padding-top:28rpx;border-top:2rpx solid var(--ab-color-border);color:var(--ab-color-muted);font-size:23rpx;line-height:1.65}@media(min-width:700px){.art-channel__collection-list{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:40rpx}}@media(prefers-color-scheme:dark){.art-channel{background:var(--ab-color-dark-canvas);color:var(--ab-color-dark-text)}.art-channel__eyebrow,.art-channel__subtitle,.art-channel__scope,.art-channel__section-index,.art-channel__collection-topline,.art-channel__collection-en,.art-channel__collection-summary,.art-channel__inline-note,.art-channel__pagination,.art-channel__footer{color:var(--ab-color-dark-muted)}.art-channel__title,.art-channel__intro,.art-channel__tab--active,.art-channel__section-title,.art-channel__collection-title,.art-channel__pagination button{color:var(--ab-color-dark-text)}.art-channel__tabs,.art-channel__collection-list,.art-channel__collection,.art-channel__footer{border-color:var(--ab-color-dark-border)}.art-channel__tab{color:var(--ab-color-dark-muted)}.art-channel__tab--active:before{background:var(--ab-color-gold-soft)}}
