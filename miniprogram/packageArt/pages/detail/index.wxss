.art-detail{min-height:100vh;padding:56rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));background:var(--ab-color-ivory);color:var(--ab-color-ink)}.art-detail__inner{width:100%;max-width:680px;margin:0 auto}.art-detail__topline,.art-detail__evidence-line,.art-detail__section-heading,.art-detail__event{display:flex;align-items:center}.art-detail__topline{justify-content:space-between;gap:24rpx}.art-detail__eyebrow,.art-detail__title,.art-detail__creator,.art-detail__summary text,.art-detail__section-title,.art-detail__fact-label,.art-detail__fact-value,.art-detail__creator-name,.art-detail__creator-biography,.art-detail__creator-source,.art-detail__creator-demo,.art-detail__notice,.art-detail__event-title,.art-detail__event-meta,.art-detail__event-state,.art-detail__intent-copy{display:block;overflow-wrap:anywhere;word-break:break-word}.art-detail__eyebrow{color:var(--ab-color-muted);font-size:22rpx;font-weight:700;letter-spacing:.1em}.art-detail__heading{padding:64rpx 0 48rpx}.art-detail__title{max-width:670rpx;color:var(--ab-color-ink);font-family:Georgia,Songti SC,STSong,serif;font-size:56rpx;font-weight:500;line-height:1.22}.art-detail__creator{margin-top:28rpx;color:var(--ab-color-ink);font-size:28rpx;font-weight:600}.art-detail__evidence-line{flex-wrap:wrap;gap:16rpx;margin-top:18rpx;color:var(--ab-color-muted);font-size:20rpx;letter-spacing:.05em}.art-detail__hero{width:100%}.art-detail__hero-image{display:block;width:100%;background:var(--ab-color-paper)}.art-detail__hero-fallback{box-sizing:border-box;min-height:480rpx;padding:56rpx 40rpx;border:2rpx solid var(--ab-color-border);background:var(--ab-color-paper)}.art-detail__hero-mark{color:var(--ab-color-muted);font-size:22rpx;font-weight:700;letter-spacing:.12em}.art-detail__hero-fallback-title{display:block;max-width:520rpx;margin-top:140rpx;color:var(--ab-color-ink);font-family:Georgia,Songti SC,STSong,serif;font-size:42rpx;line-height:1.3}.art-detail__hero-fallback-copy,.art-detail__hero-error{display:block;max-width:540rpx;margin-top:20rpx;color:var(--ab-color-muted);font-size:25rpx;line-height:1.6}.art-detail__hero-error{border-left:4rpx solid var(--ab-color-gold);padding-left:16rpx}.art-detail__summary{padding:42rpx 0;border-bottom:2rpx solid var(--ab-color-border)}.art-detail__summary text{max-width:620rpx;color:var(--ab-color-ink);font-size:30rpx;line-height:1.78}.art-detail__section{padding-top:72rpx}.art-detail__section-heading{align-items:baseline;gap:20rpx;padding-bottom:24rpx}.art-detail__section-index{color:var(--ab-color-muted);font-family:Georgia,serif;font-size:22rpx}.art-detail__section-title{color:var(--ab-color-ink);font-size:25rpx;font-weight:700;letter-spacing:.04em}.art-detail__facts{border-bottom:2rpx solid var(--ab-color-border)}.art-detail__fact{display:grid;grid-template-columns:190rpx minmax(0,1fr);gap:28rpx;padding:26rpx 0;border-top:2rpx solid var(--ab-color-border)}.art-detail__fact-label{color:var(--ab-color-muted);font-size:24rpx;line-height:1.55}.art-detail__fact-value{color:var(--ab-color-ink);font-size:27rpx;line-height:1.62}.art-detail__creator-profile{padding:36rpx 0;border-top:2rpx solid var(--ab-color-border);border-bottom:2rpx solid var(--ab-color-border)}.art-detail__creator-name{color:var(--ab-color-ink);font-family:Georgia,Songti SC,STSong,serif;font-size:38rpx;font-weight:600;line-height:1.35}.art-detail__creator-biography{max-width:620rpx;margin-top:20rpx;color:var(--ab-color-muted);font-size:27rpx;line-height:1.7}.art-detail__creator-source{margin-top:22rpx;color:var(--ab-color-muted);font-size:22rpx;line-height:1.55}.art-detail__creator-demo{margin-top:14rpx;color:var(--ab-color-muted);font-size:20rpx;letter-spacing:.06em}.art-detail__notice{border-left:4rpx solid var(--ab-color-gold);padding-left:18rpx;color:var(--ab-color-muted);font-size:24rpx;line-height:1.6}.art-detail__events{border-bottom:2rpx solid var(--ab-color-border)}.art-detail__event{justify-content:space-between;gap:24rpx;min-height:var(--ab-touch-target);padding:28rpx 0;border-top:2rpx solid var(--ab-color-border)}.art-detail__event-copy{min-width:0}.art-detail__event-title{color:var(--ab-color-ink);font-size:28rpx;font-weight:600;line-height:1.45}.art-detail__event-meta{margin-top:10rpx;color:var(--ab-color-muted);font-size:23rpx}.art-detail__event-state{flex:0 0 180rpx;color:var(--ab-color-muted);font-size:22rpx;line-height:1.45;text-align:right}.art-detail__intent{margin-top:72rpx;padding:40rpx 32rpx;border-top:2rpx solid var(--ab-color-gold);background:var(--ab-color-paper)}.art-detail__intent .art-detail__section-heading{padding-bottom:18rpx}.art-detail__intent-copy{color:var(--ab-color-muted);font-size:25rpx;line-height:1.65}@media(max-width:340px){.art-detail__fact{grid-template-columns:1fr;gap:8rpx}.art-detail__event{align-items:flex-start;flex-direction:column}.art-detail__event-state{flex-basis:auto;text-align:left}}@media(prefers-color-scheme:dark){.art-detail{background:var(--ab-color-dark-canvas);color:var(--ab-color-dark-text)}.art-detail__eyebrow,.art-detail__evidence-line,.art-detail__hero-mark,.art-detail__hero-fallback-copy,.art-detail__hero-error,.art-detail__section-index,.art-detail__fact-label,.art-detail__creator-biography,.art-detail__creator-source,.art-detail__creator-demo,.art-detail__notice,.art-detail__event-meta,.art-detail__event-state,.art-detail__intent-copy{color:var(--ab-color-dark-muted)}.art-detail__title,.art-detail__creator,.art-detail__hero-fallback-title,.art-detail__summary text,.art-detail__section-title,.art-detail__fact-value,.art-detail__creator-name,.art-detail__event-title{color:var(--ab-color-dark-text)}.art-detail__hero-image,.art-detail__hero-fallback,.art-detail__intent{border-color:var(--ab-color-dark-border);background:var(--ab-color-dark-surface)}.art-detail__summary,.art-detail__facts,.art-detail__fact,.art-detail__creator-profile,.art-detail__events,.art-detail__event{border-color:var(--ab-color-dark-border)}.art-detail__intent{border-top-color:var(--ab-color-gold-soft)}}
