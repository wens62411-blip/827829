<view class="art-detail"><view class="art-detail__inner"><art-page-state
      wx:if="{{state === 'LOADING' || state === 'ERROR'}}"
      kind="{{state}}"
      title="{{stateTitle}}"
      description="{{stateDescription}}"
      weak-network="{{weakNetwork}}"
      retryable="{{retryable}}"
      bindretry="handleRetry"
    /><block wx:if="{{state === 'READY' && content}}"><view class="art-detail__topline"><text class="art-detail__eyebrow">{{categoryLabel}} · {{cityName}}</text><ab-evidence-label mode="{{runtimeMode}}" /></view><view class="art-detail__heading"><text class="art-detail__title">{{content.title}}</text><text class="art-detail__creator">{{content.creatorDisplayName}}</text><view class="art-detail__evidence-line" aria-label="记录来源与证据范围"><text>{{recordOriginLabel}}</text><text>{{evidenceScopeLabel}}</text><text>{{content.publicationState}}</text></view></view><view class="art-detail__hero"><image
          wx:if="{{heroImageAllowed}}"
          class="art-detail__hero-image"
          src="{{heroImageUrl}}"
          mode="widthFix"
          aria-label="{{content.alt}}"
          binderror="handleHeroImageError"
        /><view wx:else class="art-detail__hero-fallback" aria-role="img" aria-label="{{content.alt}}"><text class="art-detail__hero-mark">AB / {{categoryLabel}}</text><text class="art-detail__hero-fallback-title">暂无可公开展示的图片</text><text class="art-detail__hero-fallback-copy">{{content.rightsSummary}}</text><text wx:if="{{heroImageFailed}}" class="art-detail__hero-error">图片读取失败，已切换为无图状态。</text></view></view><view class="art-detail__summary"><text>{{content.summary}}</text></view><view class="art-detail__section" aria-label="分类专属字段"><view class="art-detail__section-heading"><text class="art-detail__section-index">01</text><text class="art-detail__section-title">记录字段 / Object Record</text></view><view class="art-detail__facts"><view wx:for="{{rows}}" wx:key="label" class="art-detail__fact"><text class="art-detail__fact-label">{{item.label}}</text><text class="art-detail__fact-value">{{item.value}}</text></view></view></view><view class="art-detail__section" aria-label="艺术家或机构摘要"><view class="art-detail__section-heading"><text class="art-detail__section-index">02</text><text class="art-detail__section-title">{{creatorKindLabel}} / Creator</text></view><view class="art-detail__creator-profile"><text class="art-detail__creator-name">{{creator.displayName}}</text><text class="art-detail__creator-biography">{{creator.biography}}</text><text class="art-detail__creator-source">资料来源：{{creator.sourceTitle}}</text><text wx:if="{{creator.evidenceScope === 'DEMO_ONLY'}}" class="art-detail__creator-demo">合成示例 · 非真实人物或机构</text></view></view><view class="art-detail__section" aria-label="来源与审核说明"><view class="art-detail__section-heading"><text class="art-detail__section-index">03</text><text class="art-detail__section-title">证据边界 / Evidence</text></view><ab-provenance-summary
          source-title="{{content.sourceTitle}}"
          source-url="{{content.sourceUrl}}"
          record-origin="{{content.recordOrigin}}"
          evidence-scope="{{content.evidenceScope}}"
          publication-state="{{content.publicationState}}"
          reviewed-at="{{content.reviewedAt}}"
          rights-status="{{content.rightsStatus}}"
          rights-reviewed-at="{{content.rightsReviewedAt || ''}}"
          platform-statement="{{platformStatement}}"
          bindsourcecopy="handleSourceCopy"
        /></view><view class="art-detail__section" aria-label="相关线下活动"><view class="art-detail__section-heading"><text class="art-detail__section-index">04</text><text class="art-detail__section-title">相关线下活动 / Related Events</text></view><text wx:if="{{relatedEventsNotice}}" class="art-detail__notice">{{relatedEventsNotice}}</text><view wx:if="{{relatedEvents.length}}" class="art-detail__events"><view
            wx:for="{{relatedEvents}}"
            wx:key="eventId"
            class="art-detail__event"
            data-event-id="{{item.eventId}}"
            data-city-id="{{item.cityId}}"
            data-record-origin="{{item.recordOrigin}}"
            aria-role="button"
            bindtap="handleRelatedEventTap"
          ><view class="art-detail__event-copy"><text class="art-detail__event-title">{{item.title}}</text><text class="art-detail__event-meta">{{item.cityName}} · {{item.startsAt}}</text></view><text class="art-detail__event-state">{{item.reservationAvailable ? '请查看活动页资格' : '当前不承诺可预约'}}</text></view></view><text wx:else class="art-detail__notice">当前没有可公开关联的线下活动。</text></view><view class="art-detail__section art-detail__intent" aria-label="品鉴或合作意向"><view class="art-detail__section-heading"><text class="art-detail__section-index">05</text><text class="art-detail__section-title">联系意向 / Expression of Interest</text></view><text class="art-detail__intent-copy">可选择预约品鉴意向或合作意向。提交只记录联系需求，不代表接受、成交或任何资源承诺。</text><ab-intent-action
          content-id="{{content.contentId}}"
          state="NONE"
          create-label="填写品鉴或合作意向"
          bindintentcreate="handleIntentCreate"
        /></view></block></view></view>
