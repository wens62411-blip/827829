.city-page{box-sizing:border-box;width:100%;min-height:100vh;margin:0 auto;padding:52rpx 32rpx 72rpx;background:#f4efe5}.city-header{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin:0 2rpx 34rpx;padding-bottom:28rpx;border-bottom:1rpx solid #b9aa91;animation:city-rise 480ms cubic-bezier(.2,.72,.24,1) both}.city-header::after{position:absolute;right:0;bottom:-2rpx;width:78rpx;height:3rpx;background:#7b3038;content:""}.city-header__eyebrow,.city-header__title,.city-header__subtitle,.node-fact text,.city-row__name,.city-row__id,.city-row__states text{display:block}.city-header__eyebrow{color:#8a6538;font-size:19rpx;font-weight:700;letter-spacing:.17em}.city-header__title{margin-top:7rpx;color:#173c32;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-size:58rpx;font-weight:500;letter-spacing:.02em;line-height:1.18}.city-header__subtitle{max-width:560rpx;margin-top:10rpx;color:#64716c;font-size:19rpx;letter-spacing:.035em;line-height:1.55}.node-fact{position:relative;margin:22rpx 0 54rpx;padding:28rpx 26rpx 28rpx 32rpx;border-top:1rpx solid #c8baa5;border-bottom:1rpx solid #c8baa5;background:transparent;color:#64716c;font-size:22rpx;line-height:1.6;animation:city-rise 480ms 110ms cubic-bezier(.2,.72,.24,1) both}.node-fact::before{position:absolute;top:29rpx;bottom:29rpx;left:0;width:4rpx;background:#8a6538;content:""}.node-fact__label{color:#8a6538;font-size:19rpx;font-weight:700;letter-spacing:.12em}.node-fact__value{margin:7rpx 0;color:#173c32;font-family:Georgia,"Songti SC",SimSun,serif;font-size:31rpx;font-weight:500}.node-fact__warning{margin-top:11rpx;color:#773f3d;font-weight:650}.directory{animation:city-rise 480ms 170ms cubic-bezier(.2,.72,.24,1) both}.directory__global{position:relative;padding:23rpx 26rpx;border:1rpx solid #173c32;border-radius:2rpx;background:#173c32;color:#fcfbf7;font-family:Georgia,"Songti SC",serif;font-size:30rpx;font-weight:500;letter-spacing:.04em}.directory__global::after{position:absolute;top:50%;right:26rpx;width:90rpx;height:1rpx;background:#d8c197;content:""}.region{margin-top:40rpx}.region__heading,.country__heading{display:flex;align-items:baseline;justify-content:space-between}.region__heading{padding:0 2rpx 14rpx;border-bottom:1rpx solid #b9aa91;color:#173c32;font-family:Georgia,"Songti SC",serif;font-size:34rpx;font-weight:500}.region__heading text:last-child,.country__heading text:last-child{color:#64716c;font-family:Georgia,serif;font-size:20rpx;font-weight:400;letter-spacing:.07em}.country{margin:0;padding:21rpx 0 0;border:0;border-bottom:1rpx solid #b9aa91;background:transparent}.country__heading{padding:0 4rpx 13rpx;color:#8a6538;font-size:22rpx;font-weight:700;letter-spacing:.08em}.city-row{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;width:100%;min-height:110rpx;margin:0;padding:18rpx 10rpx;border:0;border-top:1rpx solid #ded4c5;border-radius:0;background:transparent;color:#1c2723;text-align:left;transition:background 150ms ease,padding 150ms ease}.city-row::after,.city-page__back::after{border:0}.city-row--selected{padding-left:20rpx;border-left:4rpx solid #7b3038;background:#eee7db}.city-row--pressed{background:#e8dfd1}.city-row__name{font-family:Georgia,"Songti SC",SimSun,serif;font-size:27rpx;font-weight:500}.city-row__id{color:#64716c;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:19rpx}.city-row__states{flex:0 0 190rpx;color:#64716c;font-size:20rpx;text-align:right}.city-row__states text:first-child{color:#173c32;font-weight:650}.city-page__back{width:100%;min-height:88rpx;margin-top:38rpx;border:1rpx solid #173c32;border-radius:2rpx;background:transparent;color:#173c32;font-size:25rpx;font-weight:600;letter-spacing:.05em}@keyframes city-rise{from{opacity:0;transform:translateY(16rpx)}to{opacity:1;transform:translateY(0)}}@media (min-width:760px){.city-page{max-width:1080rpx;padding-right:48rpx;padding-left:48rpx}}@media (prefers-color-scheme:dark){.city-page{background:#102821}.city-header,.node-fact,.region__heading,.country,.city-row{border-color:#60766d}.city-header__title,.node-fact__value,.region__heading,.city-row,.city-row__states text:first-child,.city-page__back{color:#fcfbf7}.city-row--selected,.city-row--pressed{background:#1d463b}.city-page__back{border-color:#d8c197}}@media (prefers-reduced-motion:reduce){.city-header,.node-fact,.directory{animation:none}.city-row{transition:none}}