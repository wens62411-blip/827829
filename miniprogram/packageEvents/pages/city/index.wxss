.city-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx 32rpx 72rpx;
  background: var(--ab-color-ivory);
  color: var(--ab-color-ink);
}

.city-hero-wrap {
  margin-top: 30rpx;
}

.node-fact {
  position: relative;
  margin: 22rpx 0 48rpx;
  padding: 26rpx 24rpx 26rpx 30rpx;
  border: 1rpx solid var(--ab-color-border);
  border-radius: 12rpx;
  background: var(--ab-color-paper-white);
  color: var(--ab-color-muted);
  font-size: 21rpx;
  line-height: 1.6;
}

.node-fact::before {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 4rpx;
  background: var(--ab-color-gold-brown);
  content: "";
}

.node-fact text,
.city-row__name,
.city-row__id,
.city-row__states text {
  display: block;
}

.node-fact__label {
  color: var(--ab-color-gold-brown);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.node-fact__value {
  margin: 6rpx 0;
  color: var(--ab-color-ink);
  font-family: Georgia, "Songti SC", serif;
  font-size: 30rpx;
}

.node-fact__warning {
  margin-top: 10rpx;
  color: var(--ab-color-champagne-deep);
  font-weight: 650;
}

.directory__global {
  position: relative;
  padding: 22rpx 24rpx;
  border-radius: 10rpx;
  background: var(--ab-color-ink);
  color: var(--ab-color-paper-white);
  font-family: Georgia, "Songti SC", serif;
  font-size: 29rpx;
}

.directory__global::after {
  position: absolute;
  top: 50%;
  right: 24rpx;
  width: 82rpx;
  height: 1rpx;
  background: var(--ab-color-gold-soft);
  content: "";
}

.region {
  margin-top: 36rpx;
}

.region__heading,
.country__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.region__heading {
  padding: 0 2rpx 13rpx;
  border-bottom: 1rpx solid var(--ab-color-border);
  font-family: Georgia, "Songti SC", serif;
  font-size: 32rpx;
}

.region__heading text:last-child,
.country__heading text:last-child {
  color: var(--ab-color-muted);
  font-family: Georgia, serif;
  font-size: 19rpx;
  font-weight: 400;
  letter-spacing: 0.06em;
}

.country {
  padding-top: 20rpx;
  border-bottom: 1rpx solid var(--ab-color-border);
}

.country__heading {
  padding: 0 4rpx 12rpx;
  color: var(--ab-color-gold-brown);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.city-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 110rpx;
  margin: 0;
  padding: 18rpx 10rpx;
  border: 0;
  border-top: 1rpx solid var(--ab-color-border);
  border-radius: 0;
  background: transparent;
  color: var(--ab-color-ink);
  text-align: left;
}

.city-row::after,
.city-page__back::after {
  border: 0;
}

.city-row--selected {
  padding-left: 20rpx;
  border-left: 4rpx solid var(--ab-color-champagne-deep);
  background: rgba(112, 70, 74, 0.05);
}

.city-row--pressed {
  background: rgba(170, 132, 72, 0.08);
}

.city-row__name {
  font-family: Georgia, "Songti SC", serif;
  font-size: 27rpx;
  font-weight: 500;
}

.city-row__id {
  color: var(--ab-color-muted);
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 18rpx;
}

.city-row__states {
  flex: 0 0 190rpx;
  color: var(--ab-color-muted);
  font-size: 19rpx;
  text-align: right;
}

.city-row__states text:first-child {
  color: var(--ab-color-ink);
  font-weight: 650;
}

.city-page__back {
  width: 100%;
  min-height: var(--ab-touch-target);
  margin-top: 36rpx;
  border: 1rpx solid var(--ab-color-ink);
  border-radius: 10rpx;
  background: transparent;
  color: var(--ab-color-ink);
  font-size: 24rpx;
  font-weight: 600;
}

@media (min-width: 760px) {
  .city-page {
    max-width: 1080rpx;
    margin: 0 auto;
    padding-right: 48rpx;
    padding-left: 48rpx;
  }
}

@media (prefers-color-scheme: dark) {
  .city-page {
    background: var(--ab-color-dark-canvas);
    color: var(--ab-color-dark-text);
  }

  .node-fact {
    border-color: var(--ab-color-dark-border);
    background: var(--ab-color-dark-surface);
    color: var(--ab-color-dark-muted);
  }

  .node-fact__value,
  .city-row,
  .city-row__states text:first-child,
  .city-page__back {
    color: var(--ab-color-dark-text);
  }

  .region__heading,
  .country,
  .city-row {
    border-color: var(--ab-color-dark-border);
  }

  .city-page__back {
    border-color: var(--ab-color-gold-soft);
  }
}
