<view class="city-page ab-safe-bottom">
  <ab-brand-header
    eyebrow="GLOBAL CHINESE DIRECTORY"
    title="全球城市覆盖"
    subtitle="第一阶段用于名片上的城市归属与跨城识别；目录存在不等于当地节点已运营。"
    compact="{{true}}"
  />

  <view class="city-hero-wrap">
    <ab-city-hero
      city-name="{{hero.label}}"
      city-name-en="{{hero.nameEn}}"
      timezone="{{hero.timezone}}"
      catalog-label="{{hero.catalogLabel}}"
      operational-label="{{hero.operationalLabel}}"
      operation-evidence="{{hero.operationEvidence}}"
      image-src="{{hero.imageSrc}}"
      image-alt="{{hero.imageAlt}}"
      photo-credit="{{hero.photoCredit}}"
      media-rights-label="{{hero.mediaRightsLabel}}"
    />
  </view>

  <view class="node-fact" aria-role="note">
    <text class="node-fact__label">所选城市</text>
    <text class="node-fact__value">{{nodeLabel}}</text>
    <text>运营状态：{{nodeOperationalLabel}} · 主理人：{{nodeOrganizerLabel}}</text>
    <text class="node-fact__warning">城市入口不等于节点已运营，也不等于已有真实活动。</text>
  </view>

  <view class="directory" aria-role="region" aria-label="7 国 13 城完整层级">
    <view class="directory__global">全球 / Global</view>
    <view wx:for="{{regions}}" wx:key="id" class="region">
      <view class="region__heading"><text>{{item.label}}</text><text>{{item.nameEn}}</text></view>
      <view wx:for="{{item.countries}}" wx:for-item="country" wx:key="id" class="country">
        <view class="country__heading"><text>{{country.label}}</text><text>{{country.nameEn}}</text></view>
        <button
          wx:for="{{country.cities}}"
          wx:for-item="city"
          wx:key="id"
          class="city-row {{city.id === selectedCityId ? 'city-row--selected' : ''}}"
          data-city-id="{{city.id}}"
          bindtap="onSelectCity"
          hover-class="city-row--pressed"
          aria-label="{{city.label}}，目录 ACTIVE，运营 {{city.operationalLabel}}，时区 {{city.timezone}}"
        >
          <view>
            <text class="city-row__name">{{city.label}} / {{city.nameEn}}</text>
            <text class="city-row__id">{{city.timezone}}</text>
          </view>
          <view class="city-row__states">
            <text>名片城市可选</text>
            <text>节点 {{city.operationalLabel}}</text>
          </view>
        </button>
      </view>
    </view>
  </view>

  <button class="city-page__back" bindtap="backToEvents" hover-class="city-row--pressed">返回活动预览</button>
</view>
