<view class="enrollment-page ab-safe-bottom"><view class="enrollment-header"><view><text class="enrollment-header__eyebrow">AB CLUB · INTEREST</text><text class="enrollment-header__title">兴趣登记</text></view></view><view wx:if="{{loading}}" class="enrollment-loading" aria-role="status">正在加载登记信息…</view><view wx:elif="{{loaded}}" class="enrollment-panel"><view class="status-block"><text class="status-block__label">参与资格</text><text class="status-block__value">{{eligibilityLabel}}</text><text class="status-block__detail">{{eligibilityDetail}}</text></view><view class="status-block"><text class="status-block__label">当前兴趣登记状态</text><text class="status-block__value">{{enrollmentStateLabel}}</text></view><button wx:if="{{canRegisterInterest}}" class="primary-action" disabled="{{busy}}" bindtap="registerInterest">{{busy ? '正在提交…' : '登记兴趣'}}</button><button wx:if="{{canCancelInterest}}" class="secondary-action" disabled="{{busy}}" bindtap="cancelInterest">{{busy ? '正在提交…' : '取消兴趣登记'}}</button><view wx:if="{{operationMessage}}" class="operation-message" aria-role="status" aria-live="polite">{{operationMessage}}</view></view><ab-event-state wx:else kind="{{stateKind}}" title="{{stateTitle}}" description="{{stateDescription}}" detail="{{stateDetail}}" /></view>
