.enrollment-page{box-sizing:border-box;width:100%;min-height:100vh;margin:0 auto;padding:52rpx 32rpx 72rpx;background:#f4efe5}.enrollment-header{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin:0 2rpx 34rpx;padding-bottom:28rpx;border-bottom:1rpx solid #b9aa91;animation:enrollment-rise 480ms cubic-bezier(.2,.72,.24,1) both}.enrollment-header::after{position:absolute;right:0;bottom:-2rpx;width:78rpx;height:3rpx;background:#7b3038;content:""}.enrollment-header__eyebrow,.enrollment-header__title,.enrollment-header__subtitle,.status-block__label,.status-block__value,.status-block__detail,.request-boundary text{display:block}.enrollment-header__eyebrow,.status-block__label{color:#8a6538;font-size:19rpx;font-weight:700;letter-spacing:.15em}.enrollment-header__title{margin-top:7rpx;color:#173c32;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-size:58rpx;font-weight:500;line-height:1.18}.enrollment-header__subtitle,.status-block__detail{color:#64716c;font-size:22rpx;line-height:1.65}.enrollment-header__subtitle{margin-top:9rpx}.enrollment-loading{padding:88rpx 20rpx;border-top:1rpx solid #bcae98;border-bottom:1rpx solid #bcae98;color:#64716c;line-height:1.7;text-align:center}.enrollment-panel{overflow:hidden;border:1rpx solid #bcae98;border-radius:2rpx;background:#fcfaf5;animation:enrollment-rise 520ms 70ms cubic-bezier(.2,.72,.24,1) both}.status-block{position:relative;padding:31rpx 30rpx;border-bottom:1rpx solid #c9bdab}.status-block__value{margin-top:8rpx;color:#173c32;font-family:Georgia,"Songti SC",serif;font-size:32rpx;font-weight:500}.status-block__detail{margin-top:9rpx}.status-block--payment{padding-left:38rpx}.status-block--payment::before{position:absolute;top:31rpx;bottom:31rpx;left:0;width:4rpx;background:#7b3038;content:""}.primary-action,.secondary-action{min-height:94rpx;margin:28rpx 30rpx 0;border-radius:2rpx;font-size:26rpx;font-weight:600;letter-spacing:.05em;transition:opacity 160ms ease,color 160ms ease,background 160ms ease}.primary-action{border:1rpx solid #173c32;background:#173c32;color:#fcfbf7}.secondary-action{border:1rpx solid #173c32;background:transparent;color:#173c32}.primary-action[disabled],.secondary-action[disabled]{opacity:.55}.primary-action::after,.secondary-action::after{border:0}.operation-message,.request-boundary{margin:26rpx 30rpx 0;padding:20rpx 22rpx;border-left:4rpx solid #7b3038;background:#eee7db;color:#5f5b52;font-size:22rpx;line-height:1.65}.request-boundary{margin-bottom:34rpx;border-left-color:#8a6538}.request-boundary text + text{margin-top:9rpx}@keyframes enrollment-rise{from{opacity:0;transform:translateY(16rpx)}to{opacity:1;transform:translateY(0)}}@media (min-width:760px){.enrollment-page{max-width:920rpx;padding-right:48rpx;padding-left:48rpx}}@media (prefers-color-scheme:dark){.enrollment-page{background:#102821}.enrollment-header,.enrollment-loading,.enrollment-panel,.status-block{border-color:#60766d}.enrollment-panel{background:#173c32}.enrollment-header__title,.status-block__value,.secondary-action{color:#fcfbf7}.secondary-action{border-color:#d8c197}.primary-action{border-color:#d8c197;background:#d8c197;color:#102821}.operation-message,.request-boundary{background:#1d463b;color:#c8cfc9}}@media (prefers-reduced-motion:reduce){.enrollment-header,.enrollment-panel{animation:none}.primary-action,.secondary-action{transition:none}}