.calendar-page {
  --canvas: #24211e;
  --paper: #2d2925;
  --ink: #f7f2e9;
  --muted: #b8afa2;
  --line: rgba(224, 207, 177, .28);
  --gold: #d8bd84;
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background: var(--canvas);
  color: var(--ink);
}
.calendar-shell { display: flex; flex-direction: column; box-sizing: border-box; width: 100%; max-width: 980rpx; height: 100%; margin: 0 auto; padding-bottom: env(safe-area-inset-bottom); }
.calendar-header { flex: 0 0 auto; padding: 32rpx 32rpx 28rpx; border-bottom: 1rpx solid var(--line); }
.calendar-header__topline { display: flex; justify-content: space-between; gap: 18rpx; color: var(--gold); font: 17rpx Georgia, serif; letter-spacing: .14em; }
.calendar-header__topline text:last-child { text-align: right; }
.calendar-year { display: block; margin-top: 24rpx; color: var(--gold); font: 86rpx/.94 Georgia, serif; letter-spacing: -.04em; }
.calendar-title { display: block; margin-top: 30rpx; color: var(--ink); font: 500 34rpx/1.25 Georgia, serif; letter-spacing: .12em; }
.calendar-title__zh { display: block; margin-top: 12rpx; color: var(--ink); font: 500 42rpx/1.25 Georgia, "Songti SC", "STSong", SimSun, serif; }
.calendar-intro { display: block; max-width: 600rpx; margin-top: 20rpx; color: var(--muted); font-size: 23rpx; line-height: 1.7; }

.calendar-month-rail { display: block; flex: 0 0 auto; width: 100%; border-bottom: 1rpx solid var(--line); white-space: nowrap; }
.calendar-month-rail__inner { display: inline-flex; align-items: center; gap: 4rpx; min-width: 100%; padding: 0 32rpx; }
.calendar-month-tab { position: relative; flex: 0 0 auto; min-width: 88rpx; min-height: var(--ab-touch-target); margin: 0; padding: 0 10rpx; border: 0; border-radius: 0; background: transparent; color: var(--muted); font: 24rpx Georgia, serif; letter-spacing: .04em; }
.calendar-month-tab::after { border: 0; }
.calendar-month-tab--active { color: var(--gold); }
.calendar-month-tab--active::before { position: absolute; right: 10rpx; bottom: 0; left: 10rpx; height: 3rpx; background: var(--gold); content: ""; }

.calendar-timeline { box-sizing: border-box; flex: 1 1 0%; height: 0; min-height: 0; padding: 0 32rpx; }
.calendar-month { position: relative; padding: 48rpx 0 12rpx 30rpx; border-left: 1rpx solid var(--line); }
.calendar-month:first-child { padding-top: 40rpx; }
.calendar-month__heading { display: flex; align-items: baseline; gap: 16rpx; margin-left: -30rpx; }
.calendar-month__code { flex: 0 0 auto; color: var(--gold); font: 22rpx Georgia, serif; letter-spacing: .1em; }
.calendar-month__name { flex: 0 0 auto; color: var(--ink); font: 500 35rpx/1.1 Georgia, serif; letter-spacing: .08em; }
.calendar-month__rule { flex: 1 1 auto; height: 1rpx; margin-left: 8rpx; background: var(--line); }

.calendar-event-list { display: flex; flex-direction: column; gap: 18rpx; margin-top: 28rpx; }
.calendar-event { position: relative; display: grid; grid-template-columns: 20rpx minmax(0, 1fr) 28rpx; gap: 16rpx; width: 100%; margin: 0; padding: 18rpx 0 22rpx; border: 0; border-bottom: 1rpx solid var(--line); border-radius: 0; background: transparent; color: var(--ink); text-align: left; }
.calendar-event::after { border: 0; }
.calendar-event-list .calendar-event { width: 100%; font-weight: 400; }
.calendar-month-rail__inner .calendar-month-tab { width: 88rpx; font-weight: 400; }
.calendar-event--featured { margin: 12rpx 0; padding: 40rpx 20rpx 44rpx 12rpx; border: 1rpx solid rgba(216, 189, 132, .54); background: rgba(216, 189, 132, .07); }
.calendar-event--featured .calendar-event__title-en { font-size: 34rpx; }
.calendar-event--featured .calendar-event__title-zh { font-size: 36rpx; }
.calendar-event--pressed { background-color: rgba(216, 189, 132, .12); }
.calendar-event__rail { position: relative; min-height: 100%; }
.calendar-event__rail::before { position: absolute; top: 0; bottom: -22rpx; left: 9rpx; width: 1rpx; background: var(--line); content: ""; }
.calendar-event__dot { position: absolute; top: 6rpx; left: 4rpx; display: block; width: 11rpx; height: 11rpx; border: 1rpx solid var(--gold); border-radius: 50%; background: var(--canvas); }
.calendar-event--featured .calendar-event__dot { width: 15rpx; height: 15rpx; left: 2rpx; background: var(--gold); }
.calendar-event__body { min-width: 0; }
.calendar-event__city { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx; color: var(--gold); font: 23rpx Georgia, serif; letter-spacing: .06em; }
.calendar-event__city text:last-child { color: var(--muted); font-family: "Songti SC", "STSong", SimSun, serif; font-size: 20rpx; letter-spacing: .04em; }
.calendar-event__title-en { display: block; margin-top: 12rpx; color: var(--ink); font: 500 25rpx/1.35 Georgia, serif; letter-spacing: .03em; }
.calendar-event__title-zh { display: block; margin-top: 6rpx; color: var(--ink); font: 500 30rpx/1.35 Georgia, "Songti SC", "STSong", SimSun, serif; }
.calendar-event__date { display: block; margin-top: 16rpx; color: var(--gold); font: 26rpx/1.5 Georgia, serif; letter-spacing: .02em; }
.calendar-event__venue { display: block; margin-top: 5rpx; color: var(--muted); font: 24rpx/1.4 Georgia, "Songti SC", "STSong", SimSun, serif; }
.calendar-event__summary { display: block; max-width: 640rpx; margin-top: 10rpx; color: var(--muted); font-size: 28rpx; line-height: 1.6; }
.calendar-event__arrow { padding-top: 2rpx; color: var(--gold); font: 22rpx Georgia, serif; text-align: right; }
.calendar-month__empty { display: flex; flex-direction: column; gap: 8rpx; margin: 28rpx 0 12rpx; padding: 20rpx 0 22rpx; border-bottom: 1rpx solid var(--line); color: var(--muted); font-size: 21rpx; line-height: 1.5; }
.calendar-month__empty text:last-child { color: var(--gold); font: 14rpx Georgia, serif; letter-spacing: .12em; }
.calendar-timeline__footer { display: flex; justify-content: space-between; gap: 18rpx; margin: 54rpx 0 28rpx; padding-top: 22rpx; padding-bottom: 20rpx; border-top: 1rpx solid var(--line); color: var(--muted); font: 15rpx Georgia, serif; letter-spacing: .1em; }
.calendar-timeline__footer text:last-child { text-align: right; }

@media (min-width: 760px) {
  .calendar-header { padding-right: 48rpx; padding-left: 48rpx; }
  .calendar-month-rail__inner { padding-right: 48rpx; padding-left: 48rpx; }
  .calendar-timeline { padding-right: 48rpx; padding-left: 48rpx; }
}
@media (max-width: 380px) {
  .calendar-header { padding-right: 24rpx; padding-left: 24rpx; }
  .calendar-month-rail__inner { padding-right: 24rpx; padding-left: 24rpx; }
  .calendar-timeline { padding-right: 24rpx; padding-left: 24rpx; }
  .calendar-year { font-size: 94rpx; }
  .calendar-title { font-size: 29rpx; }
  .calendar-title__zh { font-size: 38rpx; }
  .calendar-month__name { font-size: 31rpx; }
  .calendar-event__title-en { font-size: 23rpx; }
  .calendar-event__title-zh { font-size: 27rpx; }
  .calendar-timeline__footer { align-items: flex-start; flex-direction: column; }
  .calendar-timeline__footer text:last-child { text-align: left; }
}
@media (prefers-reduced-motion: reduce) {
  .calendar-month-tab, .calendar-event { transition: none; }
}
