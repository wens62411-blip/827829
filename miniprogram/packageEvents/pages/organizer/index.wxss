.organizer-page{box-sizing:border-box;width:100%;min-height:100vh;margin:0 auto;padding:52rpx 32rpx 72rpx;background:#f4efe5}.organizer-header{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin:0 2rpx 34rpx;padding-bottom:28rpx;border-bottom:1rpx solid #b9aa91;animation:organizer-rise 480ms cubic-bezier(.2,.72,.24,1) both}.organizer-header::after{position:absolute;right:0;bottom:-2rpx;width:78rpx;height:3rpx;background:#7b3038;content:""}.organizer-header__eyebrow,.organizer-header__title,.organizer-card__name,.organizer-card__name-en,.organizer-card__summary,.organizer-card__section-title,.organizer-card__city{display:block}.organizer-header__eyebrow{color:#8a6538;font-size:19rpx;font-weight:700;letter-spacing:.17em}.organizer-header__title,.organizer-card__name{color:#173c32;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-weight:500}.organizer-header__title{margin-top:7rpx;font-size:56rpx;line-height:1.2}.organizer-loading{padding:88rpx 20rpx;border-top:1rpx solid #bcae98;border-bottom:1rpx solid #bcae98;color:#64716c;text-align:center}.organizer-card{position:relative;padding:48rpx 36rpx 38rpx;border:1rpx solid #bcae98;border-radius:2rpx;background:#fcfaf5;animation:organizer-rise 520ms 70ms cubic-bezier(.2,.72,.24,1) both}.organizer-card::after{position:absolute;top:20rpx;right:20rpx;bottom:20rpx;left:20rpx;border:1rpx solid #ddd2c2;content:"";pointer-events:none}.organizer-card > view,.organizer-card > text{position:relative;z-index:1}.organizer-card__mark{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border:1rpx solid #8a6538;border-radius:50%;color:#8a6538;font-family:Georgia,serif;font-size:22rpx;letter-spacing:.06em}.organizer-card__name{margin-top:28rpx;font-size:44rpx;letter-spacing:.02em}.organizer-card__name-en{color:#64716c;font-family:Georgia,serif;font-size:23rpx;letter-spacing:.1em}.organizer-card__evidence{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:8rpx;margin-top:20rpx}.organizer-card__evidence text{padding:7rpx 11rpx;border:1rpx solid #bcae98;border-radius:2rpx;color:#773f3d;font-size:18rpx;font-weight:700;letter-spacing:.06em}.organizer-card__summary{margin-top:24rpx;color:#5d6964;font-size:25rpx;line-height:1.72}.organizer-card__cities{position:relative;z-index:1;margin-top:32rpx;padding-top:26rpx;border-top:1rpx solid #c9bdab}.organizer-card__section-title{margin-bottom:12rpx;color:#173c32;font-family:Georgia,"Songti SC",serif;font-weight:500;letter-spacing:.04em}.organizer-card__city{padding:10rpx 0;border-top:1rpx solid #e0d7ca;font-size:24rpx}.organizer-card__boundary{position:relative;z-index:1;margin-top:30rpx;padding:19rpx 20rpx;border-left:4rpx solid #7b3038;background:#eee7db;color:#5f5b52;font-size:22rpx;line-height:1.65}@keyframes organizer-rise{from{opacity:0;transform:translateY(16rpx)}to{opacity:1;transform:translateY(0)}}@media (min-width:760px){.organizer-page{max-width:920rpx;padding-right:48rpx;padding-left:48rpx}}@media (prefers-color-scheme:dark){.organizer-page{background:#102821}.organizer-header,.organizer-loading,.organizer-card,.organizer-card__cities,.organizer-card__city{border-color:#60766d}.organizer-card{background:#173c32}.organizer-card::after{border-color:#60766d}.organizer-header__title,.organizer-card__name,.organizer-card__section-title{color:#fcfbf7}.organizer-card__name-en,.organizer-card__summary{color:#c8cfc9}.organizer-card__boundary{background:#1d463b;color:#c8cfc9}}@media (prefers-reduced-motion:reduce){.organizer-header,.organizer-card{animation:none}}