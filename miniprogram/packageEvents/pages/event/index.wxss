min-height:96rpx;margin:30rpx 32rpx 38rpx;border:1rpx solid #173c32;border-radius:2rpx;background:#173c32;color:#fcfbf7;font-size:26rpx;font-weight:600;letter-spacing:.05em}.blocked-action{margin:28rpx 32rpx 38rpx}@keyframes detail-rise{from{opacity:0;transform:translateY(16rpx)}to{opacity:1;transform:translateY(0)}}@keyframes detail-photo-settle{from{opacity:.72;transform:scale(1.025)}to{opacity:1;transform:scale(1)}}@media (min-width:760px){.detail-page{max-width:1080rpx;padding-right:48rpx;padding-left:48rpx}.detail__media{height:600rpx}}@media (prefers-color-scheme:dark){.detail-page{background:#102821}.detail-header,.detail,.detail-loading,.fact-section,.fact-row{border-color:#60766d}.detail{background:#173c32}.detail__image-fallback,.timezone-note,.blocked-action{background:#1d463b}.detail-header__title,.detail__title,.fact-section__title,.organizer__name,.fact-row > text:last-child,.text-action{color:#fcfbf7}.detail__summary,.organizer__summary,.detail__id,.fact-row > text:first-child,.timezone-note,.blocked-action{color:#c8cfc9}.text-action,.admission-tag{border-color:#d8c197}.admission-tag{color:#c8cfc9}.interest-action{border-color:#d8c197;background:#d8c197;color:#102821}}@media (prefers-reduced-motion:reduce){.detail-header,.detail,.detail__image{animation:none}}