.detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx 32rpx 72rpx;
  background: var(--ab-color-ivory);
  color: var(--ab-color-ink);
}

.detail-loading {
  margin-top: 30rpx;
  padding: 76rpx 20rpx;
  border: 1rpx solid var(--ab-color-border);
  border-radius: 12rpx;
  color: var(--ab-color-muted);
  text-align: center;
}

.detail {
  overflow: hidden;
  margin-top: 30rpx;
  border: 1rpx solid var(--ab-color-border);
  border-radius: 12rpx;
  background: var(--ab-color-paper-white);
  box-shadow: 0 18rpx 54rpx rgba(68, 55, 38, 0.07);
}

.detail__media {
  position: relative;
  height: 410rpx;
  overflow: hidden;
  background: #e8e0d3;
}

.detail__image,
.detail__image-fallback {
  width: 100%;
  height: 100%;
}

.detail__image-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ab-color-muted);
  font-size: 21rpx;
}

.detail__image-fallback text:first-child {
  margin-bottom: 7rpx;
  color: var(--ab-color-gold-brown);
  font-family: Georgia, "Songti SC", serif;
  font-size: 32rpx;
}

.detail__badge {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  padding: 8rpx 13rpx;
  border: 1rpx solid rgba(255, 253, 248, 0.72);
  border-radius: 8rpx;
  background: rgba(51, 42, 35, 0.82);
  color: #fffdf8;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.detail__intro,
.fact-section {
  padding: 30rpx;
}

.detail__city,
.detail__title,
.detail__summary,
.detail__id,
.fact-section__title,
.phase-boundary text {
  display: block;
}

.detail__city {
  color: var(--ab-color-gold-brown);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.detail__title {
  margin-top: 13rpx;
  font-family: Georgia, "Songti SC", "STSong", SimSun, serif;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.3;
}

.detail__summary {
  margin-top: 15rpx;
  color: var(--ab-color-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.detail__id {
  margin-top: 16rpx;
  color: var(--ab-color-muted);
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 18rpx;
}

.fact-section {
  border-top: 1rpx solid var(--ab-color-border);
}

.fact-section__title {
  margin-bottom: 16rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 30rpx;
}

.fact-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--ab-color-border);
  font-size: 22rpx;
  line-height: 1.55;
}

.fact-row > text:first-child {
  color: var(--ab-color-muted);
}

.fact-row > text:last-child {
  overflow-wrap: anywhere;
  color: var(--ab-color-ink);
  font-weight: 550;
}

.fact-row__mono {
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
}

.phase-boundary {
  margin: 0 30rpx;
  padding: 22rpx;
  border-left: 4rpx solid var(--ab-color-champagne-deep);
  background: rgba(112, 70, 74, 0.06);
  color: var(--ab-color-muted);
  font-size: 22rpx;
  line-height: 1.65;
}

.phase-boundary__title {
  margin-bottom: 6rpx;
  color: var(--ab-color-champagne-deep);
  font-weight: 700;
}

.back-action {
  min-height: var(--ab-touch-target);
  margin: 28rpx 30rpx 34rpx;
  border: 1rpx solid var(--ab-color-ink);
  border-radius: 10rpx;
  background: transparent;
  color: var(--ab-color-ink);
  font-size: 24rpx;
}

.back-action::after {
  border: 0;
}

.back-action--pressed {
  background: var(--ab-color-ink);
  color: var(--ab-color-paper-white);
}

@media (min-width: 760px) {
  .detail-page {
    max-width: 1080rpx;
    margin: 0 auto;
    padding-right: 48rpx;
    padding-left: 48rpx;
  }
}

@media (prefers-color-scheme: dark) {
  .detail-page {
    background: var(--ab-color-dark-canvas);
    color: var(--ab-color-dark-text);
  }

  .detail,
  .detail-loading {
    border-color: var(--ab-color-dark-border);
    background: var(--ab-color-dark-surface);
  }

  .detail__media,
  .detail__image-fallback {
    background: #2d2924;
  }

  .detail__summary,
  .detail__id,
  .detail-loading,
  .phase-boundary,
  .fact-row > text:first-child {
    color: var(--ab-color-dark-muted);
  }

  .fact-section,
  .fact-row {
    border-color: var(--ab-color-dark-border);
  }

  .fact-row > text:last-child,
  .back-action {
    color: var(--ab-color-dark-text);
  }

  .back-action {
    border-color: var(--ab-color-gold-soft);
  }

  .back-action--pressed {
    background: var(--ab-color-gold-soft);
    color: var(--ab-color-dark-canvas);
  }
}
