.detail-page{box-sizing:border-box;width:100%;min-height:100vh;margin:0 auto;padding:52rpx 32rpx 72rpx;background:#f4efe5}.detail-header{position:relative;display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin:0 2rpx 34rpx;padding-bottom:28rpx;border-bottom:1rpx solid #b9aa91;animation:detail-rise 480ms cubic-bezier(.2,.72,.24,1) both}.detail-header::after{position:absolute;right:0;bottom:-2rpx;width:78rpx;height:3rpx;background:#7b3038;content:""}.detail-header__eyebrow,.detail-header__title,.detail__city,.detail__title,.detail__summary,.detail__id,.fact-section__title,.organizer__name,.organizer__summary{display:block}.detail-header__eyebrow,.detail__city{color:#8a6538;font-size:19rpx;font-weight:700;letter-spacing:.17em}.detail-header__title{margin-top:7rpx;color:#173c32;font-family:Georgia,"Songti SC","STSong",SimSun,serif;font-size:58rpx;font-weight:500;line-height:1.18}.detail-loading{padding:88rpx 20rpx;border-top:1rpx solid #bcae98;border-bottom:1rpx solid #bcae98;color:#64716c;text-align:center}.detail{overflow:hidden;border:1rpx solid #bcae98;border-radius:2rpx;background:#fcfaf5;animation:detail-rise 520ms 70ms cubic-bezier(.2,.72,.24,1) both}.detail__media{position:relative;height:500rpx;overflow:hidden;background:#d4cab9}.detail__media::after{position:absolute;inset:14rpx;border:1rpx solid rgba(252,251,247,.5);content:"";pointer-events:none}.detail__image,.detail__image-fallback{width:100%;height:100%}.detail__image{animation:detail-photo-settle 950ms cubic-bezier(.2,.72,.24,1) both}.detail__image-fallback{display:flex;flex-direction:column;align-items:center;justify-content:center;border:0;background:#ebe3d5;color:#64716c;font-size:22rpx}.detail__image-fallback text:first-child{color:#8a6538;font-family:Georgia,serif;font-size:58rpx}.detail__badges{position:absolute;top:25rpx;left:25rpx;z-index:1;display:flex;flex-wrap:wrap;gap:8rpx}.detail__badges text{padding:8rpx 12rpx;border:1rpx solid rgba(252,251,247,.76);border-radius