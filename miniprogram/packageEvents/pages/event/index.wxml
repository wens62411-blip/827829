<view class="detail-page ab-safe-bottom"><view class="detail-header"><view><text class="detail-header__eyebrow">AB CLUB · EVENT DETAIL</text><text class="detail-header__title">活动详情</text></view><ab-evidence-label mode="{{runtimeMode}}" /></view><view wx:if="{{loading}}" class="detail-loading" aria-role="status">正在读取正式公开投影…</view><view wx:elif="{{hasDetail}}" class="detail"><view class="detail__media" aria-role="img" aria-label="{{detail.imageAlt}}"><image wx:if="{{detail.imageSrc && !imageFailed}}" class="detail__image" src="{{detail.imageSrc}}" mode="aspectFill" alt="{{detail.imageAlt}}" aria-label="{{detail.imageAlt}}" binderror="onImageError" /><view wx:else class="detail__image-fallback ab-image-fallback" aria-role="img" aria-label="{{detail.imageAlt}}加载失败"><text>AB</text><text>本地图片不可用</text></view><view class="detail__badges"><text>{{detail.evidenceLabel}}</text><text>{{detail.secondaryEvidenceLabel}}</text></view></view><view class="detail__intro"><text class="detail__city">{{detail.cityName}} / {{detail.cityNameEn}}</text><text class="detail__title">{{detail.title}}</text><text class="detail__summary">{{detail.summary}}</text><text class="detail__id">{{detail.displayId}}</text></view><view class="fact-section" aria-role="region" aria-label="活动状态与来源"><text class="fact-section__title">状态与来源</text><view class="fact-row"><text>运营 / 发布状态</text><text>{{detail.stateLabel}}</text></view><view class="fact-row"><text>活动来源</text><text>{{detail.sourceLabel}}</text></view></view><view class="fact-section" aria-role="region" aria-label="主理人"><text class="fact-section__title">主理人</text><view class="organizer"><text class="organizer__name">{{detail.organizerName}}</text><text class="organizer__summary">{{detail.organizerSummary}}</text><button wx:if="{{detail.organizerId}}" class="text-action" bindtap="openOrganizer">查看获批主理人公开资料</button></view></view><view class="fact-section" aria-role="region" aria-label="时间与地点"><text class="fact-section__title">时间与地点</text><view class="fact-row"><text>当地时间</text><text>{{detail.localTimeLabel}}</text></view><view class="fact-row"><text>IANA 时区</text><text class="fact-row__mono">{{detail.timezone}}</text></view><view class="timezone-note" aria-role="note">{{detail.timezoneDifferenceLabel}}</view><view class="fact-row"><text>地址范围</text><text>{{detail.addressRangeLabel}}</text></view></view><view class="fact-section" aria-role="region" aria-label="准入与报名"><text class="fact-section__title">准入与报名</text><view class="tag-list"><text wx:for="{{detail.admissionTags}}" wx:key="*this" class="admission-tag">{{item}}</text></view><view class="fact-row"><text>报名方式</text><text>{{detail.registrationMethodLabel}}</text></view><view class="fact-row"><text>容量</text><text>{{detail.capacityLabel}}</text></view><view class="fact-row"><text>最少成团人数</text><text>{{detail.minParticipantsLabel}}</text></view></view><view class="fact-section" aria-role="region" aria-label="图片权利与支付能力"><text class="fact-section__title">图片权利与支付门</text><view class="fact-row"><text>当前显示图</text><text>{{detail.mediaRightsLabel}}</text></view><view class="fact-row"><text>图片来源 / 许可</text><text>{{detail.mediaSourceLicenseLabel}}</text></view><view class="fact-row"><text>活动 cover</text><text>{{detail.referencedCoverLabel}}</text></view><view class="fact-row"><text>支付能力</text><text>{{detail.paymentCapabilityLabel}}</text></view></view><button wx:if="{{detail.canRegisterInterest}}" class="interest-action" bindtap="registerInterest">登记兴趣（INTEREST）</button><view wx:else class="blocked-action" aria-role="note">当前无可提交的兴趣登记入口，且不存在支付按钮。</view></view><ab-event-state wx:else kind="{{stateKind}}" title="{{stateTitle}}" description="{{stateDescription}}" detail="{{stateDetail}}" action-label="返回活动首页" bind:action="backToEvents" /></view>