<view class="detail-page ab-safe-bottom">
  <ab-brand-header
    eyebrow="PHASE 01 · CITY NOTE"
    title="活动方向详情"
    subtitle="轻量信息预览，不进入报名或交易流程。"
    compact="{{true}}"
  />

  <view wx:if="{{loading}}" class="detail-loading" aria-role="status">正在读取正式公开信息…</view>
  <view wx:elif="{{hasDetail}}" class="detail">
    <view class="detail__media" aria-role="img" aria-label="{{detail.imageAlt}}">
      <image
        wx:if="{{detail.imageSrc && !imageFailed}}"
        class="detail__image"
        src="{{detail.imageSrc}}"
        mode="aspectFill"
        alt="{{detail.imageAlt}}"
        aria-label="{{detail.imageAlt}}"
        binderror="onImageError"
      />
      <view wx:else class="detail__image-fallback ab-image-fallback" aria-role="img" aria-label="{{detail.imageAlt}}">
        <text>独立封面待补充</text>
        <text>不会使用城市照片冒充具体活动</text>
      </view>
      <text class="detail__badge">{{detail.evidenceLabel}}</text>
    </view>

    <view class="detail__intro">
      <view class="detail__taxonomy" aria-label="活动分类与所属模块">
        <text>{{detail.categoryLabel}}</text>
        <text>{{detail.sectionLabel}}</text>
      </view>
      <text class="detail__city">{{detail.cityName}} / {{detail.cityNameEn}}</text>
      <text class="detail__title">{{detail.title}}</text>
      <text class="detail__summary">{{detail.summary}}</text>
      <text class="detail__id">{{detail.displayIdLabel}}</text>
    </view>

    <view class="fact-section" aria-role="region" aria-label="活动方向信息">
      <text class="fact-section__title">信息说明</text>
      <view class="fact-row"><text>状态</text><text>{{detail.stateLabel}}</text></view>
      <view class="fact-row"><text>当地时间</text><text>{{detail.localTimeLabel}}</text></view>
      <view class="fact-row"><text>IANA 时区</text><text class="fact-row__mono">{{detail.timezone}}</text></view>
      <view class="fact-row"><text>内容来源</text><text>{{detail.sourceLabel}}</text></view>
      <view wx:if="{{detail.imageCredit}}" class="fact-row"><text>图片归属</text><text>{{detail.imageCredit}}</text></view>
    </view>

    <view class="phase-boundary" aria-role="note">
      <text class="phase-boundary__title">第一阶段边界</text>
      <text>{{detail.phaseBoundaryLabel}}</text>
    </view>

    <button class="back-action" bindtap="backToEvents" hover-class="back-action--pressed">返回活动预览</button>
  </view>

  <ab-event-state
    wx:else
    kind="{{stateKind}}"
    title="{{stateTitle}}"
    description="{{stateDescription}}"
    detail="{{stateDetail}}"
    action-label="返回活动预览"
    bind:action="backToEvents"
  />
</view>
