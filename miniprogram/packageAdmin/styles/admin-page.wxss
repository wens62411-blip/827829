.admin-page{box-sizing:border-box;min-height:100vh;padding:48rpx var(--ab-page-gutter) calc(48rpx + env(safe-area-inset-bottom))}.admin-header__topline,.admin-toolbar,.admin-section__topline{display:flex;align-items:center;justify-content:space-between;gap:var(--ab-space-3)}.admin-header__eyebrow,.admin-header__title,.admin-header__description,.admin-section__title,.admin-section__copy,.admin-gate__title,.admin-gate__copy,.admin-notice__title,.admin-notice__copy{display:block}.admin-header__eyebrow{color:var(--ab-color-gold);font-size:var(--ab-font-caption);font-weight:700;letter-spacing:.12em}.admin-header__title{margin-top:var(--ab-space-3);color:var(--ab-color-green);font-family:Georgia,Songti SC,SimSun,serif;font-size:var(--ab-font-title);font-weight:600;line-height:1.25}.admin-header__description{margin-top:var(--ab-space-3);color:var(--ab-color-muted)}.admin-page__notice{display:block;margin-top:var(--ab-space-3);padding:var(--ab-space-3);border-left:6rpx solid var(--ab-color-gold);background:var(--ab-color-paper);color:var(--ab-color-muted);font-size:var(--ab-font-caption)}.admin-gate,.admin-notice,.admin-section{box-sizing:border-box;margin-top:var(--ab-space-5);padding:var(--ab-space-4);border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-standard);background:var(--ab-color-paper)}.admin-gate{min-height:280rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.admin-gate__title,.admin-section__title,.admin-notice__title{color:var(--ab-color-green);font-weight:700}.admin-gate__copy,.admin-section__copy,.admin-notice__copy{margin-top:var(--ab-space-1);color:var(--ab-color-muted);font-size:var(--ab-font-caption)}.admin-gate__retry{margin-top:var(--ab-space-4);border:2rpx solid var(--ab-color-green);border-radius:var(--ab-radius-small);background:transparent;color:var(--ab-color-green);font-size:var(--ab-font-caption)}.admin-tabs{display:flex;gap:var(--ab-space-1);margin-top:var(--ab-space-5);padding:6rpx;border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-standard);background:var(--ab-color-paper)}.admin-tab{flex:1;min-width:0;margin:0;border:0;border-radius:var(--ab-radius-small);background:transparent;color:var(--ab-color-muted);font-size:var(--ab-font-caption)}.admin-tab:after,.admin-gate__retry:after{border:0}.admin-tab--active{background:var(--ab-color-green);color:var(--ab-color-paper);font-weight:700}.admin-layout{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--ab-space-5);margin-top:var(--ab-space-4)}.admin-list{display:flex;flex-direction:column;gap:var(--ab-space-3)}.admin-link-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--ab-space-3);margin-top:var(--ab-space-4)}.admin-link{box-sizing:border-box;min-height:148rpx;padding:var(--ab-space-4);border:2rpx solid var(--ab-color-green);border-radius:var(--ab-radius-standard);background:transparent;color:var(--ab-color-green);font-weight:700}.admin-link__copy{display:block;margin-top:var(--ab-space-1);color:var(--ab-color-muted);font-size:24rpx;font-weight:400}.admin-readonly-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--ab-space-3);margin-top:var(--ab-space-4)}.admin-readonly-button{box-sizing:border-box;width:100%;margin:0;padding:var(--ab-space-3);border:2rpx solid var(--ab-color-border);border-radius:var(--ab-radius-small);background:transparent;color:var(--ab-color-ink);text-align:left}.admin-readonly-button:after{border:0}@media(min-width:900px){.admin-layout{grid-template-columns:minmax(0,1fr) minmax(360rpx,.9fr);align-items:start}}@media(max-width:520px){.admin-link-grid,.admin-readonly-list{grid-template-columns:1fr}}@media(prefers-color-scheme:dark){.admin-page__notice{background:var(--ab-color-dark-surface);color:var(--ab-color-dark-muted)}.admin-header__title,.admin-gate__title,.admin-section__title,.admin-notice__title,.admin-gate__retry,.admin-link{color:var(--ab-color-dark-text)}.admin-header__description,.a