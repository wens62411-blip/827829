@import"../../styles/admin-page.wxss";.admin-list,.audit-notice{margin-top:var(--ab-space-4)}.audit-notice{display:block;padding:var(--ab-space-3);border-left:6rpx solid var(--ab-color-gold);background:var(--ab-color-paper);color:var(--ab-color-muted);font-size:var(--ab-font-caption)}.audit-more{border:2rpx solid var(--ab-color-green);border-radius:var(--ab-radius-small);background:transparent;color:var(--ab-color-green);font-size:var(--ab-font-caption)}@media(prefers-color-scheme:dark){.audit-notice{background:var(--ab-color-dark-surface);color:var(--ab-color-dark-muted)}.audit-more{border-color:var(--ab-color-gold-soft);color:var(--ab-color-dark-text)}}
