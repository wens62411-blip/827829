page {
  --ab-color-ivory: #f4efe6;
  --ab-color-gold-brown: #98723a;
  --ab-color-gold: #aa8448;
  --ab-color-gold-soft: #dec89c;
  --ab-color-paper-white: #fffdf8;
  --ab-color-paper: #fffdf8;
  --ab-color-ink: #211e1a;
  --ab-color-muted: #756f66;
  --ab-color-border: #d8cfc0;
  --ab-color-champagne-deep: #8a6a36;
  --ab-color-dark-canvas: #161412;
  --ab-color-dark-surface: #24211d;
  --ab-color-dark-text: #fffaf0;
  --ab-color-dark-muted: #bdb4a7;
  --ab-color-dark-border: #4b443b;
  --ab-font-display: Georgia, "Songti SC", "STSong", "Noto Serif CJK SC", SimSun, serif;
  --ab-font-text: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --ab-font-body: 32rpx;
  --ab-font-caption: 26rpx;
  --ab-font-title: 44rpx;
  --ab-touch-target: 88rpx;
  --ab-space-1: 8rpx;
  --ab-space-3: 24rpx;
  --ab-space-4: 32rpx;
  --ab-space-5: 40rpx;
  --ab-space-6: 48rpx;
  --ab-page-gutter: 32rpx;
  --ab-radius-small: 12rpx;
  --ab-radius-compact: 12rpx;
  --ab-radius-standard: 20rpx;
  --ab-motion-quick: 120ms;
  --ab-motion-standard: 180ms;
  box-sizing: border-box;
  min-height: 100%;
  background: var(--ab-color-ivory);
  color: var(--ab-color-ink);
  font-size: 32rpx;
  line-height: 1.55;
}

.ab-safe-page {
  min-height: 100vh;
  padding: var(--ab-page-gutter);
  padding-bottom: calc(var(--ab-page-gutter) + env(safe-area-inset-bottom));
  background: var(--ab-color-ivory);
}

.ab-touch-target {
  min-width: 88rpx;
  min-height: 88rpx;
}

.ab-image-fallback {
  background: var(--ab-color-paper-white);
  border: 2rpx solid var(--ab-color-border);
  color: var(--ab-color-muted);
}

.ab-weak-network-note {
  color: var(--ab-color-muted);
  font-size: 28rpx;
}

@media (prefers-reduced-motion: reduce) {
  .ab-motion {
    animation: none !important;
    transition: none !important;
  }
}
