<view class="card-page share-page">
  <view class="share-header">
    <view class="share-header__copy">
      <text class="card-kicker">YOUR DIGITAL CARD</text>
      <text class="card-title">名片海报</text>
      <text class="card-subtitle">将你的名片保存为图片。</text>
    </view>
    <image class="card-brand-crest share-header__crest" src="/assets/brand/ab-club-crest.png" mode="aspectFit" alt="AB Club 盾徽标志" />
  </view>

  <view wx:if="{{localIdentityReady}}" class="card-demo-ribbon">名片已保存在此设备</view>
  <view wx:elif="{{demoMode}}" class="card-demo-ribbon">演示名片 · 合成示例</view>

  <view wx:if="{{loadingCard}}" class="card-skeleton share-loading" aria-label="正在加载名片"></view>
  <view wx:elif="{{pageError}}" class="card-panel card-panel--error share-error">
    <text class="card-panel__title">名片暂时不可用</text>
    <text class="card-panel__text">{{pageError}}</text>
    <button class="card-button-secondary" style="margin-top: 24rpx" bindtap="loadCard">重新加载</button>
    <navigator wx:if="{{demoMode && !localIdentityReady}}" class="card-link-button" style="margin-top: 18rpx" url="/packageCard/pages/edit/index?register=1" hover-class="none">建立我的名片</navigator>
  </view>

  <ab-profile-card
    wx:elif="{{card}}"
    card="{{card}}"
    viewer-mode="STRANGER"
    city-label="{{cityLabel}}"
    fields="{{demoMode ? demoFields : []}}"
    public-labels="{{demoPublicLabels}}"
    allow-public-contacts="{{demoMode && !localIdentityReady}}"
    theme="{{cardTheme}}"
    show-default-actions="{{false}}"
  />

  <view wx:if="{{card}}" class="native-share-canvas-stage" aria-hidden="true">
    <canvas type="2d" id="nativeShareCardCanvas" class="native-share-canvas"></canvas>
  </view>

  <view wx:if="{{card}}" class="share-format-card">
    <text class="share-format-card__eyebrow">POSTER</text>
    <text class="share-format-card__title">保存名片海报</text>
    <view class="card-canvas-shell {{posterReady ? '' : 'card-hidden-canvas'}}">
      <canvas type="2d" id="cardPoster" class="card-poster-canvas"></canvas>
    </view>
    <view wx:if="{{posterMessage}}" class="share-inline-state {{albumDenied ? 'share-inline-state--error' : ''}}">{{posterMessage}}</view>
    <view class="card-stack">
      <button class="card-button-secondary" bindtap="generatePoster" loading="{{busyAction === 'POSTER'}}" disabled="{{busyAction !== ''}}">{{posterReady ? '重新生成海报' : '生成名片海报'}}</button>
      <button wx:if="{{posterReady}}" class="card-button" bindtap="savePosterToAlbum" loading="{{busyAction === 'SAVE'}}" disabled="{{busyAction !== ''}}">保存到相册</button>
      <button wx:if="{{albumDenied}}" class="card-button-secondary" bindtap="openAlbumSettings">打开相册权限设置</button>
    </view>
  </view>

  <view wx:if="{{!demoMode && card && hasRevocableShare}}" class="share-choice-card share-choice-card--quiet">
    <text class="share-choice-card__title">分享中的名片</text>
    <text class="share-choice-card__copy">停止后，对方将无法通过此链接继续查看。</text>
    <view wx:if="{{shareState === 'ERROR'}}" class="share-inline-state share-inline-state--error">{{shareDescription}}</view>
    <button class="card-button-secondary" bindtap="revokeShare" loading="{{busyAction === 'REVOKE'}}" disabled="{{busyAction !== ''}}">{{shareState === 'ERROR' ? '重试停止分享' : '停止分享'}}</button>
  </view>
  <view wx:if="{{!demoMode && shareState === 'REVOKED'}}" class="share-inline-state">已停止分享</view>
  <button wx:if="{{card}}" class="card-link-button share-return" bindtap="returnToOwnerCard">返回我的名片</button>
</view>
