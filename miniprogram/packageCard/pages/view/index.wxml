<view class="card-page visitor-page">
  <view class="visitor-header">
    <view class="visitor-header__copy">
      <text class="card-kicker">VIEW A DIGITAL CARD</text>
      <text class="card-title">一张名片，一次认识</text>
      <text class="card-subtitle">先看名片，再决定是否交换。没有强制连接，也不会自动添加好友。</text>
    </view>
    <image class="card-brand-crest visitor-header__crest" src="/assets/brand/ab-club-crest.png" mode="aspectFit" alt="AB Club 盾徽标志" />
  </view>

  <view wx:if="{{demoMode}}" class="card-demo-ribbon">SYNTHETIC · DEMO_ONLY · 非真实会员</view>

  <view wx:if="{{status === 'LOADING'}}" class="card-skeleton visitor-loading" aria-label="正在加载名片"></view>

  <view wx:elif="{{status === 'ERROR'}}" class="card-panel card-panel--error visitor-error">
    <text class="card-panel__title">这张名片暂时不可用</text>
    <text class="card-panel__text">{{message}}</text>
    <button wx:if="{{!invalidOwner}}" class="card-button-secondary" style="margin-top: 24rpx" bindtap="loadCard">重新加载</button>
  </view>

  <ab-profile-card
    wx:elif="{{card}}"
    class="visitor-card"
    card="{{card}}"
    viewer-mode="{{viewerMode}}"
    city-label="{{cityLabel}}"
    fields="{{demoMode ? demoFields : []}}"
    theme="{{cardTheme}}"
    max-visible-claims="3"
    show-default-actions="{{false}}"
  >
    <view wx:if="{{viewerMode === 'SELF'}}" slot="actions" class="card-inline-actions visitor-actions">
      <navigator class="card-link-button" url="/packageCard/pages/edit/index" hover-class="none">编辑名片</navigator>
      <navigator class="card-link-button card-link-button--strong" url="/packageCard/pages/share/index" hover-class="none">分享名片</navigator>
    </view>
    <view wx:else slot="actions" class="visitor-exchange">
      <button wx:if="{{demoMode}}" class="card-link-button card-link-button--strong" bindtap="handleDemoExchange">申请认识 · 交换名片</button>
      <navigator wx:else class="card-link-button card-link-button--strong" url="/packageSocial/pages/friend/index?ownerUserId={{viewedOwnerUserId}}" hover-class="none">{{viewerMode === 'FRIEND' ? '管理这段连接' : '申请认识 · 交换名片'}}</navigator>
      <text class="visitor-exchange__note">建立人脉需要对方确认；点击不会自动添加好友。</text>
    </view>
  </ab-profile-card>

  <text class="visitor-footnote">{{demoMode ? '示例只用于查看名片样式，不代表真实账户、好友关系或认证状态。' : '名片内容与可见范围会随双方关系变化重新刷新。'}}</text>
</view>
