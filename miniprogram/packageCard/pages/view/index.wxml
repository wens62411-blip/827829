<view class="card-page visitor-page">
  <view class="personal-share-canvas-stage" aria-hidden="true"><canvas type="2d" id="nativeCardShareCover" class="personal-share-canvas"></canvas></view>
  <view class="visitor-header">
    <view class="visitor-header__copy">
      <text class="card-kicker">VIEW A DIGITAL CARD</text>
      <text class="card-title">{{visitorTitle}}</text>
      <text class="card-subtitle">{{viewerMode === 'SELF' && !viewedOwnerUserId ? '整理个人资料，分享你的数字名片。' : '查看分享者选择公开的资料。'}}</text>
    </view>
    <image class="card-brand-crest visitor-header__crest" src="/assets/brand/ab-club-crest.png" mode="aspectFit" alt="AB Club 盾徽标志" />
  </view>

  <view wx:if="{{localIdentityReady}}" class="card-demo-ribbon">名片已保存在此设备</view>
  <view wx:elif="{{demoMode}}" class="card-demo-ribbon">演示名片 · 合成示例</view>

  <view wx:if="{{status === 'LOADING'}}" class="card-skeleton visitor-loading" aria-label="正在加载名片"></view>

  <view wx:elif="{{status === 'ERROR'}}" class="card-panel card-panel--error visitor-error">
    <text class="card-panel__title">这张名片暂时不可用</text>
    <text class="card-panel__text">{{message}}</text>
    <button wx:if="{{!invalidOwner}}" class="card-button-secondary" style="margin-top: 24rpx" bindtap="loadCard">重新加载</button>
  </view>

  <ab-profile-card
    wx:elif="{{card}}"
    class="visitor-card"
    card="{{card}}"
    viewer-mode="{{viewerMode}}"
    city-label="{{cityLabel}}"
    fields="{{demoMode ? demoFields : []}}"
    public-labels="{{demoPublicLabels}}"
    allow-public-contacts="{{demoMode}}"
    theme="{{cardTheme}}"
    max-visible-claims="3"
    show-default-actions="{{false}}"
  >
    <view wx:if="{{viewerMode === 'SELF'}}" slot="actions" class="card-inline-actions visitor-actions">
      <navigator class="card-link-button" url="/packageCard/pages/edit/index" hover-class="none">编辑名片</navigator>
      <button class="card-link-button card-link-button--strong" open-type="share" disabled="{{!ownerShareReady || ownerSharePreparing}}">{{ownerSharePreparing ? '正在准备…' : '分享名片'}}</button>
    </view>
    <view wx:else slot="actions" class="visitor-exchange">
      <button class="card-link-button card-link-button--strong" bindtap="openMyCardEntry">{{selfCardState === 'HAS_CARD' ? '查看我的数字名片' : '创建我的数字名片'}}</button>
    </view>
  </ab-profile-card>

  <view wx:if="{{viewerMode === 'SELF' && ownerShareMessage}}" class="visitor-footnote"><text>{{ownerShareMessage}}</text><button class="card-button-secondary" bindtap="prepareOwnerShare">重新准备分享</button></view>
  <navigator wx:if="{{viewerMode === 'SELF'}}" class="card-secondary-tool" url="/packageCard/pages/share/index" hover-class="none">名片海报 <text>›</text></navigator>
</view>
