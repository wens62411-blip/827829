<view class="card-page visitor-page">
  <view class="visitor-header">
    <view class="visitor-header__copy">
      <text class="card-kicker">VIEW A DIGITAL CARD</text>
      <text class="card-title">{{visitorTitle}}</text>
      <text class="card-subtitle">{{viewerMode === 'SELF' ? '查看、编辑或分享你的数字名片。' : '查看分享者选择公开的资料。'}}</text>
    </view>
    <image class="card-brand-crest visitor-header__crest" src="/assets/brand/ab-club-crest.png" mode="aspectFit" alt="AB Club 盾徽标志" />
  </view>

  <view wx:if="{{localIdentityReady}}" class="card-demo-ribbon">{{viewerMode === 'SELF' ? '当前设备资料' : '离线预览 · 用户自填资料'}}</view>
  <view wx:elif="{{demoMode}}" class="card-demo-ribbon">演示名片 · 合成示例 · 非真实会员</view>

  <view wx:if="{{status === 'LOADING'}}" class="card-skeleton visitor-loading" aria-label="正在加载名片"></view>

  <view wx:elif="{{status === 'ERROR'}}" class="card-panel card-panel--error visitor-error">
    <text class="card-panel__title">这张名片暂时不可用</text>
    <text class="card-panel__text">{{message}}</text>
    <button wx:if="{{!invalidOwner}}" class="card-button-secondary" style="margin-top: 24rpx" bindtap="loadCard">重新加载</button>
  </view>

  <ab-profile-card
    wx:elif="{{card}}"
    class="visitor-card"
    card="{{card}}"
    viewer-mode="{{viewerMode}}"
    city-label="{{cityLabel}}"
    fields="{{demoMode ? demoFields : []}}"
    public-labels="{{demoPublicLabels}}"
    allow-public-contacts="{{demoMode}}"
    theme="{{cardTheme}}"
    max-visible-claims="3"
    show-default-actions="{{false}}"
  >
    <view wx:if="{{viewerMode === 'SELF'}}" slot="actions" class="card-inline-actions visitor-actions">
      <navigator class="card-link-button" url="/packageCard/pages/edit/index" hover-class="none">编辑名片</navigator>
      <navigator class="card-link-button card-link-button--strong" url="/packageCard/pages/share/index" hover-class="none">分享名片</navigator>
    </view>
  </ab-profile-card>

  <text wx:if="{{card}}" class="visitor-footnote">{{demoMode ? '演示内容只用于查看名片样式，不代表真实账户或认证状态。' : '仅展示名片所有者当前允许查看的资料。'}}</text>

  <view wx:if="{{card && viewerMode !== 'SELF'}}" class="visitor-conversion">
    <text class="visitor-conversion__kicker">YOUR AB CLUB CARD</text>
    <text class="visitor-conversion__title">{{selfCardState === 'HAS_CARD' ? '继续管理你的数字名片' : (selfCardState === 'NO_CARD' ? '创建一张属于你的数字名片' : '进入你的数字名片空间')}}</text>
    <text class="visitor-conversion__copy">{{selfCardState === 'HAS_CARD' ? '返回后仍会保留当前分享者的名片。' : (selfCardState === 'NO_CARD' ? '自主填写内容与公开范围，完成后即可分享。' : '进入后可查看现有名片，或开始创建自己的名片。')}}</text>
    <button class="visitor-conversion__button" bindtap="openMyCardEntry">{{selfCardState === 'HAS_CARD' ? '查看我的名片' : (selfCardState === 'NO_CARD' ? '创建我的数字名片' : '进入我的名片')}}</button>
  </view>
</view>
