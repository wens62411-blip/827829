.requests { box-sizing: border-box; min-height: 100vh; padding: 48rpx var(--ab-page-gutter); }
.requests__eyebrow { display: block; color: var(--ab-color-gold); font-size: 22rpx; font-weight: 700; letter-spacing: 0.1em; }
.requests__title { display: block; margin-top: 22rpx; color: var(--ab-color-green); font-family: Georgia, "Songti SC", serif; font-size: 46rpx; font-weight: 600; }
.requests__lead { display: block; margin-top: 16rpx; color: var(--ab-color-muted); font-size: 26rpx; }
.requests__notice { margin-top: 32rpx; padding: 24rpx; border-left: 6rpx solid var(--ab-color-gold); background: var(--ab-color-paper); font-size: 26rpx; }
.requests__retry { min-height: 72rpx; margin: 16rpx 0 0; padding: 0; background: transparent; color: var(--ab-color-green); font-size: 26rpx; text-align: left; }
.requests__retry::after { border: 0; }
.requests__list { display: flex; flex-direction: column; gap: 24rpx; margin-top: 36rpx; }
.requests__empty { margin-top: 36rpx; padding: 56rpx 28rpx; border: 2rpx dashed var(--ab-color-border); border-radius: var(--ab-radius-standard); text-align: center; }
.requests__empty-title,
.requests__empty-note { display: block; }
.requests__empty-title { font-size: 30rpx; font-weight: 700; }
.requests__empty-note { margin-top: 10rpx; color: var(--ab-color-muted); font-size: 24rpx; }
.requests__loading-more { padding: 30rpx; color: var(--ab-color-muted); font-size: 24rpx; text-align: center; }
@media (prefers-color-scheme: dark) {
  .requests__title { color: var(--ab-color-dark-text); }
  .requests__lead, .requests__empty-note, .requests__loading-more { color: var(--ab-color-dark-muted); }
  .requests__notice { background: var(--ab-color-dark-surface); }
  .requests__retry { color: var(--ab-color-gold-soft); }
  .requests__empty { border-color: var(--ab-color-dark-border); }
}
