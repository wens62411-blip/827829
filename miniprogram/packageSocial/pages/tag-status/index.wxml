<view class="status ab-safe-bottom">
  <text class="status__title">我的审核状态</text>

  <view wx:if="{{errorMessage}}" class="status__notice" aria-role="alert">
    <text>{{errorMessage}}</text>
    <button class="status__text-button" disabled="{{loading}}" bindtap="loadMine">重新加载</button>
  </view>
  <view wx:elif="{{loading && !loaded}}" class="status__notice" aria-role="status">正在读取本人申请…</view>

  <view wx:if="{{requests.length}}" class="status__layout">
    <scroll-view class="status__tabs" scroll-x enhanced show-scrollbar="false" aria-label="本人标签申请列表">
      <button
        wx:for="{{requests}}"
        wx:key="verificationRequestId"
        class="status__tab {{selected.verificationRequestId === item.verificationRequestId ? 'status__tab--active' : ''}}"
        data-request-id="{{item.verificationRequestId}}"
        bindtap="onSelectRequest"
      >
        <text class="status__tab-name">{{item.labelName}}</text>
        <text class="status__tab-state">{{item.statusLabel}}</text>
      </button>
    </scroll-view>

    <view wx:if="{{selected}}" class="status__detail">
      <view class="status__detail-head">
        <view>
          <text class="status__detail-label">{{selected.labelName}}</text>
        </view>
        <text class="status__badge status__badge--{{selected.status}}">{{selected.statusLabel}}</text>
      </view>

      <ab-review-timeline
        status="{{selected.status}}"
        created-at-label="{{selected.createdAtLabel}}"
        reviewer-note="{{selected.reviewerNote}}"
        evidence-count="{{selected.evidenceCount}}"
      />

      <view wx:if="{{selected.status === 'APPROVED'}}" class="status__policy" aria-role="note">
        审核通过后不会自动公开展示。
      </view>

      <navigator
        wx:if="{{selected.canResubmit}}"
        class="status__button status__button--primary"
        url="/packageSocial/pages/tag-apply/index?verificationRequestId={{selected.verificationRequestId}}"
        hover-class="none"
      >按要求补充并重新提交</navigator>
      <button
        wx:if="{{selected.canWithdraw}}"
        class="status__button status__button--danger"
        loading="{{busyAction === 'withdraw'}}"
        disabled="{{busyAction}}"
        bindtap="onWithdraw"
      >撤回并删除申请</button>
    </view>
  </view>

  <view wx:elif="{{loaded}}" class="status__empty">
    <text class="status__empty-title">还没有标签申请</text>
    <navigator class="status__button status__button--primary" url="/packageSocial/pages/tag-apply/index" hover-class="none">发起标签申请</navigator>
  </view>

</view>
