<view class="friend ab-safe-bottom">
  <text class="friend__eyebrow">AB CLUB PLATFORM RELATIONSHIP</text>
  <text class="friend__title">平台关系</text>
  <text class="friend__lead">“申请认识”只建立 AB Club 平台关系，不会添加微信好友，也不提供聊天能力。</text>

  <view wx:if="{{errorMessage}}" class="friend__notice" aria-role="alert">
    <text>{{errorMessage}}</text>
    <button wx:if="{{targetUserId}}" class="friend__text-button" disabled="{{loading}}" bindtap="loadRelationship">重新加载</button>
  </view>
  <view wx:elif="{{loading && !card}}" class="friend__notice" aria-role="status">正在读取可见名片与关系投影…</view>

  <view wx:if="{{card}}" class="friend__card">
    <view class="friend__profile">
      <image wx:if="{{card.avatarUrl}}" class="friend__avatar" src="{{card.avatarUrl}}" mode="aspectFill" aria-label="{{card.displayName}}的头像" />
      <view wx:else class="friend__avatar friend__avatar--fallback">AB</view>
      <view class="friend__identity">
        <text class="friend__name">{{card.displayName}}</text>
        <text wx:if="{{card.headline}}" class="friend__headline">{{card.headline}}</text>
      </view>
      <text class="friend__status">{{actions.statusLabel}}</text>
    </view>
    <text wx:if="{{card.biography}}" class="friend__bio">{{card.biography}}</text>
    <view wx:if="{{claims.length}}" class="friend__claims" aria-label="有效公开认证标签">
      <ab-verified-tag
        wx:for="{{claims}}"
        wx:key="claimId"
        label="{{item.label}}"
        review-status="{{item.reviewStatus}}"
        verification-state="{{item.verificationState}}"
      />
    </view>
    <view class="friend__permission" aria-role="note">
      <text class="friend__permission-label">FRIENDS_ONLY 权限</text>
      <text>{{relationship.mayViewFriendsOnlyFields ? '已开启' : '未开启'}}</text>
    </view>
  </view>

  <view wx:if="{{card && actions.canRequest}}" class="friend__request-box">
    <text class="friend__section-title">申请认识</text>
    <textarea
      class="friend__textarea"
      value="{{requestMessage}}"
      maxlength="120"
      placeholder="可选：写一句简短附言（最多 120 字）"
      bindinput="onMessageInput"
      disabled="{{busyAction}}"
      aria-label="申请认识附言"
    />
    <button class="friend__button friend__button--primary" loading="{{busyAction === 'request'}}" disabled="{{busyAction}}" bindtap="onRequest">申请认识</button>
  </view>

  <view wx:if="{{card}}" class="friend__actions" aria-role="group" aria-label="平台关系操作">
    <button wx:if="{{actions.canCancel}}" class="friend__button friend__button--quiet" disabled="{{busyAction}}" bindtap="onCancel">撤回申请</button>
    <button wx:if="{{actions.canRemove}}" class="friend__button friend__button--danger" disabled="{{busyAction}}" bindtap="onRemove">解除关系</button>
    <button wx:if="{{actions.canBlock}}" class="friend__button friend__button--quiet" disabled="{{busyAction}}" bindtap="onBlock">拉黑</button>
    <button wx:if="{{actions.canUnblock}}" class="friend__button friend__button--quiet" disabled="{{busyAction}}" bindtap="onUnblock">解除拉黑</button>
    <button wx:if="{{actions.canReport}}" class="friend__button friend__button--text" disabled="{{busyAction}}" bindtap="onReport">举报</button>
  </view>

  <view wx:if="{{card}}" class="friend__safety" aria-role="note">
    删除关系或拉黑后，本页会先行隐藏可能来自 FRIENDS_ONLY 的资料；服务端同时按冻结协议写入关系投影失效事件。
  </view>
</view>
